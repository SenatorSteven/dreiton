#ifndef BASE_SERVER_EXTENSION_HELPERS_HOLD
#define BASE_SERVER_EXTENSION_HELPERS_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

/*! put these in a source file */

bool requestBaseGetMagicNumber(ServerConnectionSystem *const serverConnectionSystem, const uint32 extension, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, GET_MAGIC_NUMBER_BASE_REQUEST_TYPE, extension, NULL, GET_MAGIC_NUMBER_BASE_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestBaseSetMagicNumber(ServerConnectionSystem *const serverConnectionSystem, const uint32 extension, const uint32 magicNumber, uint32 *const tokenReturn){
	SetMagicNumberBaseRequest setMagicNumberBaseRequest;
	setMagicNumberBaseRequest.magicNumberSize = sizeof(uint32);
	setMagicNumberBaseRequest.magicNumberStart = (void *)&magicNumber;
	ret sendServerRequest(serverConnectionSystem, SET_MAGIC_NUMBER_BASE_REQUEST_TYPE, extension, &setMagicNumberBaseRequest, SET_MAGIC_NUMBER_BASE_REQUEST_ITEM_AMOUNT, tokenReturn);
}
inline bool waitForBaseGetMagicNumberReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, GetMagicNumberBaseReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForBaseSetMagicNumberReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, SetMagicNumberBaseReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


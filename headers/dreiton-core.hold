#define INITDREITONCORE() /*-----------------------------------*/ bool  initDreitonCore(DreitonCore *const dreitonCore)
#define SETDREITONCORECLIENTBLOCKSIZE() /*---------------------*/ bool  setDreitonCoreClientBlockSize(DreitonCore *const dreitonCore, const uint clientBlockSize)
#define SETDREITONCOREEXTENSIONBLOCKSIZE() /*------------------*/ bool  setDreitonCoreExtensionBlockSize(DreitonCore *const dreitonCore, const uint extensionBlockSize)
#define SETDREITONCOREEXTENSIONEVENTBLOCKSIZE() /*-------------*/ bool  setDreitonCoreExtensionEventBlockSize(DreitonCore *const dreitonCore, const uint extensionEventBlockSize)
#define LOADDREITONCORETRANSPORT() /*--------------------------*/ bool  loadDreitonCoreTransport(DreitonCore *const dreitonCore, const char *const path)
#define LOADDREITONCORECODEC() /*------------------------------*/ bool  loadDreitonCoreCodec(DreitonCore *const dreitonCore, const char *const path)
#define SETDREITONCORETRANSPORTCLIENTBLOCKSIZE() /*------------*/ bool  setDreitonCoreTransportClientBlockSize(DreitonCore *const dreitonCore, const uint32 clientBlockSize)
#define SETDREITONCORETRANSPORTCONCURRENTCONNECTIONAMOUNT() /*-*/ bool  setDreitonCoreTransportConcurrentConnectionAmount(DreitonCore *const dreitonCore, const uint32 concurrentConnectionAmount)
#define SETDREITONCORETRANSPORTREQUESTSLOTSIZE() /*------------*/ bool  setDreitonCoreTransportRequestSlotSize(DreitonCore *const dreitonCore, const uint32 requestSlotSize)
#define SETDREITONCORETRANSPORTREPLYSLOTSIZE() /*--------------*/ bool  setDreitonCoreTransportReplySlotSize(DreitonCore *const dreitonCore, const uint32 replySlotSize)
#define SETDREITONCORETRANSPORTEVENTSLOTSIZE() /*--------------*/ bool  setDreitonCoreTransportEventSlotSize(DreitonCore *const dreitonCore, const uint32 eventSlotSize)
#define SETDREITONCORETRANSPORTREQUESTSIZE() /*----------------*/ bool  setDreitonCoreTransportRequestSize(DreitonCore *const dreitonCore, const uint32 requestSize)
#define SETDREITONCORETRANSPORTREPLYSIZE() /*------------------*/ bool  setDreitonCoreTransportReplySize(DreitonCore *const dreitonCore, const uint32 replySize)
#define SETDREITONCORETRANSPORTEVENTSIZE() /*------------------*/ bool  setDreitonCoreTransportEventSize(DreitonCore *const dreitonCore, const uint32 eventSize)
#define CREATEDREITONCORETRANSPORTREQUESTRECEIVER() /*---------*/ bool  createDreitonCoreTransportRequestReceiver(DreitonCore *const dreitonCore)
#define CREATEDREITONCORETRANSPORTEVENTRECEIVER() /*-----------*/ bool  createDreitonCoreTransportEventReceiver(DreitonCore *const dreitonCore)
#define CREATEDREITONCORETRANSPORTREGISTRATIONRECEIVER() /*----*/ bool  createDreitonCoreTransportRegistrationReceiver(DreitonCore *const dreitonCore, const void *const argument)
#define WAITFORDREITONCORETRANSPORTREQUEST() /*----------------*/ bool  waitForDreitonCoreTransportRequest(DreitonCore *const dreitonCore, DreitonServerTransportRequest *const transportRequestReturn)
#define WAITFORDREITONCORETRANSPORTEVENT() /*------------------*/ bool  waitForDreitonCoreTransportEvent(DreitonCore *const dreitonCore, uint32 *const extensionReturn, uint32 *const eventTypeReturn)
#define WAITFORDREITONCORETRANSPORTREGISTRATION() /*-----------*/ bool  waitForDreitonCoreTransportRegistration(DreitonCore *const dreitonCore, const uint32 dataReturnSize, void *const dataReturn)
#define HANDSHAKEDREITONCORETRANSPORTREGISTRATION() /*---------*/ bool  handshakeDreitonCoreTransportRegistration(DreitonCore *const dreitonCore, const bool successfulHandshake, const uint32 dataSize, const void *const data)
#define CONSUMEDREITONCORETRANSPORTREGISTRATION() /*-----------*/ bool  consumeDreitonCoreTransportRegistration(DreitonCore *const dreitonCore)
#define INSERTDREITONCORECLIENT() /*---------------------------*/ bool  insertDreitonCoreClient(DreitonCore *const dreitonCore, const uint32 transportId, const uint32 dataSize, const void *const dataStart)
#define DECODEDREITONCOREREQUEST() /*--------------------------*/ bool  decodeDreitonCoreRequest(DreitonCore *const dreitonCore, DreitonCoreClient *const client, DreitonRequest *const requestReturn)
#define GETDREITONCOREREQUESTPAYLOADITEMAMOUNT() /*------------*/ bool  getDreitonCoreRequestPayloadItemAmount(DreitonCore *const dreitonCore, const void *const frame, uint32 *const payloadItemAmountReturn)
#define GETDREITONCOREMESSAGEDECODEDITEM() /*------------------*/ bool  getDreitonCoreMessageDecodedItem(DreitonCore *const dreitonCore, const void *const frame, const uint32 which, uint32 *const itemSize, void **const itemStart)
#define CONSUMEDREITONCOREREQUEST() /*-------------------------*/ bool  consumeDreitonCoreRequest(DreitonCore *const dreitonCore, DreitonCoreClient *const client)
#define SENDDREITONCOREREPLY() /*------------------------------*/ bool  sendDreitonCoreReply(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint16 type, const uint16 extension, const uint32 token, const uint8 status, const uint32 payloadItemAmount, const uint32 *const payloadItemSizeStart, const void *const *const payloadItemDataStart)
#define SENDDREITONCOREERRORREPLY() /*-------------------------*/ bool  sendDreitonCoreErrorReply(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint16 type, const uint16 extension, const uint32 token, const uint8 status, const uint8 parameterOffset, const uint16 operation, const uint32 value)
#define SENDDREITONCOREERROREVENT() /*-------------------------*/ bool  sendDreitonCoreErrorEvent(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint16 type, const uint16 extension, const uint32 token, const uint8 status, const uint8 parameterOffset, const uint16 operation, const uint32 value)
#define SENDDREITONCOREEVENT() /*------------------------------*/ bool  sendDreitonCoreEvent(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint16 type, const uint16 extension, const uint32 token, const uint8 status, const uint32 payloadItemAmount, const uint32 *const payloadItemSizeStart, const void *const *const payloadItemDataStart)
#define LOADDREITONCOREEXTENSION() /*--------------------------*/ bool  loadDreitonCoreExtension(DreitonCore *const dreitonCore, const char *const path, uint32 *const extensionIdReturn)
#define ROUNDUPTOMULTIPLE() /*---------------------------------*/ bool  roundUpToMultiple(const uint64 number, const uint64 multiple)



#define SUBSCRIBETODREITONCOREEVENT() /*-----------------------*/ bool  subscribeToDreitonCoreEvent(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint32 extensionId, uint32 eventMask)
#define EMITDREITONCOREEVENT() /*------------------------------*/ bool  emitDreitonCoreEvent(DreitonCore *const dreitonCore, const uint16 type, const uint16 extensionId, const uint32 token, const uint8 status, const uint32 payloadItemAmount, const uint32 *const payloadItemSizeStart, const void *const *const payloadItemDataStart)
#define UNSUBSCRIBEFROMDREITONCOREEVENT() /*-------------------*/ bool  unsubscribeFromDreitonCoreEvent(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint32 extensionId, uint32 eventMask)



#define UNLOADDREITONCOREEXTENSION() /*------------------------*/ bool  unloadDreitonCoreExtension(DreitonCore *const dreitonCore, const uint32 extensionId, const bool force)



#define REMOVEDREITONCORECLIENT() /*---------------------------*/ bool  removeDreitonCoreClient(DreitonCore *const dreitonCore, const uint32 clientId)
#define WAKEUPDREITONCORETRANSPORTREGISTRATION() /*------------*/ bool  wakeUpDreitonCoreTransportRegistration(DreitonCore *const dreitonCore)
#define WAKEUPDREITONCORETRANSPORTREQUEST() /*-----------------*/ bool  wakeUpDreitonCoreTransportRequest(DreitonCore *const dreitonCore)
#define WAKEUPDREITONCORETRANSPORTEVENT() /*-------------------*/ bool  wakeUpDreitonCoreTransportEvent(DreitonCore *const dreitonCore)
#define DESTROYDREITONCORETRANSPORTREGISTRATIONRECEIVER() /*---*/ bool  destroyDreitonCoreTransportRegistrationReceiver(DreitonCore *const dreitonCore)
#define DESTROYDREITONCORETRANSPORTREQUESTRECEIVER() /*--------*/ bool  destroyDreitonCoreTransportRequestReceiver(DreitonCore *const dreitonCore)
#define DESTROYDREITONCORETRANSPORTEVENTRECEIVER() /*----------*/ bool  destroyDreitonCoreTransportEventReceiver(DreitonCore *const dreitonCore)
#define UNLOADDREITONCORECODEC() /*----------------------------*/ bool  unloadDreitonCoreCodec(DreitonCore *const dreitonCore)
#define UNLOADDREITONCORETRANSPORT() /*------------------------*/ bool  unloadDreitonCoreTransport(DreitonCore *const dreitonCore)
#define FINDDREITONCORECLIENTID() /*---------------------------*/ bool  findDreitonCoreClientId(DreitonCore *const dreitonCore, const uint32 clientId, DreitonCoreClient **const clientReturn)
#define ISVALIDDREITONCORECLIENT() /*--------------------------*/ bool  isValidDreitonCoreClient(DreitonCore *const dreitonCore, DreitonCoreClient *const client)
#define ISVALIDDREITONCOREEXTENSION() /*-----------------------*/ bool  isValidDreitonCoreExtension(DreitonCore *const dreitonCore, const uint32 extensionId)
#define FINIDREITONCORE() /*-----------------------------------*/ bool  finiDreitonCore(DreitonCore *const dreitonCore)



def struct{
	uint64 /*-----------------------------*/ uuid0;
	uint64 /*-----------------------------*/ uuid1;
} DreitonCoreUuid;

def struct{
	uint16 /*-----------------------------*/ eventType;
	uint16 /*-----------------------------*/ eventExtensionId;
	uint32 /*-----------------------------*/ eventSubscriptionOffset;
} DreitonCoreClientSubscription;

def struct{
	uint32 /*-----------------------------*/ clientId;
	uint32 /*-----------------------------*/ transportId;
	DreitonCoreUuid /*--------------------*/ clientUuid;
	DreitonCoreClientSubscription * /*----*/ subscriptionStart;
	uint32 * /*---------------------------*/ eventOffsetStart;
	uint32 /*-----------------------------*/ subscriptionSize;
	uint32 /*-----------------------------*/ subscriptionAllocated;
	uint32 /*-----------------------------*/ eventOffsetSize;
	uint8 /*------------------------------*/ pad0[4];
} DreitonCoreClient;

def struct{
	void * /*-----------------------------*/ extensionDescriptorHandle;
	DreitonExtensionDescriptor * /*-------*/ extensionDescriptor;
	void * /*-----------------------------*/ extensionHandle;
	uint32 /*-----------------------------*/ extensionReferenceAmount;
	uint32 /*-----------------------------*/ extensionBaseEvent;
	uint32 /*-----------------------------*/ extensionEventAmount;
	uint8 /*------------------------------*/ pad0[4];
} DreitonCoreExtension;

def struct{
	uint32 /*-----------------------------*/ clientOffset;
	uint32 /*-----------------------------*/ clientSubscriptionOffset;
} DreitonCoreEventSubscription;

def struct{
	DreitonCoreEventSubscription * /*-----*/ subscriptionStart;
	uint32 /*-----------------------------*/ subscriptionSize;
	uint32 /*-----------------------------*/ subscriptionAllocated;
} DreitonCoreEvent;

def struct{
	void * /*-----------------------------*/ transportDescriptorHandle;
	DreitonServerTransportDescriptor * /*-*/ transportDescriptor;
	void * /*-----------------------------*/ transportHandle;
	void * /*-----------------------------*/ codecDescriptorHandle;
	DreitonCodecDescriptor * /*-----------*/ codecDescriptor;
	DreitonCoreClient * /*----------------*/ clientStart;
	DreitonCoreExtension * /*-------------*/ extensionStart;
	DreitonCoreEvent * /*-----------------*/ eventStart;
	uint32 /*-----------------------------*/ clientSize;
	uint32 /*-----------------------------*/ clientAllocated;
	uint32 /*-----------------------------*/ clientBlockSize;
	uint32 /*-----------------------------*/ extensionSize;
	uint32 /*-----------------------------*/ extensionAllocated;
	uint32 /*-----------------------------*/ extensionBlockSize;
	uint32 /*-----------------------------*/ extensionEventBlockSize;
	uint32 /*-----------------------------*/ eventSize;
	uint32 /*-----------------------------*/ eventAllocated;
	uint32 /*-----------------------------*/ baseEvent;
	bool /*-------------------------------*/ requestReceiverCreated;
	bool /*-------------------------------*/ eventReceiverCreated;
	bool /*-------------------------------*/ registrationReceiverCreated;
	uint8 /*------------------------------*/ pad0[5];
} DreitonCore;

INITDREITONCORE();
SETDREITONCORECLIENTBLOCKSIZE();
SETDREITONCOREEXTENSIONBLOCKSIZE();
SETDREITONCOREEXTENSIONEVENTBLOCKSIZE();
LOADDREITONCORETRANSPORT();
LOADDREITONCORECODEC();
SETDREITONCORETRANSPORTCLIENTBLOCKSIZE();
SETDREITONCORETRANSPORTCONCURRENTCONNECTIONAMOUNT();
SETDREITONCORETRANSPORTREQUESTSLOTSIZE();
SETDREITONCORETRANSPORTREPLYSLOTSIZE();
SETDREITONCORETRANSPORTEVENTSLOTSIZE();
SETDREITONCORETRANSPORTREQUESTSIZE();
SETDREITONCORETRANSPORTREPLYSIZE();
SETDREITONCORETRANSPORTEVENTSIZE();
CREATEDREITONCORETRANSPORTREQUESTRECEIVER();
CREATEDREITONCORETRANSPORTEVENTRECEIVER();
CREATEDREITONCORETRANSPORTREGISTRATIONRECEIVER();
WAITFORDREITONCORETRANSPORTREQUEST();
WAITFORDREITONCORETRANSPORTEVENT();
WAITFORDREITONCORETRANSPORTREGISTRATION();
HANDSHAKEDREITONCORETRANSPORTREGISTRATION();
CONSUMEDREITONCORETRANSPORTREGISTRATION();
INSERTDREITONCORECLIENT();
DECODEDREITONCOREREQUEST();
GETDREITONCOREREQUESTPAYLOADITEMAMOUNT();
GETDREITONCOREMESSAGEDECODEDITEM();
CONSUMEDREITONCOREREQUEST();
SENDDREITONCOREREPLY();
SENDDREITONCOREERRORREPLY();
SENDDREITONCOREERROREVENT();
SENDDREITONCOREEVENT();
LOADDREITONCOREEXTENSION();
ROUNDUPTOMULTIPLE();
SUBSCRIBETODREITONCOREEVENT();
EMITDREITONCOREEVENT();
UNSUBSCRIBEFROMDREITONCOREEVENT();
UNLOADDREITONCOREEXTENSION();
REMOVEDREITONCORECLIENT();
WAKEUPDREITONCORETRANSPORTREGISTRATION();
WAKEUPDREITONCORETRANSPORTREQUEST();
WAKEUPDREITONCORETRANSPORTEVENT();
DESTROYDREITONCORETRANSPORTREGISTRATIONRECEIVER();
DESTROYDREITONCORETRANSPORTREQUESTRECEIVER();
DESTROYDREITONCORETRANSPORTEVENTRECEIVER();
UNLOADDREITONCORECODEC();
UNLOADDREITONCORETRANSPORT();
FINDDREITONCORECLIENTID();
ISVALIDDREITONCORECLIENT();
ISVALIDDREITONCOREEXTENSION();
FINIDREITONCORE();

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


#define ServerExtensionDescriptorSystem /*-------*/ ServerExtensionDescriptorSystem

#define INITSERVEREXTENSIONDESCRIPTORSYSTEM() /*-*/ bool  initServerExtensionDescriptorSystem(void)
#define PARSEEXTENSIONREQUEST() /*---------------*/ bool  parseExtensionRequest(GenericRequest *const request)
#define PARSEEXTENSIONREPLY() /*-----------------*/ bool  parseExtensionReply(GenericReply *const reply)
#define FINISERVEREXTENSIONDESCRIPTORSYSTEM() /*-*/ bool  finiServerExtensionDescriptorSystem(void)

INITSERVEREXTENSIONDESCRIPTORSYSTEM();

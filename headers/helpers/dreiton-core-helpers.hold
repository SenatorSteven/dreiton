#ifndef DREITON_CORE_HELPERS_HOLD
#define DREITON_CORE_HELPERS_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

#define SENDDREITONCORENOOPERATIONREPLY() /*-----------------*/ bool  sendDreitonCoreNoOperationReply(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint32 token, const uint8 status)
#define SENDDREITONCORESYNCREPLY() /*------------------------*/ bool  sendDreitonCoreSyncReply(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint32 token, const uint8 status)
#define SENDDREITONCOREENABLEEXTENSIONREPLY() /*-------------*/ bool  sendDreitonCoreEnableExtensionReply(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint32 token, const uint8 status, const uint32 extensionId)
#define SENDDREITONCOREAPPLYFOREVENTREPLY() /*---------------*/ bool  sendDreitonCoreApplyForEventReply(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint32 token, const uint8 status)
#define SENDDREITONCOREWITHDRAWFROMEVENTREPLY() /*-----------*/ bool  sendDreitonCoreWithdrawFromEventReply(DreitonCore *const dreitonCore, DreitonCoreClient *const client, const uint32 token, const uint8 status)
#define GETDREITONCOREENABLEEXTENSIONREQUESTPATH() /*--------*/ bool  getDreitonCoreEnableExtensionRequestPath(DreitonCore *const dreitonCore, EnableExtensionDreitonRequest *const request, uint32 *const pathSizeReturn, void **const pathStartReturn)
#define GETDREITONCOREAPPLYFOREVENTREQUESTEXTENSION() /*-----*/ bool  getDreitonCoreApplyForEventRequestExtension(DreitonCore *const dreitonCore, ApplyForEventDreitonRequest *const request, uint32 *const extensionReturn)
#define GETDREITONCOREAPPLYFOREVENTREQUESTEVENTMASK() /*-----*/ bool  getDreitonCoreApplyForEventRequestEventMask(DreitonCore *const dreitonCore, ApplyForEventDreitonRequest *const request, uint32 *const eventMaskReturn)
#define GETDREITONCOREWITHDRAWFROMEVENTREQUESTEXTENSION() /*-*/ bool  getDreitonCoreWithdrawFromEventRequestExtension(DreitonCore *const dreitonCore, WithdrawFromEventDreitonRequest *const request, uint32 *const extensionReturn)
#define GETDREITONCOREWITHDRAWFROMEVENTREQUESTEVENTMASK() /*-*/ bool  getDreitonCoreWithdrawFromEventRequestEventMask(DreitonCore *const dreitonCore, WithdrawFromEventDreitonRequest *const request, uint32 *const eventMaskReturn)

def DreitonRequest /*-*/ NoOperationDreitonRequest;
def DreitonRequest /*-*/ SyncDreitonRequest;
def DreitonRequest /*-*/ EnableExtensionDreitonRequest;
def DreitonRequest /*-*/ ApplyForEventDreitonRequest;
def DreitonRequest /*-*/ WithdrawFromEventDreitonRequest;

SENDDREITONCORENOOPERATIONREPLY();
SENDDREITONCORESYNCREPLY();
SENDDREITONCOREENABLEEXTENSIONREPLY();
SENDDREITONCOREAPPLYFOREVENTREPLY();
SENDDREITONCOREWITHDRAWFROMEVENTREPLY();
GETDREITONCOREENABLEEXTENSIONREQUESTPATH();
GETDREITONCOREAPPLYFOREVENTREQUESTEXTENSION();
GETDREITONCOREAPPLYFOREVENTREQUESTEVENTMASK();
GETDREITONCOREWITHDRAWFROMEVENTREQUESTEXTENSION();
GETDREITONCOREWITHDRAWFROMEVENTREQUESTEVENTMASK();

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


#ifndef DREITON_TRANSPORT_HOLD
#define DREITON_TRANSPORT_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

def struct{
	uint32 /*-*/ requestSlotStartOffset;
	uint32 /*-*/ requestSlotSize;
	uint32 /*-*/ requestStartOffset;
	uint32 /*-*/ requestSize;
	uint32 /*-*/ requestCurrentWriter;
	uint32 /*-*/ requestCurrentReader;
	uint32 /*-*/ replySlotStartOffset;
	uint32 /*-*/ replySlotSize;
	uint32 /*-*/ replyStartOffset;
	uint32 /*-*/ replySize;
	uint32 /*-*/ replyCurrentWriter;
	uint32 /*-*/ replyCurrentReader;
	uint32 /*-*/ eventSlotStartOffset;
	uint32 /*-*/ eventSlotSize;
	uint32 /*-*/ eventStartOffset;
	uint32 /*-*/ eventSize;
	uint32 /*-*/ eventCurrentWriter;
	uint32 /*-*/ eventCurrentReader;
	uint32 /*-*/ clientId;
} DreitonShmHeader;

def struct{
	uint32 /*-*/ requestStartOffset;
	uint32 /*-*/ requestSize;
} DreitonShmRequestSlot;

def struct{
	uint32 /*-*/ replyStartOffset;
	uint32 /*-*/ replySize;
} DreitonShmReplySlot;

def struct{
	uint32 /*-*/ eventStartOffset;
	uint32 /*-*/ eventSize;
} DreitonShmEventSlot;

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


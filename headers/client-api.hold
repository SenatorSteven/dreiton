#ifndef CLIENT_API_HOLD
#define CLIENT_API_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

#define CLIENT_PROTOCOL_VERSION /*-*/ (1)

/*! implement client extensions */

/*! create #defines for each version, as well as a struct with the version appended or something equivalent for ease of access of the elements later */

def struct{
	uint32 /*-------*/ descriptorSize;
	uint32 /*-------*/ protocolVersion;
	uint32 /*-------*/ extensionVersion;
	uint32 /*-------*/ extensionNameSize;
	const char * /*-*/ extensionName;
	uint8 /*--------*/ pad0[4];
	uint32 /*-------*/ authorNameSize;
	const char * /*-*/ authorName;
	bool /*---------*/ (*initClientExtensionDescriptorSystem)(void);
	bool /*---------*/ (*finiClientExtensionDescriptorSystem)(void);
} ClientExtensionDescriptor;

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


#define DREITON_BASE_OBJECT_NAME /*-----------------------------------------*/ ("libdreiton-base-extension.so")
#define DREITON_BASE_OBJECT_NAME_LENGTH /*----------------------------------*/ (lengthof(DREITON_BASE_OBJECT_NAME) + 1)

#define NONE_DREITON_BASE_REQUEST_TYPE /*-----------------------------------*/ (0)
#define GET_MAGIC_NUMBER_DREITON_BASE_REQUEST_TYPE /*-----------------------*/ (1)
#define SET_MAGIC_NUMBER_DREITON_BASE_REQUEST_TYPE /*-----------------------*/ (2)

#define NONE_DREITON_BASE_REPLY_TYPE /*-------------------------------------*/ (0)
#define GET_MAGIC_NUMBER_DREITON_BASE_REPLY_TYPE /*-------------------------*/ (1)
#define SET_MAGIC_NUMBER_DREITON_BASE_REPLY_TYPE /*-------------------------*/ (2)

#define NONE_DREITON_BASE_EVENT_TYPE /*-------------------------------------*/ (0)
#define MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE /*---------------------*/ (1)

#define NONE_DREITON_BASE_ERROR_TYPE /*-------------------------------------*/ (0)

#define NONE_DREITON_BASE_REQUEST_ITEM_AMOUNT /*----------------------------*/ (0)
#define GET_MAGIC_NUMBER_DREITON_BASE_REQUEST_ITEM_AMOUNT /*----------------*/ (0)
#define SET_MAGIC_NUMBER_DREITON_BASE_REQUEST_ITEM_AMOUNT /*----------------*/ (1)

#define NONE_DREITON_BASE_REPLY_ITEM_AMOUNT /*------------------------------*/ (0)
#define GET_MAGIC_NUMBER_DREITON_BASE_REPLY_ITEM_AMOUNT /*------------------*/ (1)
#define SET_MAGIC_NUMBER_DREITON_BASE_REPLY_ITEM_AMOUNT /*------------------*/ (0)

#define NONE_DREITON_BASE_EVENT_ITEM_AMOUNT /*------------------------------*/ (0)
#define MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_ITEM_AMOUNT /*--------------*/ (1)

#define NONE_DREITON_BASE_ERROR_ITEM_AMOUNT /*------------------------------*/ (0)


#define NONE_DREITON_BASE_EVENT_TYPE_MASK /*--------------------------------*/ (b(0))
#define MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE_MASK /*----------------*/ (b(1))

def struct{
	uint8 /*--*/ pad0[1];
} GetMagicNumberDreitonBaseRequestDescription;

def struct{

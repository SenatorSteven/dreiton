#ifndef CLIENT_SYSTEM_HOLD
#define CLIENT_SYSTEM_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

#define ServerConnectionSystem /*-----------------*/ ServerConnectionSystem

#define INITSERVERCONNECTION() /*-----------------*/ bool  initServerConnection(ServerConnectionSystem *const serverConnectionSystem)
#define SETSERVERCONNECTIONSERVERCHANNELPATH() /*-*/ bool  setServerConnectionServerChannelPath(ServerConnectionSystem *const serverConnectionSystem, const char *serverChannelPath)
#define CONNECTTOSERVER() /*----------------------*/ bool  connectToServer(ServerConnectionSystem *const serverConnectionSystem)
#define SENDSERVERREQUEST() /*--------------------*/ bool  sendServerRequest(ServerConnectionSystem *const serverConnectionSystem, const uint8 requestType, const uint8 extension, void *const request, const uint itemAmount, uint32 *const tokenReturn)
#define WAITFORSERVERREPLY() /*-------------------*/ bool  waitForServerReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, void *const replyReturn)
#define FLUSHSERVERBUFFER() /*--------------------*/ bool  flushServerBuffer(ServerConnectionSystem *const serverConnectionSystem)
#define WAITFORSERVEREVENT() /*-------------------*/ bool  waitForServerEvent(ServerConnectionSystem *const serverConnectionSystem, void *const eventReturn)
#define PACKSERVERREQUEST() /*--------------------*/ bool  packServerRequest(GenericRequest *const request, const uint32 itemAmount, void *const structStart)
#define DISCONNECTFROMSERVER() /*-----------------*/ bool  disconnectFromServer(ServerConnectionSystem *const serverConnectionSystem)
#define FINISERVERCONNECTION() /*-----------------*/ bool  finiServerConnection(ServerConnectionSystem *const serverConnectionSystem)

def struct{
	void * /*----------------------*/ clientExtensionHandle;
	ClientExtensionDescriptor * /*-*/ clientExtensionDescriptor;
} ClientExtension;

def struct{
	const char * /*----------------*/ serverChannelPath;
	ClientExtension * /*-----------*/ clientExtensionStart;
	Header * /*--------------------*/ shmStart;
	RequestSlot * /*---------------*/ requestSlotStart;
	ReplySlot * /*-----------------*/ replySlotStart;
	EventSlot * /*-----------------*/ eventSlotStart;
	GenericRequest * /*------------*/ requestStart;
	GenericRequest * /*------------*/ requestCurrent;
	GenericReply * /*--------------*/ replyStart;
	GenericReply * /*--------------*/ replyCurrent;
	GenericEvent * /*--------------*/ eventStart;
	GenericEvent * /*--------------*/ eventCurrent;
	uint32 /*----------------------*/ clientExtensionSize;
	uint32 /*----------------------*/ clientExtensionAllocated;
	uint32 /*----------------------*/ clientExtensionBlockSize;
	uint32 /*----------------------*/ clientId;
	int32 /*-----------------------*/ replyEpollFd;
	int32 /*-----------------------*/ eventEpollFd;
	int32 /*-----------------------*/ serverRequestWriteFd;
	int32 /*-----------------------*/ clientReplyReadFd;
	int32 /*-----------------------*/ clientEventReadFd;
	uint32 /*----------------------*/ currentToken;
	uint32 /*----------------------*/ lastTokenRead;
	uint32 /*----------------------*/ tokenBacklogSize;
	uint8 /*-----------------------*/ requestAmount;
	bool /*------------------------*/ hasError;
	uint8 /*-----------------------*/ pad0[6];
} ServerConnectionSystem;

INITSERVERCONNECTION();
SETSERVERCONNECTIONSERVERCHANNELPATH();
CONNECTTOSERVER();
SENDSERVERREQUEST();
WAITFORSERVERREPLY();
FLUSHSERVERBUFFER();
WAITFORSERVEREVENT();
PACKSERVERREQUEST();
DISCONNECTFROMSERVER();
FINISERVERCONNECTION();

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


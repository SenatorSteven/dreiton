#define ServerSystem /*------------------------------*/ ServerSystem

/*! add a way to block adding modules, thus turning a boolean on, thus performing on checks on mod loading */

/*! allow closing on 0 clients. */

#define INITSERVERSYSTEM() /*----------------------*/ bool           initServerSystem(ServerSystem *const serverSystem)
#define SETSERVERSERVERCHANNELPATH() /*------------*/ bool           setServerServerChannelPath(ServerSystem *const serverSystem, const char *const serverChannelPath)
#define SETSERVERCLIENTCHANNELPATH() /*------------*/ bool           setServerClientChannelPath(ServerSystem *const serverSystem, const char *const clientChannelPath)
#define SETSERVEREXTENSIONBLOCKSIZE() /*-----------*/ bool           setServerExtensionBlockSize(ServerSystem *const serverSystem, const uint serverExtensionBlockSize)
#define SETSERVERCLIENTBLOCKSIZE() /*--------------*/ bool           setServerClientBlockSize(ServerSystem *const serverSystem, const uint serverClientBlockSize)
#define BOOTSERVERREPLYLOOPTHREAD() /*-------------*/ bool           bootServerReplyLoopThread(ServerSystem *const serverSystem)
#define BOOTSERVEREVENTLOOPTHREAD() /*-------------*/ bool           bootServerEventLoopThread(ServerSystem *const serverSystem)
#define BOOTSERVERREGISTRATIONLOOPTHREAD() /*------*/ bool           bootServerRegistrationLoopThread(ServerSystem *const serverSystem)
#define SERVERREPLYLOOP() /*-----------------------*/ void *         serverReplyLoop(void *const arg)
#define SERVEREVENTLOOP() /*-----------------------*/ void *         serverEventLoop(void *const arg)
#define SERVERREGISTRATIONLOOP() /*----------------*/ void *         serverRegistrationLoop(void *const arg)
#define INSERTSERVERCLIENT() /*--------------------*/ bool           insertServerClient(ServerSystem *const serverSystem, const int serverRequestReadFd, const int clientReplyWriteFd, const int clientEventWriteFd)
#define PARSESERVERCLIENTREQUESTS() /*-------------*/ bool           parseServerClientRequests(ServerSystem *const serverSystem, ServerClient *const serverClient, const uint8 requestAmount)
#define LOADSERVEREXTENSION() /*-------------------*/ bool           loadServerExtension(ServerSystem *const serverSystem, const char *const path, uint32 *const extensionIdReturn)
#define UNLOADSERVEREXTENSION() /*-----------------*/ bool           unloadServerExtension(ServerSystem *const serverSystem)
#define REMOVESERVERCLIENT() /*--------------------*/ bool           removeServerClient(ServerSystem *const serverSystem, ServerClient *const serverClient)
#define REMOVEALLSERVERCLIENTS() /*----------------*/ bool           removeAllServerClients(ServerSystem *const serverSystem)
#define QUITSERVERREGISTRATIONLOOPTHREAD() /*------*/ bool           quitServerRegistrationLoopThread(ServerSystem *const serverSystem)
#define QUITSERVEREVENTLOOPTHREAD() /*-------------*/ bool           quitServerEventLoopThread(ServerSystem *const serverSystem)
#define QUITSERVERREPLYLOOPTHREAD() /*-------------*/ bool           quitServerReplyLoopThread(ServerSystem *const serverSystem)
#define AWAITSERVERREGISTRATIONLOOPTHREADEXIT() /*-*/ bool           awaitServerRegistrationLoopThreadExit(ServerSystem *const serverSystem)
#define AWAITSERVEREVENTLOOPTHREADEXIT() /*--------*/ bool           awaitServerEventLoopThreadExit(ServerSystem *const serverSystem)
#define AWAITSERVERREPLYLOOPTHREADEXIT() /*--------*/ bool           awaitServerReplyLoopThreadExit(ServerSystem *const serverSystem)
#define REMOVEALLSERVEREXTENSIONS() /*-------------*/ bool           removeAllServerExtensions(ServerSystem *const serverSystem)
#define ISVALIDSERVERCLIENT() /*-------------------*/ bool           isValidServerClient(ServerSystem *const serverSystem, ServerClient *const serverClient)
#define FINDSERVERCLIENTFD() /*--------------------*/ ServerClient * findServerClientFd(ServerSystem *const serverSystem, const int fd)
#define FINDSERVERCLIENTFDID() /*------------------*/ ServerClient * findServerClientFdId(ServerSystem *const serverSystem, const int fd, const uint32 id)
#define FINISERVERSYSTEM() /*----------------------*/ bool           finiServerSystem(ServerSystem *const serverSystem)

def struct{
	void * /*----------------------*/ serverExtensionHandle;
	ServerExtensionDescriptor * /*-*/ serverExtensionDescriptor;
	uint32 /*----------------------*/ serverExtensionReferenceCount;
	uint8 /*-----------------------*/ pad0[4];
} ServerExtension;

def struct{
	uint32 /*----------------------*/ requestSlotStartOffset;
	uint32 /*----------------------*/ requestSlotSize;
	uint32 /*----------------------*/ requestStartOffset;
	uint32 /*----------------------*/ requestSize;
	uint32 /*----------------------*/ requestCurrentWriter;
	uint32 /*----------------------*/ requestCurrentReader;
	uint32 /*----------------------*/ replySlotStartOffset;
	uint32 /*----------------------*/ replySlotSize;
	uint32 /*----------------------*/ replyStartOffset;
	uint32 /*----------------------*/ replySize;
	uint32 /*----------------------*/ replyCurrentWriter;
	uint32 /*----------------------*/ replyCurrentReader;
	uint32 /*----------------------*/ eventSlotStartOffset;
	uint32 /*----------------------*/ eventSlotSize;
	uint32 /*----------------------*/ eventStartOffset;
	uint32 /*----------------------*/ eventSize;
	uint32 /*----------------------*/ eventCurrentWriter;
	uint32 /*----------------------*/ eventCurrentReader;
	uint32 /*----------------------*/ clientId;
} Header;

def struct{
	uint32 /*----------------------*/ requestStartOffset;
	uint32 /*----------------------*/ requestSize;
} RequestSlot;

def struct{
	uint32 /*----------------------*/ replyStartOffset;
	uint32 /*----------------------*/ replySize;
} ReplySlot;

def struct{
	uint32 /*----------------------*/ eventStartOffset;
	uint32 /*----------------------*/ eventSize;
} EventSlot;

def struct{
	Header * /*--------------------*/ shmStart;
	RequestSlot * /*---------------*/ requestSlotStart;
	ReplySlot * /*-----------------*/ replySlotStart;
	EventSlot * /*-----------------*/ eventSlotStart;
	GenericRequest * /*------------*/ requestStart;
	GenericRequest * /*------------*/ requestCurrent;
	GenericReply * /*--------------*/ replyStart;
	GenericReply * /*--------------*/ replyCurrent;
	GenericEvent * /*--------------*/ eventStart;
	GenericEvent * /*--------------*/ eventCurrent;
	int32 /*-----------------------*/ shmId;
	int32 /*-----------------------*/ serverRequestReadFd;
	int32 /*-----------------------*/ serverClientReplyWriteFd;
	int32 /*-----------------------*/ serverClientEventWriteFd;
	uint32 /*----------------------*/ clientId;
	uint8 /*-----------------------*/ pad0[4];
} ServerClient;

def struct{
	const char * /*----------------*/ serverChannelPath;
	const char * /*----------------*/ clientChannelPath;
	ServerExtension * /*-----------*/ serverExtensionStart;
	ServerClient * /*--------------*/ serverClientStart;
	uint32 /*----------------------*/ serverExtensionSize;
	uint32 /*----------------------*/ serverExtensionAllocated;
	uint32 /*----------------------*/ serverExtensionBlockSize;
	uint32 /*----------------------*/ serverClientSize;
	uint32 /*----------------------*/ serverClientAllocated;
	uint32 /*----------------------*/ serverClientBlockSize;
	int32 /*-----------------------*/ replyEpollFd;
	int32 /*-----------------------*/ eventEpollFd;
	int32 /*-----------------------*/ signalFd;
	bool /*------------------------*/ replyLoopRunning;
	bool /*------------------------*/ eventLoopRunning;
	bool /*------------------------*/ registrationLoopRunning;
	bool /*------------------------*/ replyLoopThreadCreated;
	bool /*------------------------*/ eventLoopThreadCreated;
	bool /*------------------------*/ registrationLoopThreadCreated;
	uint8 /*-----------------------*/ pad0[6];
	pthread_t /*-------------------*/ replyLoopThread;
	pthread_t /*-------------------*/ eventLoopThread;
	pthread_t /*-------------------*/ registrationLoopThread;



	/*!*/

	int32 /*-----------------------*/ registrationEventFd;
	int32 /*-----------------------*/ registrationEpollFd;
	int32 /*-----------------------*/ replyEventFd;
	uint32 /*----------------------*/ clientOffset;
	int32 /*-----------------------*/ fdCopy[3];
	uint8 /*-----------------------*/ pad1[4];



} ServerSystem;



#ifdef a
#define ADDCLIENT() /*---*/ uint32  addClient(ServerSystem *const serverSystem)
#define ADDEVENT() /*----*/ uint32  addEvent(ServerSystem *const serverSystem)
#define SUBSCRIBE() /*---*/ bool    subscribe(ServerSystem *const serverSystem, const uint32 clientOffset, const uint32 eventType)
#define EMITEVENT() /*---*/ bool    emitEvent(ServerSystem *const serverSystem, const uint32 eventType)
#define UNSUBSCRIBE() /*-*/ bool    unsubscribe(ServerSystem *const serverSystem, const uint32 clientOffset, const uint32 eventType)

def struct{
	uint32 /*---------------*/ eventType;
	uint32 /*---------------*/ eventSubscriptionOffset;
} ClientSubscription;

def struct{
	ClientSubscription * /*-*/ subscriptionStart;
	uint32 /*---------------*/ subscriptionSize;
	uint32 /*---------------*/ subscriptionAllocated;
	uint32 * /*-------------*/ eventStart;
	uint32 /*---------------*/ eventSize;
	uint8 /*----------------*/ pad0[4];
} ServerClient;

def struct{
	uint32 /*---------------*/ clientOffset;
	uint32 /*---------------*/ clientSubscriptionOffset;
} EventSubscription;

def struct{
	EventSubscription * /*--*/ subscriptionStart;
	uint32 /*---------------*/ subscriptionSize;
	uint32 /*---------------*/ subscriptionAllocated;
} ServerEvent;

def struct{
	ServerClient * /*-------*/ clientStart;
	uint32 /*---------------*/ clientSize;
	uint32 /*---------------*/ clientAllocated;
	ServerEvent * /*--------*/ eventStart;
	uint32 /*---------------*/ eventSize;
	uint32 /*---------------*/ eventAllocated;
} ServerSystem;

ADDCLIENT();
ADDEVENT();
SUBSCRIBE();
EMITEVENT();
UNSUBSCRIBE();

ADDCLIENT(){
	const uint32 blockSize = 16;
	ServerClient *serverClient;
	if(!serverSystem){
		ret false;
	}
	jmp insertClient;
	insertClient:{
		if((*serverSystem).clientAllocated == (*serverSystem).clientSize){
			void *temp;
			(*serverSystem).clientSize += blockSize;
			temp = realloc((*serverSystem).clientStart, (*serverSystem).clientSize * sizeof(ServerClient));
			if(!temp){
				(*serverSystem).clientSize -= blockSize;
				ret 0;
			}
			(*serverSystem).clientStart = temp;
			if(!(*serverSystem).clientAllocated){
				inc (*serverSystem).clientAllocated;
				jmp insertClient;
			}
		}
	}
	serverClient = (*serverSystem).clientStart + (*serverSystem).clientAllocated;
	(*serverClient).subscriptionStart = NULL;
	(*serverClient).subscriptionSize = 0;
	(*serverClient).subscriptionAllocated = 0;
	(*serverClient).eventStart = NULL;
	(*serverClient).eventSize = 0;
	inc (*serverSystem).clientAllocated;
	ret (*serverSystem).clientAllocated - 1;
}
ADDEVENT(){
	const uint32 blockSize = 16;
	ServerEvent *serverEvent;
	if(!serverSystem){
		ret false;
	}
	jmp insertEvent;
	insertEvent:{
		if((*serverSystem).eventAllocated == (*serverSystem).eventSize){
			void *temp;
			(*serverSystem).eventSize += blockSize;
			temp = realloc((*serverSystem).eventStart, (*serverSystem).eventSize * sizeof(ServerEvent));
			if(!temp){
				(*serverSystem).eventSize -= blockSize;
				ret 0;
			}
			(*serverSystem).eventStart = temp;
			if(!(*serverSystem).eventAllocated){
				inc (*serverSystem).eventAllocated;
				jmp insertEvent;
			}
		}
	}
	serverEvent = (*serverSystem).eventStart + (*serverSystem).eventAllocated;
	(*serverEvent).subscriptionStart = NULL;
	(*serverEvent).subscriptionSize = 0;
	(*serverEvent).subscriptionAllocated = 0;
	inc (*serverSystem).eventAllocated;
	ret (*serverSystem).eventAllocated - 1;
}
SUBSCRIBE(){
	const uint32 blockSize = 16;
	ServerClient *client;
	ServerEvent *event;
	ClientSubscription *clientSubscription;
	EventSubscription *eventSubscription;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).clientAllocated or !(*serverSystem).eventAllocated or !clientOffset or !eventType){
		ret false;
	}
	client = (*serverSystem).clientStart + clientOffset;
	if(eventType < (*client).eventSize and *((*client).eventStart + eventType)){
		ret false;
	}
	event = (*serverSystem).eventStart + eventType;
	if((*client).subscriptionAllocated == (*client).subscriptionSize){
		void *temp;
		(*client).subscriptionSize += blockSize;
		temp = realloc((*client).subscriptionStart, (*client).subscriptionSize * sizeof(ClientSubscription));
		if(!temp){
			(*client).subscriptionSize -= blockSize;
			ret false;
		}
		(*client).subscriptionStart = temp;
	}
	if(eventType >= (*client).eventSize){
		const uint size = eventType + 1;
		void *temp;
		temp = realloc((*client).eventStart, size * sizeof(uint32));
		if(!temp){
			ret false;
		}
		(*client).eventStart = temp;
		{
			uint i = (*client).eventSize;
			while(i < size){ /*! memset later */
				*((*client).eventStart + i) = 0;
				inc i;
			}
		}
		(*client).eventSize = size;
	}
	if((*event).subscriptionAllocated == (*event).subscriptionSize){
		void *temp;
		(*event).subscriptionSize += blockSize;
		temp = realloc((*event).subscriptionStart, (*event).subscriptionSize * sizeof(EventSubscription));
		if(!temp){
			(*event).subscriptionSize -= blockSize;
			ret false;
		}
		(*event).subscriptionStart = temp;
	}
	clientSubscription = (*client).subscriptionStart + (*client).subscriptionAllocated;
	(*clientSubscription).eventType = eventType;
	(*clientSubscription).eventSubscriptionOffset = (*event).subscriptionAllocated;
	*((*client).eventStart + eventType) = (*event).subscriptionAllocated;
	eventSubscription = (*event).subscriptionStart + (*event).subscriptionAllocated;
	(*eventSubscription).clientOffset = clientOffset;
	(*eventSubscription).clientSubscriptionOffset = (*client).subscriptionAllocated;
	inc (*client).subscriptionAllocated;
	inc (*event).subscriptionAllocated;
	ret true;
}
EMITEVENT(){
	ServerEvent *event;
	EventSubscription *current;
	EventSubscription *wall;
	ServerClient *clientStart;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).eventAllocated or eventType >= (*serverSystem).eventAllocated){
		ret false;
	}
	event = (*serverSystem).eventStart + eventType;
	current = (*event).subscriptionStart;
	wall = current + (*event).subscriptionAllocated;
	clientStart = (*serverSystem).clientStart;
	success = false;
	jmp emitEventLoop;
	emitEventLoop:{
		if(current < wall){
			uint clientOffset = (*current).clientOffset;
			ServerClient *serverClient = clientStart + clientOffset;
			(void)serverClient;
			{
				fprintf(stdout, "event %u -> client %u\n", eventType, clientOffset);
			}
			success = true;
			inc current;
			jmp emitEventLoop;
		}
		fprintf(stdout, "\n");
		if(!success){
			ret false;
		}
		ret true;
	}
}
UNSUBSCRIBE(){
	ServerClient *client;
	ServerEvent *event;
	uint32 eventSubscriptionOffset;
	uint32 clientSubscriptionOffset;
	uint32 lastClientSubscriptionOffset;
	uint32 lastEventSubscriptionOffset;
	if(!serverSystem){
		ret false;
	}
	client = (*serverSystem).clientStart + clientOffset;
	event = (*serverSystem).eventStart + eventType;
	if(client < (*serverSystem).clientStart + 1 or client > (*serverSystem).clientStart + (*serverSystem).clientAllocated or eventType >= (*client).eventSize or event < (*serverSystem).eventStart + 1 or event > (*serverSystem).eventStart + (*serverSystem).eventAllocated){
		ret false;
	}
	eventSubscriptionOffset = *((*client).eventStart + eventType);
	if(!eventSubscriptionOffset){
		ret false;
	}
	clientSubscriptionOffset = (*((*event).subscriptionStart + eventSubscriptionOffset)).clientSubscriptionOffset;
	lastClientSubscriptionOffset = (*client).subscriptionAllocated - 1;
	lastEventSubscriptionOffset = (*event).subscriptionAllocated - 1;
	if(clientSubscriptionOffset != lastClientSubscriptionOffset){
		const ClientSubscription lastClientSubscription = *((*client).subscriptionStart + lastClientSubscriptionOffset);
		*((*client).subscriptionStart + clientSubscriptionOffset) = lastClientSubscription;
		*((*client).eventStart + lastClientSubscription.eventType) = clientSubscriptionOffset;
		(*((*((*serverSystem).eventStart + lastClientSubscription.eventType)).subscriptionStart + lastClientSubscription.eventSubscriptionOffset)).clientSubscriptionOffset = clientSubscriptionOffset;
	}
	if(eventSubscriptionOffset != lastEventSubscriptionOffset){
		const EventSubscription lastEventSubscription = *((*event).subscriptionStart + lastEventSubscriptionOffset);
		*((*event).subscriptionStart + eventSubscriptionOffset) = lastEventSubscription;
		(*((*((*serverSystem).clientStart + lastEventSubscription.clientOffset)).subscriptionStart + lastEventSubscription.clientSubscriptionOffset)).eventSubscriptionOffset = eventSubscriptionOffset;
	}
	*((*client).eventStart + eventType) = 0;
	dec (*client).subscriptionAllocated;
	dec (*event).subscriptionAllocated;
	ret true;
}
int main(void){
	ServerSystem serverSystem;
	serverSystem.clientStart = NULL;
	serverSystem.clientSize = 0;
	serverSystem.clientAllocated = 0;
	serverSystem.eventStart = NULL;
	serverSystem.eventSize = 0;
	serverSystem.eventAllocated = 0;
	{
		const uint32 client1 = addClient(&serverSystem);
		const uint32 client2 = addClient(&serverSystem);
		const uint32 event1 = addEvent(&serverSystem);
		const uint32 event2 = addEvent(&serverSystem);
		subscribe(&serverSystem, client1, event1);
		subscribe(&serverSystem, client1, event2);
		subscribe(&serverSystem, client2, event1);
		subscribe(&serverSystem, client2, event2);
		unsubscribe(&serverSystem, client2, event2);
		emitEvent(&serverSystem, event2);
	}
	ret 0;
}
#endif









INITSERVERSYSTEM();
SETSERVERSERVERCHANNELPATH();
SETSERVERCLIENTCHANNELPATH();
SETSERVEREXTENSIONBLOCKSIZE();
SETSERVERCLIENTBLOCKSIZE();
BOOTSERVERREPLYLOOPTHREAD();
BOOTSERVEREVENTLOOPTHREAD();
BOOTSERVERREGISTRATIONLOOPTHREAD();
SERVERREPLYLOOP();
SERVEREVENTLOOP();
SERVERREGISTRATIONLOOP();
INSERTSERVERCLIENT();
PARSESERVERCLIENTREQUESTS();
LOADSERVEREXTENSION();
UNLOADSERVEREXTENSION();
REMOVESERVERCLIENT();
REMOVEALLSERVERCLIENTS();
QUITSERVERREGISTRATIONLOOPTHREAD();
QUITSERVEREVENTLOOPTHREAD();
QUITSERVERREPLYLOOPTHREAD();
AWAITSERVERREGISTRATIONLOOPTHREADEXIT();
AWAITSERVEREVENTLOOPTHREADEXIT();
AWAITSERVERREPLYLOOPTHREADEXIT();
REMOVEALLSERVEREXTENSIONS();
ISVALIDSERVERCLIENT();
FINDSERVERCLIENTFD();
FINDSERVERCLIENTFDID();
FINISERVERSYSTEM();


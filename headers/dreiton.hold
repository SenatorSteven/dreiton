#ifndef DREITON_HOLD
#define DREITON_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

#define Dreiton /*-----------------------*/ Dreiton

#define INITDREITON() /*-----------------*/ bool  initDreiton(Dreiton *const dreiton)
#define SETDREITONSERVERCHANNELPATH() /*-*/ bool  setDreitonServerChannelPath(Dreiton *const dreiton, const char *const serverChannelPath)
#define CONNECTTODREITON() /*------------*/ bool  connectToDreiton(Dreiton *const dreiton)
#define SENDDREITONREQUEST() /*----------*/ bool  sendDreitonRequest(Dreiton *const dreiton, const uint8 requestType, const uint8 extension, void *const request, const uint itemAmount, uint32 *const tokenReturn)
#define WAITFORDREITONREPLY() /*---------*/ bool  waitForDreitonReply(Dreiton *const dreiton, const uint32 token, void *const replyReturn)
#define FLUSHDREITONBUFFER() /*----------*/ bool  flushDreitonBuffer(Dreiton *const dreiton)
#define WAITFORDREITONEVENT() /*---------*/ bool  waitForDreitonEvent(Dreiton *const dreiton, void *const eventReturn)
#define DISCONNECTFROMDREITON() /*-------*/ bool  disconnectFromDreiton(Dreiton *const dreiton)
#define FINIDREITON() /*-----------------*/ bool  finiDreiton(Dreiton *const dreiton)

def struct{
	const char * /*------------*/ serverChannelPath;
	DreitonShmHeader * /*------*/ shmStart;
	DreitonShmRequestSlot * /*-*/ requestSlotStart;
	DreitonShmReplySlot * /*---*/ replySlotStart;
	DreitonShmEventSlot * /*---*/ eventSlotStart;
	GenericDreitonRequest * /*-*/ requestStart;
	GenericDreitonRequest * /*-*/ requestCurrent;
	GenericDreitonReply * /*---*/ replyStart;
	GenericDreitonReply * /*---*/ replyCurrent;
	GenericDreitonEvent * /*---*/ eventStart;
	GenericDreitonEvent * /*---*/ eventCurrent;
	uint32 /*------------------*/ clientId;
	int32 /*-------------------*/ replyEpollFd;
	int32 /*-------------------*/ eventEpollFd;
	int32 /*-------------------*/ requestWriteFd;
	int32 /*-------------------*/ replyReadFd;
	int32 /*-------------------*/ eventReadFd;
	uint32 /*------------------*/ currentToken;
	uint32 /*------------------*/ lastTokenRead;
	uint32 /*------------------*/ tokenBacklogSize;
	uint8 /*-------------------*/ requestAmount;
	bool /*--------------------*/ hasError;
	uint8 /*-------------------*/ pad0[2];
} Dreiton;

INITDREITON();
SETDREITONSERVERCHANNELPATH();
CONNECTTODREITON();
SENDDREITONREQUEST();
WAITFORDREITONREPLY();
FLUSHDREITONBUFFER();
WAITFORDREITONEVENT();
DISCONNECTFROMDREITON();
FINIDREITON();

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


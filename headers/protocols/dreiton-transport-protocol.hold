#ifndef DREITON_TRANSPORT_PROTOCOL_HOLD
#define DREITON_TRANSPORT_PROTOCOL_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

#define DREITON_TRANSPORT_PROTOCOL_VERSION /*-------------*/ (1)

#define NONE_DREITON_TRANSPORT_REQUEST_OPERATION /*-------*/ (0)
#define CONNECT_DREITON_TRANSPORT_REQUEST_OPERATION /*----*/ (1)
#define REQUEST_DREITON_TRANSPORT_REQUEST_OPERATION /*----*/ (2)
#define DISCONNECT_DREITON_TRANSPORT_REQUEST_OPERATION /*-*/ (3)

#define NONE_DREITON_TRANSPORT_STATUS /*------------------*/ (b(00000))
#define SUCCESS_DREITON_TRANSPORT_STATUS /*---------------*/ (b(00001))
#define FAILURE_DREITON_TRANSPORT_STATUS /*---------------*/ (b(00010))
#define ERROR_DREITON_TRANSPORT_STATUS /*-----------------*/ (b(00100))
#define HANG_UP_DREITON_TRANSPORT_STATUS /*---------------*/ (b(01000))
#define EXIT_DREITON_TRANSPORT_STATUS /*------------------*/ (b(10000))

def struct{
	uint64 /*-------*/ clientId;
	uint64 /*-------*/ clientHandle;
	void * /*-------*/ dataStart;
	uint32 /*-------*/ dataSize;
	uint32 /*-------*/ requestAmount;
	uint8 /*--------*/ operation;
	uint8 /*--------*/ pad0[7];
} DreitonServerTransportRequest;

def struct{
	uint32 /*-------*/ descriptorSize;
	uint32 /*-------*/ protocolVersion;
	uint32 /*-------*/ transportVersion;
	uint32 /*-------*/ transportNameSize;
	uint32 /*-------*/ authorNameSize;
	uint8 /*--------*/ pad0[4];
	const char * /*-*/ transportName;
	const char * /*-*/ authorName;
	bool /*---------*/ (*initDreitonTransportDescriptor)(void **const handleReturn);









	bool /*---------*/ (*setDreitonTransportDescriptorClientBlockSize)(void *const handle, const uint32 clientBlockSize);
	bool /*---------*/ (*setDreitonTransportDescriptorConcurrentConnectionAmount)(void *const handle, const uint32 concurrentConnectionAmount);
	bool /*---------*/ (*setDreitonTransportDescriptorRequestSlotSize)(void *const handle, const uint32 requestSlotSize);
	bool /*---------*/ (*setDreitonTransportDescriptorReplySlotSize)(void *const handle, const uint32 replySlotSize);
	bool /*---------*/ (*setDreitonTransportDescriptorEventSlotSize)(void *const handle, const uint32 eventSlotSize);
	bool /*---------*/ (*setDreitonTransportDescriptorRequestSize)(void *const handle, const uint32 requestSize);
	bool /*---------*/ (*setDreitonTransportDescriptorReplySize)(void *const handle, const uint32 replySize);
	bool /*---------*/ (*setDreitonTransportDescriptorEventSize)(void *const handle, const uint32 eventSize);
	bool /*---------*/ (*createDreitonTransportDescriptorRequestReceiver)(void *const handle);
	bool /*---------*/ (*createDreitonTransportDescriptorEventReceiver)(void *const handle);
	bool /*---------*/ (*createDreitonTransportDescriptorRegistrationReceiver)(void *const handle, const void *const argument);
	bool /*---------*/ (*waitForDreitonTransportDescriptorRequest)(void *const handle, DreitonServerTransportRequest *const transportRequestReturn);
	bool /*---------*/ (*waitForDreitonTransportDescriptorEvent)(void *const handle, uint32 *const extensionReturn, uint32 *const eventTypeReturn);
	bool /*---------*/ (*waitForDreitonTransportDescriptorRegistration)(void *const handle, const uint32 dataSizeReturn, void *const dataReturn);
	bool /*---------*/ (*handshakeDreitonTransportDescriptorRegistration)(void *const handle, const bool successfulHandshake, const uint32 dataSize, const void *const data);
	bool /*---------*/ (*consumeDreitonTransportDescriptorRegistration)(void *const handle);
	bool /*---------*/ (*setDreitonTransportDescriptorClientHandle)(void *const handle, const uint32 clientId, const uint64 clientHandle);
	bool /*---------*/ (*getDreitonTransportDescriptorClientRequestFrame)(void *const handle, const uint32 clientId, void **const frameReturn);
	bool /*---------*/ (*getDreitonTransportDescriptorReplyFrame)(void *const handle, const uint32 clientId, const uint32 frameSize, void **const frameReturn);
	bool /*---------*/ (*getDreitonTransportDescriptorEventFrame)(void *const handle, const uint32 clientId, const uint32 frameSize, void **const frameReturn);
	bool /*---------*/ (*consumeDreitonTransportDescriptorClientRequestFrame)(void *const handle, const uint32 clientId);
	bool /*---------*/ (*sendDreitonTransportDescriptorReply)(void *const handle, const uint32 clientId, const uint32 frameSize, const void *const frame);
	bool /*---------*/ (*sendDreitonTransportDescriptorEvent)(void *const handle, const uint32 clientId, const uint32 frameSize, const void *const frame);
	bool /*---------*/ (*wakeUpDreitonTransportDescriptorRegistration)(void *const handle);
	bool /*---------*/ (*wakeUpDreitonTransportDescriptorRequest)(void *const handle);
	bool /*---------*/ (*wakeUpDreitonTransportDescriptorEvent)(void *const handle);
	bool /*---------*/ (*destroyDreitonTransportDescriptorRegistrationReceiver)(void *const handle);
	bool /*---------*/ (*destroyDreitonTransportDescriptorRequestReceiver)(void *const handle);
	bool /*---------*/ (*destroyDreitonTransportDescriptorEventReceiver)(void *const handle);









	bool /*---------*/ (*finiDreitonTransportDescriptor)(void *const handle);
} DreitonServerTransportDescriptorV1;

def struct{
	uint32 /*-------*/ descriptorSize;
	uint32 /*-------*/ protocolVersion;
	uint32 /*-------*/ transportVersion;
	uint32 /*-------*/ transportNameSize;
	uint32 /*-------*/ authorNameSize;
	uint8 /*--------*/ pad0[4];
	const char * /*-*/ transportName;
	const char * /*-*/ authorName;
	bool /*---------*/ (*initDreitonTransportDescriptorConnection)(void **const handleReturn);
	bool /*---------*/ (*connectToDreitonTransportDescriptorConnection)(void *const handle, const void *const argument, const uint32 greetingSize, const void *const greetingData, const uint32 handshakeSize, void *const handshakeDataReturn);









	bool /*---------*/ (*getDreitonTransportDescriptorRequestFrame)(void *const handle, const uint32 frameSize, void **const requestFrameReturn);
	bool /*---------*/ (*sendDreitonTransportDescriptorRequest)(void *const handle, const uint32 requestFrameSize, const void *const requestFrame);
	bool /*---------*/ (*flushDreitonTransportDescriptorRequestBuffer)(void *const handle);
	bool /*---------*/ (*waitForDreitonTransportDescriptorReply)(void *const handle, uint32 *const frameSizeReturn, void **const frameReturn, uint8 *const statusReturn);
	bool /*---------*/ (*consumeDreitonTransportDescriptorReply)(void *const handle, void *const reply);
	bool /*---------*/ (*waitForDreitonTransportDescriptorEvent)(void *const handle, void **const frameReturn, uint8 *const statusReturn);
	bool /*---------*/ (*consumeDreitonTransportDescriptorEvent)(void *const handle, void *const event);
	bool /*---------*/ (*wakeUpDreitonTransportDescriptorReply)(void *const handle, const uint8 status);
	bool /*---------*/ (*wakeUpDreitonTransportDescriptorEvent)(void *const handle, const uint8 status);
	bool /*---------*/ (*disconnectFromDreitonTransportDescriptorConnection)(void *const handle, const bool notifyServer);









	bool /*---------*/ (*finiDreitonTransportDescriptorConnection)(void *const handle);
} DreitonClientTransportDescriptorV1;

def DreitonServerTransportDescriptorV1 /*-*/ DreitonServerTransportDescriptor;
def DreitonClientTransportDescriptorV1 /*-*/ DreitonClientTransportDescriptor;

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


#ifndef DREITON_CODEC_PROTOCOL_HOLD
#define DREITON_CODEC_PROTOCOL_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

#define DREITON_CODEC_PROTOCOL_VERSION /*-*/ (1)

def struct{
	uint32 /*-------*/ descriptorSize;
	uint32 /*-------*/ protocolVersion;
	uint32 /*-------*/ codecVersion;
	uint32 /*-------*/ codecNameSize;
	uint32 /*-------*/ authorNameSize;
	uint8 /*--------*/ pad0[4];
	const char * /*-*/ codecName;
	const char * /*-*/ authorName;
	bool /*---------*/ (*calculateDreitonCodecFrameSize)(const uint32 messageSize, const uint32 payloadItemAmount, const uint32 *const payloadItemSizeStart, uint32 *const frameSizeReturn);
	bool /*---------*/ (*encodeDreitonCodecMessage)(const uint32 messageSize, const void *const message, const uint32 payloadItemAmount, const uint32 *const payloadItemSizeStart, const void *const *const payloadItemDataStart, const uint32 frameSize, void *const frame);
	bool /*---------*/ (*decodeDreitonCodecMessage)(const void *const frame, void *const decodedFrame, void **const messageHeaderReturn);
	bool /*---------*/ (*getDreitonCodecEncodedToken)(const void *const frame, uint32 *const tokenReturn);
	bool /*---------*/ (*getDreitonCodecEncodedFrameSize)(const void *const frame, uint32 *const frameSizeReturn);
	bool /*---------*/ (*getDreitonCodecDecodedPayloadItemAmount)(const void *const frame, uint32 *const payloadItemAmountReturn);
	bool /*---------*/ (*getDreitonCodecDecodedItem)(const void *const frame, const uint32 which, uint32 *const itemSizeReturn, void **const itemStartReturn);
} DreitonCodecDescriptorV1;

def DreitonCodecDescriptorV1 /*-*/ DreitonCodecDescriptor;

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


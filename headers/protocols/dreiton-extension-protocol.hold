#ifndef DREITON_EXTENSION_PROTOCOL_HOLD
#define DREITON_EXTENSION_PROTOCOL_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

#define DREITON_EXTENSION_PROTOCOL_VERSION /*-*/ (1)

def struct{
	uint16 /*-------*/ type;
	uint8 /*--------*/ status;
	uint8 /*--------*/ pad0[1];
	uint32 /*-------*/ itemAmount;
	void * /*-------*/ dataStart;
	uint32 * /*-----*/ sizeStart;
} DreitonExtensionReplySignature;

def struct{
	uint16 /*-------*/ operation;
	uint8 /*--------*/ parameterOffset;
	uint8 /*--------*/ pad0[1];
	uint32 /*-------*/ value;
} DreitonExtensionErrorSignature;

def struct{
	uint16 /*-------*/ type;
	uint8 /*--------*/ status;
	uint8 /*--------*/ pad0[1];
	uint32 /*-------*/ itemAmount;
	void * /*-------*/ dataStart;
	uint32 * /*-----*/ sizeStart;
} DreitonExtensionEventSignature;

def struct{
	uint32 /*-------*/ descriptorSize;
	uint32 /*-------*/ protocolVersion;
	uint32 /*-------*/ extensionVersion;
	uint32 /*-------*/ extensionNameSize;
	uint32 /*-------*/ authorNameSize;
	uint32 /*-------*/ eventAmount;
	const char * /*-*/ extensionName;
	const char * /*-*/ authorName;
	bool /*---------*/ (*initDreitonExtensionDescriptor)(void **const handleReturn);
	bool /*---------*/ (*parseDreitonExtensionDescriptorRequest)(void *const handle, const uint16 type, const uint32 payloadItemAmount, const void *const frame, bool (*getDreitonDecodedItem)(const void *const frame, const uint32 which, uint32 *const itemSizeReturn, void **const itemStartReturn), DreitonExtensionErrorSignature *const errorSignatureReturn, DreitonExtensionEventSignature *const eventSignatureReturn, uint8 *const statusReturn);
	bool /*---------*/ (*parseDreitonExtensionDescriptorReply)(void *const handle, const uint16 type, DreitonExtensionReplySignature *const replySignatureReturn);
	bool /*---------*/ (*finiDreitonExtensionDescriptor)(void *const handle);
} DreitonExtensionDescriptorV1;

def DreitonExtensionDescriptorV1 /*-*/ DreitonExtensionDescriptor;

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


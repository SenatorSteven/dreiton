#ifndef CLIENT_SYSTEM_HELPERS_HOLD
#define CLIENT_SYSTEM_HELPERS_HOLD

#ifndef COLD_HOLD
#define COLD_INCLUDED
#include "headers/cold/cold.hold"
#endif

/*! put these in a source file */

bool requestServerNoOperation(ServerConnectionSystem *const serverConnectionSystem, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, NO_OPERATION_SERVER_REQUEST_TYPE, 0, NULL, NO_OPERATION_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerSync(ServerConnectionSystem *const serverConnectionSystem, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, SYNC_SERVER_REQUEST_TYPE, 0, NULL, SYNC_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerClaimOwnership(ServerConnectionSystem *const serverConnectionSystem, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, CLAIM_OWNERSHIP_SERVER_REQUEST_TYPE, 0, NULL, CLAIM_OWNERSHIP_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerCloseOnIdle(ServerConnectionSystem *const serverConnectionSystem, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, CLOSE_ON_IDLE_SERVER_REQUEST_TYPE, 0, NULL, CLOSE_ON_IDLE_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerEnableExtension(ServerConnectionSystem *const serverConnectionSystem, const uint32 pathSize, const char *const pathStart, uint32 *const tokenReturn){
	EnableExtensionServerRequest enableExtensionServerRequest;
	enableExtensionServerRequest.pathSize = pathSize;
	enableExtensionServerRequest.pathStart = (void *)pathStart;
	ret sendServerRequest(serverConnectionSystem, ENABLE_EXTENSION_SERVER_REQUEST_TYPE, NONE_SERVER_EXTENSION, &enableExtensionServerRequest, ENABLE_EXTENSION_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerSealOwnership(ServerConnectionSystem *const serverConnectionSystem, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, SEAL_OWNERSHIP_SERVER_REQUEST_TYPE, 0, NULL, SEAL_OWNERSHIP_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerApplyForEvent(ServerConnectionSystem *const serverConnectionSystem, const uint32 extension, const uint32 eventMask, uint32 *const tokenReturn){
	ApplyForEventServerRequest applyForEventServerRequest;
	applyForEventServerRequest.extensionSize = sizeof(uint32);
	applyForEventServerRequest.extensionStart = (void *)&extension;
	applyForEventServerRequest.eventMaskSize = sizeof(uint32);
	applyForEventServerRequest.eventMaskStart = (void *)&eventMask;
	ret sendServerRequest(serverConnectionSystem, APPLY_FOR_EVENT_SERVER_REQUEST_TYPE, NONE_SERVER_EXTENSION, &applyForEventServerRequest, APPLY_FOR_EVENT_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerWithdrawFromEvent(ServerConnectionSystem *const serverConnectionSystem, const uint32 extension, const uint32 eventMask, uint32 *const tokenReturn){
	WithdrawFromEventServerRequest withdrawFromEventServerRequest;
	withdrawFromEventServerRequest.extensionSize = sizeof(uint32);
	withdrawFromEventServerRequest.extensionStart = (void *)&extension;
	withdrawFromEventServerRequest.eventMaskSize = sizeof(uint32);
	withdrawFromEventServerRequest.eventMaskStart = (void *)&eventMask;
	ret sendServerRequest(serverConnectionSystem, WITHDRAW_FROM_EVENT_SERVER_REQUEST_TYPE, NONE_SERVER_EXTENSION, &withdrawFromEventServerRequest, WITHDRAW_FROM_EVENT_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
inline bool waitForServerNoOperationReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, NoOperationServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerSyncReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, SyncServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerClaimOwnershipReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, ClaimOwnershipServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerCloseOnIdleReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, CloseOnIdleServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerEnableExtensionReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, EnableExtensionServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerSealOwnershipReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, SealOwnershipServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerApplyForEventReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, ApplyForEventServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerWithdrawFromEventReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, WithdrawFromEventServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}

#ifdef  COLD_INCLUDED
#undef  COLD_INCLUDED
#include "headers/cold/hot.hold"
#endif

#endif


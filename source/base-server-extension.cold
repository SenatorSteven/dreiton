#include <stdint.h>
#include <unistd.h>

#include "headers/cold/cold.hold"
#include "headers/server-api.hold"
#include "headers/base-server-extension.hold"

#define INITSERVEREXTENSIONDESCRIPTORSYSTEM() /*------------*/ bool  initServerExtensionDescriptorSystem(void)
#define SETSERVEREXTENSIONDESCRIPTOREVENTFD() /*------------*/ bool  setServerExtensionDescriptorEventFd(const int fd)
#define INCREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER() /*-*/ bool  incrementServerExtensionDescriptorEventCounter(const uint32 eventType)
#define DECREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER() /*-*/ bool  decrementServerExtensionDescriptorEventCounter(const uint32 eventType)
#define PARSESERVEREXTENSIONDESCRIPTORREQUEST() /*----------*/ bool  parseServerExtensionDescriptorRequest(const GenericRequest *const request, const uint32 itemAmount, uint8 *const statusReturn, uint32 *const payloadSizeReturn)
#define PARSESERVEREXTENSIONDESCRIPTORREPLY() /*------------*/ bool  parseServerExtensionDescriptorReply(const uint8 replyType, GenericReply *const replyReturn)
#define PARSESERVEREXTENSIONDESCRIPTOREVENT() /*------------*/ bool  parseServerExtensionDescriptorEvent(void)
#define FINISERVEREXTENSIONDESCRIPTORSYSTEM() /*------------*/ bool  finiServerExtensionDescriptorSystem(void)

def struct{
	uint32 /*-*/ fd;
	uint32 /*-*/ clientWantingMagicNumberEventAmount;
	uint32 /*-*/ magicNumber;
} Database;

INITSERVEREXTENSIONDESCRIPTORSYSTEM();
SETSERVEREXTENSIONDESCRIPTOREVENTFD();
INCREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER();
DECREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER();
PARSESERVEREXTENSIONDESCRIPTORREQUEST();
PARSESERVEREXTENSIONDESCRIPTORREPLY();
PARSESERVEREXTENSIONDESCRIPTOREVENT();
FINISERVEREXTENSIONDESCRIPTORSYSTEM();

local Database /*------------*/ database;

ServerExtensionDescriptor /*-*/ serverExtensionDescriptor = {
	  sizeof(ServerExtensionDescriptor)
	, BASE_PROTOCOL_VERSION
	, BASE_EXTENSION_VERSION
	, lengthof(BASE_EXTENSION_NAME)
	, lengthof(BASE_AUTHOR_NAME)
	, BASE_EVENT_AMOUNT
	, BASE_EXTENSION_NAME
	, BASE_AUTHOR_NAME
	, &initServerExtensionDescriptorSystem
	, &setServerExtensionDescriptorEventFd
	, &incrementServerExtensionDescriptorEventCounter
	, &decrementServerExtensionDescriptorEventCounter
	, &parseServerExtensionDescriptorRequest
	, &parseServerExtensionDescriptorReply
	, &parseServerExtensionDescriptorEvent
	, &finiServerExtensionDescriptorSystem
};

INITSERVEREXTENSIONDESCRIPTORSYSTEM(){
	database.fd = 0;
	database.clientWantingMagicNumberEventAmount = 0;
	database.magicNumber = 0;
	ret true;
}
SETSERVEREXTENSIONDESCRIPTOREVENTFD(){
	database.fd = fd;
	ret true;
}
INCREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER(){
	switch(eventType){
		to NONE_BASE_EVENT_TYPE: /*-----------------*/ /*---------------------------------------------*/ ret false;
		to MAGIC_NUMBER_CHANGED_BASE_EVENT_TYPE: /*-*/ inc database.clientWantingMagicNumberEventAmount; ret true;
		off: /*-------------------------------------*/ /*---------------------------------------------*/ ret false;
	}
}
DECREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER(){
	switch(eventType){
		to NONE_BASE_EVENT_TYPE: /*-----------------*/ /*---------------------------------------------*/ ret false;
		to MAGIC_NUMBER_CHANGED_BASE_EVENT_TYPE: /*-*/ dec database.clientWantingMagicNumberEventAmount; ret true;
		off: /*-------------------------------------*/ /*---------------------------------------------*/ ret false;
	}
}
#ifdef a
INCREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER(){
	if(eventMask & MAGIC_NUMBER_CHANGED_BASE_EVENT_TYPE){
		inc database.clientWantingMagicNumberEventAmount;
	}
	ret true;
}
DECREMENTSERVEREXTENSIONDESCRIPTOREVENTCOUNTER(){
	if(eventMask & MAGIC_NUMBER_CHANGED_BASE_EVENT_TYPE){
		dec database.clientWantingMagicNumberEventAmount;
	}
	ret true;
}
#endif



bool notifyServerForEvent(const int fd){
	const uint64 value = 1;
	write(fd, &value, sizeof(value));
	ret true;
}



PARSESERVEREXTENSIONDESCRIPTORREQUEST(){
	uint8 requestType;
	if(!request or !statusReturn or !payloadSizeReturn){
		ret false;
	}
	requestType = (*request).requestType;
	switch(requestType){
		to NONE_BASE_REQUEST_TYPE:{
			ret false;
		}
		to GET_MAGIC_NUMBER_BASE_REQUEST_TYPE:{
			if(itemAmount == GET_MAGIC_NUMBER_BASE_REQUEST_ITEM_AMOUNT){
				*statusReturn |= SUCCESS_REPLY_STATUS;
				*payloadSizeReturn = 1 * sizeof(uint32);
			}
			ret true;
		}
		to SET_MAGIC_NUMBER_BASE_REQUEST_TYPE:{
			if(itemAmount == SET_MAGIC_NUMBER_BASE_REQUEST_ITEM_AMOUNT){
				SetMagicNumberBaseRequest setMagicNumberBaseRequest;
				if(unpackRequest(request, SET_MAGIC_NUMBER_BASE_REQUEST_ITEM_AMOUNT, &setMagicNumberBaseRequest)){
					const uint32 magicNumber = *(uint32 *)setMagicNumberBaseRequest.magicNumberStart;
					if(database.clientWantingMagicNumberEventAmount and magicNumber != database.magicNumber){
						notifyServerForEvent(database.fd);
						*statusReturn |= UPDATED_REPLY_STATUS;
					}
					database.magicNumber = magicNumber;
					*statusReturn |= SUCCESS_REPLY_STATUS;
				}
			}
			ret true;
		}
		off:{
			ret false;
		}
	}
}
PARSESERVEREXTENSIONDESCRIPTORREPLY(){
	if(!replyReturn){
		ret false;
	}
	switch(replyType){
		to NONE_BASE_REPLY_TYPE:{
			ret false;
		}
		to GET_MAGIC_NUMBER_BASE_REPLY_TYPE:{
			(*(GetMagicNumberBaseReply *)replyReturn).magicNumber = database.magicNumber;
			ret true;
		}
		to SET_MAGIC_NUMBER_BASE_REPLY_TYPE:{
			ret true;
		}
		off:{
			ret false;
		}
	}
}
PARSESERVEREXTENSIONDESCRIPTOREVENT(){



	/*!*/



	ret true;
}
FINISERVEREXTENSIONDESCRIPTORSYSTEM(){
	database.magicNumber = 0;
	database.clientWantingMagicNumberEventAmount = 0;
	database.fd = 0;
	ret true;
}


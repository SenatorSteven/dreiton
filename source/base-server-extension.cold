#include <stdint.h>

#include "headers/cold/cold.hold"
#include "headers/server-api.hold"
#include "headers/base-server-extension.hold"

#define INITSERVEREXTENSIONDESCRIPTORSYSTEM() /*-*/ bool  initServerExtensionDescriptorSystem(void)
#define PARSEEXTENSIONREQUEST() /*---------------*/ bool  parseExtensionRequest(const GenericRequest *const request, const uint32 itemAmount, uint8 *const statusReturn)
#define PARSEEXTENSIONREPLY() /*-----------------*/ bool  parseExtensionReply(const uint8 replyType, GenericReply *const replyReturn)
#define FINISERVEREXTENSIONDESCRIPTORSYSTEM() /*-*/ bool  finiServerExtensionDescriptorSystem(void)

def struct{
	uint32 /*-*/ magicNumber;
} Database;

INITSERVEREXTENSIONDESCRIPTORSYSTEM();
PARSEEXTENSIONREQUEST();
PARSEEXTENSIONREPLY();
FINISERVEREXTENSIONDESCRIPTORSYSTEM();

local Database /*------------*/ database;

ServerExtensionDescriptor /*-*/ serverExtensionDescriptor = {
	  sizeof(ServerExtensionDescriptor)
	, BASE_PROTOCOL_VERSION
	, BASE_EXTENSION_VERSION
	, lengthof(BASE_EXTENSION_NAME)
	, BASE_EXTENSION_NAME
	, &initServerExtensionDescriptorSystem
	, &parseExtensionRequest
	, &parseExtensionReply
	, &finiServerExtensionDescriptorSystem
};

INITSERVEREXTENSIONDESCRIPTORSYSTEM(){
	database.magicNumber = 0;
	ret true;
}
PARSEEXTENSIONREQUEST(){
	uint8 requestType;
	if(!request or !statusReturn){
		ret false;
	}
	requestType = (*request).requestType;
	switch(requestType){
		to NONE_BASE_REQUEST_TYPE:{
			ret false;
		}
		to GET_MAGIC_NUMBER_BASE_REQUEST_TYPE:{
			if(!itemAmount){
				*statusReturn |= SUCCESS_REPLY_STATUS;
			}
			ret true;
		}
		to SET_MAGIC_NUMBER_BASE_REQUEST_TYPE:{
			if(itemAmount == 1){



				/*! use a function? */

				const uint8 *const payloadStart = (uint8 *)request + (*request).payloadStartOffset;
				uint32 magicNumber = *(uint32 *)(payloadStart + 2 * sizeof(uint32));



				database.magicNumber = magicNumber;
				*statusReturn |= SUCCESS_REPLY_STATUS;
			}
			ret true;
		}
		off:{
			ret false;
		}
	}
}
PARSEEXTENSIONREPLY(){
	if(!replyReturn){
		ret false;
	}
	switch(replyType){
		to NONE_BASE_REPLY_TYPE:{
			ret false;
		}
		to GET_MAGIC_NUMBER_BASE_REPLY_TYPE:{
			(*(GetMagicNumberBaseReply *)replyReturn).replySize = sizeof(GetMagicNumberBaseReply);
			(*(GetMagicNumberBaseReply *)replyReturn).magicNumber = database.magicNumber;
			ret true;
		}
		to SET_MAGIC_NUMBER_BASE_REPLY_TYPE:{
			(*(SetMagicNumberBaseReply *)replyReturn).replySize = sizeof(SetMagicNumberBaseReply);
			ret true;
		}
		off:{
			ret false;
		}
	}
}
FINISERVEREXTENSIONDESCRIPTORSYSTEM(){
	database.magicNumber = 0;
	ret true;
}


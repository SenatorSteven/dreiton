WAKEUPDREITONCLIENTTRANSPORTDESCRIPTORREPLY(){
	int fd;
	struct epoll_event event;
	uint64 value;
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if((*(ClientBackend *)backend).eventEpollFd == NONE_FD){
		jmp emergencyExit;
	}
	fd = (*(ClientBackend *)backend).signalReplyFd;
	if(fd == NONE_FD){
		fd = eventfd(0, EFD_NONBLOCK); /*! errors? */
		if(fd == EVENTFD_FAILURE){
			jmp emergencyExit;
		}
		(*(ClientBackend *)backend).signalReplyFd = fd;
	}
	event.events = EPOLLIN;
	event.data.fd = fd;
	value = status;
	if(epoll_ctl((*(ClientBackend *)backend).replyEpollFd, EPOLL_CTL_ADD, fd, &event) == EPOLL_CTL_FAILURE){ /*! errors? */
		jmp emergencyExit;
	}
	write(fd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

	}
	jmp eventLoop;
	eventLoop:{
		struct epoll_event event[1];
		int fd;
		if(epoll_wait((*(ClientBackend *)backend).eventEpollFd, event, countof(event), INFINITE_EPOLL_WAIT_TIMEOUT) == EPOLL_WAIT_FAILURE){ /*! errors? */
			*statusReturn = FAILURE_DREITON_TRANSPORT_STATUS;
			jmp emergencyExit;
		}
		if((*event).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){

SENDDREITONSERVERTRANSPORTDESCRIPTORREPLY(){
	Client *client;
	uint8 *replyStart;
	Header *header;
	MessageSlot *slot;
	bool success;
	if(!backend){
		ret false;
	}
	client = (*(ServerBackend *)backend).clientStart + clientId;
	success = false;
	if(!isValidDreitonTransportClient(backend, client) or !frameSize){
		jmp emergencyExit;
	}
	replyStart = (*client).replyStart;
	if((uint8 *)frame < replyStart or (uint8 *)frame >= replyStart + (*(ServerBackend *)backend).replySize){
		jmp emergencyExit;
	}
	header = (*client).shmStart;
	slot = (*client).replySlotStart + (*header).replyCurrentWriter;
	(*slot).messageStartOffset = (uint8 *)frame - replyStart;
	(*client).replyCurrent = (uint8 *)frame + frameSize;
	{
		const uint64 message = ((uint64)clientId << 32) | (*header).replyCurrentWriter;
		write((*client).replyFd, &message, sizeof(message)); /*! errors? */
	}
	(*header).replyCurrentWriter = ((*header).replyCurrentWriter + 1) % (*header).replySlotSize;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

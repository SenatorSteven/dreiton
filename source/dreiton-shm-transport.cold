		jmp emergencyExit;
	}



	/*! we do not know if there is space to put this at the start of the pool. keep track of that. */

	replyCurrent = (*client).replyCurrent;
	{
		uint8 *const replyStart = (*client).replyStart;
		if(replyCurrent + frameSize > replyStart + (*client).replySize){
			replyCurrent = replyStart;
		}
	}



	*frameReturn = replyCurrent;

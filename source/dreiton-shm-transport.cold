		jmp emergencyExit;
	}
	{
		const int flag = fcntl(eventPipe.readFd, F_GETFL, 0); /*! errors? */
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		if(fcntl(eventPipe.readFd, F_SETFL, flag | O_NONBLOCK) == FCNTL_FAILURE){ /*! errors? */
			jmp emergencyExit;
		}
	}
	{
		struct epoll_event event;
		event.events = EPOLLIN;
		event.data.fd = eventPipe.readFd;
		if(epoll_ctl(eventEpollFd, EPOLL_CTL_ADD, eventPipe.readFd, &event) == EPOLL_CTL_FAILURE){

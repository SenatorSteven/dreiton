DISCONNECTFROMDREITONCLIENTTRANSPORTDESCRIPTORCONNECTION(){
	struct epoll_event epollEventStart[1];
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if(notifyServer){
		const uint64 message = ((uint64)(*(ClientBackend *)backend).id << 32) | 0;
		write((*(ClientBackend *)backend).requestFd, &message, sizeof(message)); /*! errors? */
		epoll_wait((*(ClientBackend *)backend).replyEpollFd, epollEventStart, countof(epollEventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
	}
	if((*(ClientBackend *)backend).signalEventFd != NONE_FD){
		close((*(ClientBackend *)backend).signalEventFd); /*! errors? */
	}
	if((*(ClientBackend *)backend).signalReplyFd != NONE_FD){
		close((*(ClientBackend *)backend).signalReplyFd); /*! errors? */
	}
	close((*(ClientBackend *)backend).eventEpollFd); /*! errors? */
	close((*(ClientBackend *)backend).replyEpollFd); /*! errors? */
	close((*(ClientBackend *)backend).eventFd); /*! errors? */
	close((*(ClientBackend *)backend).replyFd); /*! errors? */
	close((*(ClientBackend *)backend).requestFd); /*! errors? */
	shmdt((*(ClientBackend *)backend).shmStart); /*! errors? */
	(*(ClientBackend *)backend).shmStart = NULL;
	(*(ClientBackend *)backend).requestSlotStart = NULL;
	(*(ClientBackend *)backend).replySlotStart = NULL;
	(*(ClientBackend *)backend).eventSlotStart = NULL;
	(*(ClientBackend *)backend).requestStart = NULL;
	(*(ClientBackend *)backend).replyStart = NULL;
	(*(ClientBackend *)backend).eventStart = NULL;
	(*(ClientBackend *)backend).requestCurrent = NULL;
	(*(ClientBackend *)backend).replyCurrent = NULL;
	(*(ClientBackend *)backend).eventCurrent = NULL;
	(*(ClientBackend *)backend).requestSlotSize = 0;
	(*(ClientBackend *)backend).replySlotSize = 0;
	(*(ClientBackend *)backend).eventSlotSize = 0;
	(*(ClientBackend *)backend).requestSize = 0;
	(*(ClientBackend *)backend).replySize = 0;
	(*(ClientBackend *)backend).eventSize = 0;
	(*(ClientBackend *)backend).shmId = 0;
	(*(ClientBackend *)backend).requestFd = NONE_FD;
	(*(ClientBackend *)backend).replyFd = NONE_FD;
	(*(ClientBackend *)backend).eventFd = NONE_FD;
	(*(ClientBackend *)backend).replyEpollFd = NONE_FD;
	(*(ClientBackend *)backend).eventEpollFd = NONE_FD;
	(*(ClientBackend *)backend).signalReplyFd = NONE_FD;
	(*(ClientBackend *)backend).signalEventFd = NONE_FD;
	(*(ClientBackend *)backend).id = 0;
	(*(ClientBackend *)backend).requestAmount = 0;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
FINIDREITONCLIENTTRANSPORTDESCRIPTORCONNECTION(){
	if(!backend){
		ret false;
	}
	if((*(ClientBackend *)backend).shmStart){
		if(!disconnectFromDreitonClientTransportDescriptorConnection(backend, false)){
			ret false;
		}
	}
	free(backend);
	ret true;
}


DESTROYALLDREITONTRANSPORTCLIENTS(){
	Client *current;
	Client *wall;
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if(!(*backend).clientStart){
		jmp emergencyExit;
	}
	current = (*backend).clientStart + 1;
	wall = (*backend).clientStart + (*backend).clientAllocated;
	jmp destroyClientLoop;
	destroyClientLoop:{
		if(current < wall){
			if((*current).id){
				destroyDreitonTransportClient(backend, current);
			}
			inc current;
			jmp destroyClientLoop;
		}
		free((*backend).clientStart);
		(*backend).clientStart = NULL;
		(*backend).clientSize = 0;
		(*backend).clientAllocated = 0;
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
ISVALIDDREITONTRANSPORTCLIENT(){
	if(!backend){
		ret false;
	}
	if(client <= (*backend).clientStart or client >= (*backend).clientStart + (*backend).clientAllocated or !(*client).id){
		ret false;
	}
	ret true;
}
FINIDREITONSERVERTRANSPORTDESCRIPTOR(){
	if(!backend){
		ret false;
	}
	if((*(ServerBackend *)backend).registrationEpollFd != NONE_FD){
		if(!destroyDreitonServerTransportDescriptorRegistrationReceiver(backend)){
			ret false;
		}
	}
	if((*(ServerBackend *)backend).requestEpollFd != NONE_FD){
		if(!destroyDreitonServerTransportDescriptorRequestReceiver(backend)){
			ret false;
		}
	}
	if((*(ServerBackend *)backend).eventEpollFd != NONE_FD){
		if(!destroyDreitonServerTransportDescriptorEventReceiver(backend)){
			ret false;
		}
	}
	if((*(ServerBackend *)backend).signalRegistrationFd != NONE_FD){
		close((*(ServerBackend *)backend).signalRegistrationFd);
		(*(ServerBackend *)backend).signalRegistrationFd = NONE_FD;
	}
	if((*(ServerBackend *)backend).signalRequestFd != NONE_FD){
		close((*(ServerBackend *)backend).signalRequestFd);
		(*(ServerBackend *)backend).signalRequestFd = NONE_FD;
	}
	if((*(ServerBackend *)backend).signalEventFd != NONE_FD){
		close((*(ServerBackend *)backend).signalEventFd);
		(*(ServerBackend *)backend).signalEventFd = NONE_FD;
	}
	destroyAllDreitonTransportClients(backend);
	free((*(ServerBackend *)backend).handshakeDataStart);
	free(backend);
	ret true;
}



























INITDREITONCLIENTTRANSPORTDESCRIPTORCONNECTION(){
	ClientBackend *backend;
	if(!backendReturn){
		ret false;
	}
	backend = malloc(1 * sizeof(ClientBackend));
	if(!backend){
		ret false;
	}
	(*backend).shmStart = NULL;
	(*backend).requestSlotStart = NULL;
	(*backend).replySlotStart = NULL;
	(*backend).eventSlotStart = NULL;
	(*backend).requestStart = NULL;
	(*backend).replyStart = NULL;
	(*backend).eventStart = NULL;
	(*backend).requestCurrent = NULL;
	(*backend).replyCurrent = NULL;
	(*backend).eventCurrent = NULL;
	(*backend).requestSlotSize = 0;
	(*backend).replySlotSize = 0;
	(*backend).eventSlotSize = 0;
	(*backend).requestSize = 0;
	(*backend).replySize = 0;
	(*backend).eventSize = 0;
	(*backend).shmId = 0;
	(*backend).requestFd = NONE_FD;
	(*backend).replyFd = NONE_FD;
	(*backend).eventFd = NONE_FD;
	(*backend).replyEpollFd = NONE_FD;
	(*backend).eventEpollFd = NONE_FD;
	(*backend).signalReplyFd = NONE_FD;
	(*backend).signalEventFd = NONE_FD;
	(*backend).id = 0;
	(*backend).requestAmount = 0;
	*backendReturn = backend;
	ret true;
}
CONNECTTODREITONCLIENTTRANSPORTDESCRIPTORCONNECTION(){
	int clientFd;
	struct sockaddr_un address;
	int replyEpollFd;
	int eventEpollFd;
	int requestWriteFd;
	int replyReadFd;
	int eventReadFd;
	struct epoll_event event;
	int shmId;
	Header *shmStart;
	bool success;
	if(!backend){
		ret false;
	}
	clientFd = NONE_FD;
	replyEpollFd = NONE_FD;
	eventEpollFd = NONE_FD;
	requestWriteFd = NONE_FD;
	replyReadFd = NONE_FD;
	eventReadFd = NONE_FD;
	success = false;
	if(!name or !greetingSize or !greetingData or !handshakeDataReturn){
		jmp emergencyExit;
	}
	clientFd = socket(AF_UNIX, SOCK_STREAM, NONE_SOCKET_PROTOCOL);
	if(clientFd == SOCKET_FAILURE){
		jmp emergencyExit;
	}
	address.sun_family = AF_UNIX;
	strcpy(address.sun_path, name); /*! replace with toolkit function */
	if(connect(clientFd, (void *)&address, sizeof(address)) == CONNECT_FAILURE){
		jmp emergencyExit;
	}
	if(send(clientFd, greetingData, greetingSize, NONE_SEND_FLAG) == SEND_FAILURE){ /*! errors? client might not send, how to mitigate? */
		jmp emergencyExit;
	}
	if(recv(clientFd, handshakeDataReturn, handshakeSize, NONE_RECV_FLAG) == RECV_FAILURE){ /*! this fails? what do? */
		jmp emergencyExit;
	}
	replyEpollFd = epoll_create1(NONE_EPOLL_FLAG); /*! check for surprise errors */
	if(replyEpollFd == EPOLL_CREATE1_FAILURE){
		replyEpollFd = NONE_FD;
		jmp emergencyExit;
	}
	eventEpollFd = epoll_create1(NONE_EPOLL_FLAG); /*! check for surprise errors */
	if(eventEpollFd == EPOLL_CREATE1_FAILURE){
		eventEpollFd = NONE_FD;
		jmp emergencyExit;
	}
	{
		int fd[3];
		if(!receiveFd(clientFd, countof(fd), fd)){ /*! this fails? what do? */
			jmp emergencyExit;
		}
		requestWriteFd = *(fd + 0);
		replyReadFd = *(fd + 1);
		eventReadFd = *(fd + 2);
	}
	{
		const int flag = fcntl(replyReadFd, F_GETFL, 0); /*! errors? */
		int returnValue;
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		returnValue = fcntl(replyReadFd, F_SETFL, flag | O_NONBLOCK); /*! errors? */
		if(returnValue == FCNTL_FAILURE){
			jmp emergencyExit;
		}
	}
	{
		const int flag = fcntl(eventReadFd, F_GETFL, 0); /*! errors? */
		int returnValue;
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		returnValue = fcntl(eventReadFd, F_SETFL, flag | O_NONBLOCK); /*! errors? */
		if(returnValue == FCNTL_FAILURE){
			jmp emergencyExit;
		}
	}
	event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
	event.data.fd = replyReadFd;
	if(epoll_ctl(replyEpollFd, EPOLL_CTL_ADD, replyReadFd, &event) == EPOLL_CTL_FAILURE){
		jmp emergencyExit;
	}
	event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
	event.data.fd = eventReadFd;
	if(epoll_ctl(eventEpollFd, EPOLL_CTL_ADD, eventReadFd, &event) == EPOLL_CTL_FAILURE){
		jmp emergencyExit;
	}
	if(recv(clientFd, &shmId, sizeof(shmId), 0) == RECV_FAILURE){ /*! this fails? what do? */
		jmp emergencyExit;
	}
	if(!shmId){
		jmp emergencyExit;
	}
	shmStart = shmat(shmId, NULL, SHM_NONE);
	if(shmStart == SHMAT_FAILURE){
		jmp emergencyExit;
	}
	(*(ClientBackend *)backend).shmStart = shmStart;
	(*(ClientBackend *)backend).shmId = shmId;
	(*(ClientBackend *)backend).requestSlotStart = (void *)((uint8 *)shmStart + (*shmStart).requestSlotStartOffset);
	(*(ClientBackend *)backend).replySlotStart = (void *)((uint8 *)shmStart + (*shmStart).replySlotStartOffset);
	(*(ClientBackend *)backend).eventSlotStart = (void *)((uint8 *)shmStart + (*shmStart).eventSlotStartOffset);
	(*(ClientBackend *)backend).requestStart = (void *)((uint8 *)shmStart + (*shmStart).requestStartOffset);
	(*(ClientBackend *)backend).replyStart = (void *)((uint8 *)shmStart + (*shmStart).replyStartOffset);
	(*(ClientBackend *)backend).eventStart = (void *)((uint8 *)shmStart + (*shmStart).eventStartOffset);
	(*(ClientBackend *)backend).requestCurrent = (*(ClientBackend *)backend).requestStart;
	(*(ClientBackend *)backend).replyCurrent = (*(ClientBackend *)backend).replyStart;
	(*(ClientBackend *)backend).eventCurrent = (*(ClientBackend *)backend).eventStart;
	(*(ClientBackend *)backend).requestSlotSize = (*shmStart).requestSlotSize;
	(*(ClientBackend *)backend).replySlotSize = (*shmStart).replySlotSize;
	(*(ClientBackend *)backend).eventSlotSize = (*shmStart).eventSlotSize;
	(*(ClientBackend *)backend).requestSize = (*shmStart).requestSize;
	(*(ClientBackend *)backend).replySize = (*shmStart).replySize;
	(*(ClientBackend *)backend).eventSize = (*shmStart).eventSize;
	(*(ClientBackend *)backend).requestFd = requestWriteFd;
	(*(ClientBackend *)backend).replyFd = replyReadFd;
	(*(ClientBackend *)backend).eventFd = eventReadFd;
	(*(ClientBackend *)backend).replyEpollFd = replyEpollFd;
	(*(ClientBackend *)backend).eventEpollFd = eventEpollFd;
	(*(ClientBackend *)backend).id = (*shmStart).clientId;
	(*(ClientBackend *)backend).requestAmount = 0;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(clientFd != NONE_FD){
			close(clientFd); /*! errors? */
		}
		if(!success){
			if(eventEpollFd != NONE_FD) /*---*/ close(eventEpollFd); /*! on signal interrupt? */
			if(replyEpollFd != NONE_FD) /*---*/ close(replyEpollFd); /*! on signal interrupt? */
			if(eventReadFd != NONE_FD) /*----*/ close(eventReadFd); /*! on signal interrupt? */
			if(replyReadFd != NONE_FD) /*----*/ close(replyReadFd); /*! on signal interrupt? */
			if(requestWriteFd != NONE_FD) /*-*/ close(requestWriteFd); /*! on signal interrupt? */
			ret false;
		}
		ret true;
	}
}



























GETDREITONCLIENTTRANSPORTDESCRIPTORREQUESTFRAME(){



	/*!
		but... surely we have to wait until a slot is open to write a request if we just flushed, right?

		this is gonna be a rough issue to deal with. you should with epoll but... what do you do with the reply? copy to local buffer?

		the requestCurrent pointer is now also in the mix.

		maybe store to local buffer and put on the channel once there is space, because the client's current is less than the server's current.
	*/



	uint8 *requestCurrent;
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if(!frameSize or !requestFrameReturn){
		jmp emergencyExit;
	}
	if(frameSize > (*(ClientBackend *)backend).requestSize){
		jmp emergencyExit;
	}



	/*! we do not know if there is space to put this at the start of the pool. keep track of that. */

	requestCurrent = (*(ClientBackend *)backend).requestCurrent;
	{
		uint8 *const requestStart = (*(ClientBackend *)backend).requestStart;
		if(requestCurrent + frameSize > requestStart + (*(ClientBackend *)backend).requestSize){
			requestCurrent = requestStart;
		}
	}



	/*! if the amount is full and you flush then we still have no space for writing the request */

	if((*(ClientBackend *)backend).requestAmount == (*(ClientBackend *)backend).requestSlotSize){
		if(!flushDreitonClientTransportDescriptorRequestBuffer(backend)){
			if((*(ClientBackend *)backend).requestAmount){
				jmp emergencyExit;
			}
		}
	}
	*requestFrameReturn = requestCurrent;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
SENDDREITONCLIENTTRANSPORTDESCRIPTORREQUEST(){
	Header *header;
	uint8 *requestStart;
	MessageSlot *slot;
	bool success;
	if(!backend){
		ret false;
	}
	header = (*(ClientBackend *)backend).shmStart;
	requestStart = (*(ClientBackend *)backend).requestStart;
	success = false;
	if(!header or !requestFrameSize or (uint8 *)requestFrame < requestStart or (uint8 *)requestFrame >= requestStart + (*(ClientBackend *)backend).requestSize){
		jmp emergencyExit;
	}
	slot = (*(ClientBackend *)backend).requestSlotStart + (*header).requestCurrentWriter;
	(*slot).messageStartOffset = (uint8 *)requestFrame - requestStart;
	(*(ClientBackend *)backend).requestCurrent = (uint8 *)requestFrame + requestFrameSize;
	(*header).requestCurrentWriter = ((*header).requestCurrentWriter + 1) % (*header).requestSlotSize;
	inc (*(ClientBackend *)backend).requestAmount;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
FLUSHDREITONCLIENTTRANSPORTDESCRIPTORREQUESTBUFFER(){
	uint64 message;
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if((*(ClientBackend *)backend).requestFd == NONE_FD or !(*(ClientBackend *)backend).requestAmount){
		jmp emergencyExit;
	}
	message = ((uint64)(*(ClientBackend *)backend).id << 32) | (*(ClientBackend *)backend).requestAmount; /*! add generation? */
	write((*(ClientBackend *)backend).requestFd, &message, sizeof(message)); /*! errors? */
	(*(ClientBackend *)backend).requestAmount = 0;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}



























WAITFORDREITONCLIENTTRANSPORTDESCRIPTORREPLY(){
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if((*(ClientBackend *)backend).replyEpollFd == NONE_FD or !frameReturn or !statusReturn){
		jmp emergencyExit;
	}
	jmp replyLoop;
	replyLoop:{
		struct epoll_event event[1];
		int fd;
		if(epoll_wait((*(ClientBackend *)backend).replyEpollFd, event, countof(event), INFINITE_EPOLL_WAIT_TIMEOUT) == EPOLL_WAIT_FAILURE){ /*! errors? */
			*statusReturn = FAILURE_DREITON_TRANSPORT_STATUS;
			jmp emergencyExit;
		}
		if((*event).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
			*statusReturn = NONE_DREITON_TRANSPORT_STATUS;
			if((*event).events & (EPOLLRDHUP | EPOLLHUP)){
				*statusReturn |= HANG_UP_DREITON_TRANSPORT_STATUS;
			}
			if((*event).events & EPOLLERR){
				*statusReturn |= ERROR_DREITON_TRANSPORT_STATUS;
			}
			jmp emergencyExit;
		}
		if(!((*event).events & EPOLLIN)){
			jmp replyLoop;
		}
		fd = (*event).data.fd;
		jmp readReplyLoop;
		readReplyLoop:{
			uint64 message;
			int returnValue = read(fd, &message, sizeof(message));
			if(returnValue > 0){
				uint32 replyCurrentReader;
				if(fd == (*(ClientBackend *)backend).signalReplyFd){
					*statusReturn = message;
					jmp emergencyExit;
				}
				replyCurrentReader = message;



				/*! return the frame size */
				*frameSizeReturn = 0;



				*frameReturn = (uint8 *)(*(ClientBackend *)backend).replyStart + (*((*(ClientBackend *)backend).replySlotStart + replyCurrentReader)).messageStartOffset;
				*statusReturn = SUCCESS_DREITON_TRANSPORT_STATUS;
				success = true;
				jmp emergencyExit;
			}
			if(returnValue == READ_FAILURE){
				if(errno == EINTR){
					jmp readReplyLoop;
				}
			}
			jmp replyLoop;
		}
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
CONSUMEDREITONCLIENTTRANSPORTDESCRIPTORREPLY(){



	/*! support consuming more than one, since the replies will not be in order. */

	/*! how is this supposed to work with the params? */



	Header *header;
	bool success;
	if(!backend){
		ret false;
	}
	success = false;



	/*!*/

	(void)reply;



	header = (*(ClientBackend *)backend).shmStart;
	(*header).replyCurrentReader = ((*header).replyCurrentReader + 1) % (*header).replySlotSize;



	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

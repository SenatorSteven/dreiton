DESTROYDREITONTRANSPORTCLIENT(){
	if(!backend){
		ret false;
	}
	if(!isValidDreitonTransportClient(backend, client)){
		ret false;
	}
	free((*client).handshakeDataStart);
	shmctl((*client).shmId, IPC_RMID, NULL); /*! errors? */
	shmdt((*client).shmStart); /*! errors? */
	close((*client).eventFd); /*! errors? */
	close((*client).replyFd); /*! errors? */
	close((*client).requestFd); /*! errors? */
	(*client).id = 0;
	ret true;
}
WAKEUPDREITONSERVERTRANSPORTDESCRIPTORREGISTRATION(){
	int fd;
	struct epoll_event event;
	uint64 value;
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if((*(ServerBackend *)backend).registrationEpollFd == NONE_FD){
		jmp emergencyExit;
	}
	fd = (*(ServerBackend *)backend).signalRegistrationFd;
	if(fd == NONE_FD){
		fd = eventfd(0, EFD_NONBLOCK); /*! errors? */
		if(fd == EVENTFD_FAILURE){
			jmp emergencyExit;
		}
		(*(ServerBackend *)backend).signalRegistrationFd = fd;
	}
	event.events = EPOLLIN;
	event.data.fd = fd;
	value = 1;
	if(epoll_ctl((*(ServerBackend *)backend).registrationEpollFd, EPOLL_CTL_ADD, fd, &event) == EPOLL_CTL_FAILURE){ /*! errors? */
		jmp emergencyExit;
	}
	write(fd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

	emergencyExit:{
		if(!success){
			if(eventPipe.writeFd != NONE_FD) /*-*/ close(eventPipe.writeFd);
			if(eventPipe.readFd != NONE_FD) /*--*/ close(eventPipe.readFd);
			if(eventEpollFd != NONE_FD) /*------*/ close(eventEpollFd);

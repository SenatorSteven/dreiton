CREATEDREITONSERVERTRANSPORTDESCRIPTORREQUESTRECEIVER(){
	int requestEpollFd;
	bool success;
	struct{
		int32 /*-*/ readFd;
		int32 /*-*/ writeFd;
	} requestPipe;
	if(!backend){
		ret false;
	}
	requestEpollFd = NONE_FD;
	requestPipe.readFd = NONE_FD;
	requestPipe.writeFd = NONE_FD;
	success = false;
	if((*(ServerBackend *)backend).requestEpollFd != NONE_FD){
		jmp emergencyExit;
	}
	requestEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(requestEpollFd == EPOLL_CREATE1_FAILURE){
		jmp emergencyExit;
	}
	if(pipe((void *)&requestPipe) == PIPE_FAILURE){ /*! check for surprise errors */
		jmp emergencyExit;
	}
	{
		const int flag = fcntl(requestPipe.readFd, F_GETFL, 0); /*! errors? */
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		if(fcntl(requestPipe.readFd, F_SETFL, flag | O_NONBLOCK) == FCNTL_FAILURE){ /*! errors? */
			jmp emergencyExit;
		}
	}
	{
		struct epoll_event event;
		event.events = EPOLLIN;
		event.data.fd = requestPipe.readFd;
		if(epoll_ctl(requestEpollFd, EPOLL_CTL_ADD, requestPipe.readFd, &event) == EPOLL_CTL_FAILURE){
			jmp emergencyExit;
		}
	}
	(*(ServerBackend *)backend).requestEpollFd = requestEpollFd;
	(*(ServerBackend *)backend).requestReadFd = requestPipe.readFd;
	(*(ServerBackend *)backend).requestWriteFd = requestPipe.writeFd;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			if(requestPipe.writeFd != NONE_FD) /*-*/ close(requestPipe.writeFd);
			if(requestPipe.readFd != NONE_FD) /*--*/ close(requestPipe.readFd);
			if(requestEpollFd != NONE_FD) /*------*/ close(requestEpollFd);
			ret false;
		}
		ret true;
	}
}
CREATEDREITONSERVERTRANSPORTDESCRIPTOREVENTRECEIVER(){
	int eventEpollFd;
	bool success;
	struct{
		int32 /*-*/ readFd;
		int32 /*-*/ writeFd;
	} eventPipe;
	if(!backend){

/*!*/

#define SENDFD() /*----*/ local bool  sendFd(const int socket, const int *const fd, const uint fdSize)
#define RECEIVEFD() /*-*/ local bool  receiveFd(const int socket, const uint fdSize, int *const fdReturn)

SENDFD(){
	uint controlMessageBufferSize;
	char *controlMessageBuffer;
	char mandatoryPayloadByte;
	struct iovec payload;
	struct msghdr messageHeader = {0};
	struct cmsghdr *controlMessageHeader;
	if(socket == NONE_FD or !fd or !fdSize){
		ret false;
	}
	controlMessageBufferSize = CMSG_SPACE(fdSize * sizeof(int));
	if(!(controlMessageBuffer = malloc(controlMessageBufferSize))){
		ret false;
	}
	memset(controlMessageBuffer, 0, controlMessageBufferSize * sizeof(uint8));
	mandatoryPayloadByte = 1;
	payload.iov_base = &mandatoryPayloadByte;
	payload.iov_len = 1;
	messageHeader.msg_iov = &payload;
	messageHeader.msg_iovlen = 1;
	messageHeader.msg_control = controlMessageBuffer;
	messageHeader.msg_controllen = controlMessageBufferSize;
	controlMessageHeader = CMSG_FIRSTHDR(&messageHeader);
	(*controlMessageHeader).cmsg_level = SOL_SOCKET;
	(*controlMessageHeader).cmsg_type = SCM_RIGHTS;
	(*controlMessageHeader).cmsg_len = CMSG_LEN(fdSize * sizeof(int));
	memcpy(CMSG_DATA(controlMessageHeader), fd, fdSize * sizeof(int)); /*! replace with toolkit function */
	if(sendmsg(socket, &messageHeader, 0) == SENDMSG_FAILURE){
		free(controlMessageBuffer);
		ret false;
	}
	free(controlMessageBuffer);
	ret true;
}
RECEIVEFD(){
	uint controlMessageBufferSize;
	char *controlMessageBuffer;
	char mandatoryPayloadByte;
	struct iovec payload;
	struct msghdr messageHeader = {0};
	struct cmsghdr *controlMessageHeader;
	if(socket == NONE_FD or !fdSize or !fdReturn){
		ret false;
	}
	controlMessageBufferSize = CMSG_SPACE(fdSize * sizeof(int));
	if(!(controlMessageBuffer = malloc(controlMessageBufferSize))){
		ret false;
	}
	payload.iov_base = &mandatoryPayloadByte;
	payload.iov_len = 1;
	messageHeader.msg_iov = &payload;
	messageHeader.msg_iovlen = 1;
	messageHeader.msg_control = controlMessageBuffer;
	messageHeader.msg_controllen = controlMessageBufferSize;
	if(recvmsg(socket, &messageHeader, 0) == RECVMSG_FAILURE){
		free(controlMessageBuffer);
		ret false;
	}
	if(!messageHeader.msg_controllen){
		free(controlMessageBuffer);
		ret false;
	}
	controlMessageHeader = CMSG_FIRSTHDR(&messageHeader);
	if(!controlMessageHeader or (*controlMessageHeader).cmsg_level != SOL_SOCKET or (*controlMessageHeader).cmsg_type != SCM_RIGHTS){
		free(controlMessageBuffer);
		ret false;
	}
	memcpy(fdReturn, CMSG_DATA(controlMessageHeader), fdSize * sizeof(int)); /*! replace with toolkit function */
	free(controlMessageBuffer);
	ret true;
}



























/*!*/

#define FINDCLIENTFD() /*--------*/ Client * findClientFd(ServerBackend *const backend, const int fd)
#define REMOVEDREITONCLIENT() /*-*/ bool     removeDreitonClient(ServerBackend *const backend)
#define SENDSERVEREVENT() /*-----*/ bool     sendServerEvent(void *const backend, const uint32 extension, const uint32 eventType)

FINDCLIENTFD();
REMOVEDREITONCLIENT();
SENDSERVEREVENT();

FINDCLIENTFD(){
	Client *current;
	Client *wall;
	if(!backend){
		ret NULL;
	}
	if(!(*backend).clientAllocated or fd == NONE_FD){
		ret NULL;
	}
	current = (*backend).clientStart + 1;
	wall = current + (*backend).clientAllocated;
	jmp findClientLoop;
	findClientLoop:{
		if(current < wall){
			if((*current).requestFd == fd and (*current).id){
				ret current;
			}
			inc current;
			jmp findClientLoop;
		}
		ret NULL;
	}
}
REMOVEDREITONCLIENT(){
	bool success;
	if(!backend){
		ret false;
	}
	success = false;



	/*!*/



	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
SENDSERVEREVENT(){
	uint64 message;
	bool success;
	if(!backend){
		ret false;
	}
	if(!extension and !eventType){
		jmp emergencyExit;
	}
	success = false;
	message = ((uint64)extension << 32) | eventType;
	write((*(ServerBackend *)backend).eventWriteFd, &message, sizeof(message)); /*! errors? */
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

/*!*/



























INITDREITONSERVERTRANSPORTDESCRIPTOR(){
	ServerBackend *backend;
	if(!backendReturn){
		ret false;
	}
	backend = malloc(1 * sizeof(ServerBackend));
	if(!backend){
		ret false;
	}
	(*backend).connectionName = NULL;
	(*backend).clientStart = NULL;
	(*backend).clientSize = 0;
	(*backend).clientAllocated = 0;
	(*backend).clientBlockSize = 0;
	(*backend).concurrentConnectionAmount = 0;
	(*backend).requestSlotSize = 0;
	(*backend).replySlotSize = 0;
	(*backend).eventSlotSize = 0;
	(*backend).requestSize = 0;
	(*backend).replySize = 0;
	(*backend).eventSize = 0;
	(*backend).registrationEpollFd = NONE_FD;
	(*backend).requestEpollFd = NONE_FD;
	(*backend).eventEpollFd = NONE_FD;
	(*backend).socketFd = NONE_FD;
	(*backend).shmKey = 0;
	(*backend).newClientFd = NONE_FD;
	(*backend).handshakeDataStart = NULL;
	(*backend).handshakeDataSize = 0;
	(*backend).requestReadFd = NONE_FD;
	(*backend).requestWriteFd = NONE_FD;
	(*backend).eventReadFd = NONE_FD;
	(*backend).eventWriteFd = NONE_FD;
	(*backend).signalRegistrationFd = NONE_FD;
	(*backend).signalRequestFd = NONE_FD;
	(*backend).signalEventFd = NONE_FD;
	*backendReturn = backend;
	ret true;
}

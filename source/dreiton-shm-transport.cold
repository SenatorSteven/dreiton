		}
		ret true;
	}
}
CREATEDREITONSERVERTRANSPORTDESCRIPTORREGISTRATIONRECEIVER(){
	int registrationEpollFd;
	int socketFd;
	struct sockaddr_un address;
	uint connectionNameSize;
	char *connectionNameStart;
	bool success;
	if(!backend){
		ret false;
	}
	registrationEpollFd = NONE_FD;
	socketFd = NONE_FD;
	success = false;
	if((*(ServerBackend *)backend).registrationEpollFd != NONE_FD or !name){
		jmp emergencyExit;
	}
	registrationEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(registrationEpollFd == EPOLL_CREATE1_FAILURE){
		jmp emergencyExit;
	}
	socketFd = socket(AF_UNIX, SOCK_STREAM, NONE_SOCKET_PROTOCOL);
	if(socketFd == SOCKET_FAILURE){
		jmp emergencyExit;
	}
	{
		const int flag = fcntl(socketFd, F_GETFL, 0); /*! errors? */
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		if(fcntl(socketFd, F_SETFL, flag | O_NONBLOCK) == FCNTL_FAILURE){ /*! errors? */
			jmp emergencyExit;
		}
	}
	{
		struct epoll_event event;
		event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
		event.data.fd = socketFd;
		if(epoll_ctl(registrationEpollFd, EPOLL_CTL_ADD, socketFd, &event) == EPOLL_CTL_FAILURE){
			jmp emergencyExit;
		}
	}
	address.sun_family = AF_UNIX;
	strcpy(address.sun_path, name); /*! replace with toolkit function */
	unlink(name);
	if(bind(socketFd, (void *)&address, sizeof(address)) == BIND_FAILURE){
		jmp emergencyExit;
	}
	if(listen(socketFd, (*(ServerBackend *)backend).concurrentConnectionAmount) == LISTEN_FAILURE){
		jmp emergencyExit;
	}
	connectionNameSize = strlen(name);
	connectionNameStart = malloc(connectionNameSize * sizeof(char));
	if(!connectionNameStart){
		jmp emergencyExit;
	}
	memcpy(connectionNameStart, name, connectionNameSize * sizeof(char));
	(*(ServerBackend *)backend).registrationEpollFd = registrationEpollFd;
	(*(ServerBackend *)backend).connectionName = connectionNameStart;
	(*(ServerBackend *)backend).socketFd = socketFd;
	(*(ServerBackend *)backend).shmKey = ftok(name, 0) >> 8; /*! writeFileToKey() function. */
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			if(socketFd != NONE_FD) /*------------*/ close(socketFd); /*! errors? */
			if(registrationEpollFd != NONE_FD) /*-*/ close(registrationEpollFd); /*! errors? */
			ret false;
		}
		ret true;
	}
}
WAITFORDREITONSERVERTRANSPORTDESCRIPTORREQUEST(){
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if((*(ServerBackend *)backend).requestEpollFd == NONE_FD or !transportRequestReturn){
		jmp emergencyExit;
	}
	jmp requestLoop;
	requestLoop:{
		struct epoll_event event[1];
		int fd;
		Client *client;
		if(epoll_wait((*(ServerBackend *)backend).requestEpollFd, event, countof(event), INFINITE_EPOLL_WAIT_TIMEOUT) == EPOLL_WAIT_FAILURE){ /*! errors? */
			jmp emergencyExit;
		}
		fd = (*event).data.fd;
		if((*event).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
			if((*event).events & EPOLLERR){
				/*! handle error */
			}
			client = findClientFd(backend, fd);
			jmp closeConnection;
		}
		if(!((*event).events & EPOLLIN)){
			jmp requestLoop;
		}
		jmp readRequestLoop;
		readRequestLoop:{
			uint64 message;
			int returnValue = read(fd, &message, sizeof(message));
			if(fd == (*(ServerBackend *)backend).signalRequestFd){
				jmp emergencyExit;
			}
			if(returnValue > 0){
				if(fd == (*(ServerBackend *)backend).requestReadFd){
					client = (*(ServerBackend *)backend).clientStart + (message >> 32);
					if(!isValidDreitonTransportClient(backend, client)){
						jmp requestLoop;
					}
					(*transportRequestReturn).operation = CONNECT_DREITON_TRANSPORT_REQUEST_OPERATION;
					(*transportRequestReturn).clientId = message >> 32;
					(*transportRequestReturn).dataStart = (*client).handshakeDataStart;
					(*transportRequestReturn).dataSize = (*client).handshakeDataSize;
					(*client).handshakeDataStart = NULL;
					fprintf(stdout, "transport: connected %u\n", (uint32)(message >> 32));
				}else{
					const uint32 clientId = message >> 32;
					const uint32 requestAmount = message;
					client = (*(ServerBackend *)backend).clientStart + clientId;
					if(!isValidDreitonTransportClient(backend, client)){
						jmp requestLoop;
					}
					if(!requestAmount){
						jmp closeConnection;
					}
					(*transportRequestReturn).operation = REQUEST_DREITON_TRANSPORT_REQUEST_OPERATION;
					(*transportRequestReturn).clientId = clientId;
					(*transportRequestReturn).clientHandle = (*client).handle;
					(*transportRequestReturn).requestAmount = requestAmount;
				}
				success = true;
				jmp emergencyExit;
			}
			if(returnValue == READ_FAILURE){
				if(errno == EINTR){
					jmp readRequestLoop;
				}
			}
			jmp requestLoop;
		}
		closeConnection:{
			const uint32 clientId = (*client).id;
			fprintf(stdout, "transport: disconnected %u\n", (uint32)clientId);
			if(!destroyDreitonTransportClient(backend, client)){
				jmp requestLoop;
			}
			(*transportRequestReturn).operation = DISCONNECT_DREITON_TRANSPORT_REQUEST_OPERATION;
			(*transportRequestReturn).clientId = clientId;
			success = true;
			jmp emergencyExit;
		}
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
WAITFORDREITONSERVERTRANSPORTDESCRIPTORSERVEREVENT(){
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if((*(ServerBackend *)backend).eventEpollFd == NONE_FD or !extensionReturn or !eventTypeReturn){
		jmp emergencyExit;
	}
	jmp eventLoop;
	eventLoop:{
		struct epoll_event event[1];
		int fd;
		if(epoll_wait((*(ServerBackend *)backend).eventEpollFd, event, countof(event), INFINITE_EPOLL_WAIT_TIMEOUT) == EPOLL_WAIT_FAILURE){ /*! errors? */
			jmp emergencyExit;
		}
		if(!((*event).events & EPOLLIN)){
			jmp eventLoop;
		}
		fd = (*event).data.fd;
		jmp readEventLoop;
		readEventLoop:{
			uint64 message;
			int returnValue = read(fd, &message, sizeof(message));
			if(fd != (*(ServerBackend *)backend).eventReadFd){
				if(fd == (*(ServerBackend *)backend).signalEventFd){
					jmp emergencyExit;
				}
				jmp eventLoop;
			}
			if(returnValue > 0){
				*extensionReturn = message >> 32;
				*eventTypeReturn = message;
				success = true;
				jmp eventLoop;
			}
			if(returnValue == READ_FAILURE){
				if(errno == EINTR){
					jmp readEventLoop;
				}
			}
			jmp eventLoop;
		}
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
WAITFORDREITONSERVERTRANSPORTDESCRIPTORREGISTRATION(){
	int clientFd;
	bool success;
	if(!backend){
		ret false;
	}
	clientFd = NONE_FD;
	success = false;
	if((*(ServerBackend *)backend).registrationEpollFd == NONE_FD or (*(ServerBackend *)backend).requestEpollFd == NONE_FD or (dataSizeReturn and !dataReturn)){
		jmp emergencyExit;
	}
	jmp registrationLoop;
	registrationLoop:{
		struct epoll_event event[1];
		int fd;
		if(epoll_wait((*(ServerBackend *)backend).registrationEpollFd, event, countof(event), INFINITE_EPOLL_WAIT_TIMEOUT) == EPOLL_WAIT_FAILURE){ /*! errors? */
			jmp emergencyExit;
		}
		if(!((*event).events & EPOLLIN)){
			jmp registrationLoop;
		}
		fd = (*event).data.fd;
		if(fd != (*(ServerBackend *)backend).socketFd){
			if(fd == (*(ServerBackend *)backend).signalRegistrationFd){
				jmp emergencyExit;
			}
			jmp registrationLoop;
		}
		clientFd = accept((*(ServerBackend *)backend).socketFd, NULL, NULL);
		if(clientFd == ACCEPT_FAILURE){
			jmp emergencyExit;
		}
		if(dataSizeReturn){
			if(recv(clientFd, dataReturn, dataSizeReturn, NONE_RECV_FLAG) == RECV_FAILURE){ /*! this fails? what do? */
				jmp emergencyExit;
			}
		}
		if((*(ServerBackend *)backend).newClientFd != NONE_FD){
			close((*(ServerBackend *)backend).newClientFd); /*! errors? */
		}
		(*(ServerBackend *)backend).newClientFd = clientFd;
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			if(clientFd != NONE_FD){
				close(clientFd); /*! on signal interrupt? */
			}
			ret false;
		}
		ret true;
	}
}
HANDSHAKEDREITONSERVERTRANSPORTDESCRIPTORREGISTRATION(){
	void **handshakeDataStart;
	bool success;
	if(!backend){
		ret false;
	}
	success = false;
	if((*(ServerBackend *)backend).newClientFd == NONE_FD){
		jmp emergencyExit;
	}
	handshakeDataStart = &(*(ServerBackend *)backend).handshakeDataStart;
	if(*handshakeDataStart){
		free(*handshakeDataStart);
	}
	*handshakeDataStart = malloc(dataSize * sizeof(uint8));
	if(!*handshakeDataStart){
		jmp emergencyExit;
	}
	memcpy(*handshakeDataStart, data, dataSize * sizeof(uint8));
	(*(ServerBackend *)backend).handshakeDataSize = dataSize;
	if(dataSize and data){
		if(send((*(ServerBackend *)backend).newClientFd, data, dataSize, NONE_SEND_FLAG) == SEND_FAILURE){ /*! errors? client might not send, how to mitigate? */
			jmp emergencyExit;
		}
	}
	if(!successfulHandshake){
		close((*(ServerBackend *)backend).newClientFd); /*! on signal interrupt? */
		(*(ServerBackend *)backend).newClientFd = NONE_FD;
	}
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
CONSUMEDREITONSERVERTRANSPORTDESCRIPTORREGISTRATION(){
	int clientFd;
	uint32 requestSlotSize;
	uint32 replySlotSize;
	uint32 eventSlotSize;
	uint32 requestSize;
	uint32 replySize;
	uint32 eventSize;
	uint32 requestSlotMemorySize;
	uint32 replySlotMemorySize;
	uint32 eventSlotMemorySize;
	uint32 requestMemorySize;
	uint32 replyMemorySize;
	uint32 eventMemorySize;
	uint32 clientId;
	int shmId;
	void *shmStart;
	Header header;
	Client *client;
	bool success;
	struct{
		int32 /*-*/ readFd;
		int32 /*-*/ writeFd;
	} requestPipe;
	struct{
		int32 /*-*/ readFd;
		int32 /*-*/ writeFd;
	} replyPipe;
	struct{
		int32 /*-*/ readFd;
		int32 /*-*/ writeFd;
	} eventPipe;
	if(!backend){
		ret false;
	}
	requestPipe.readFd = NONE_FD;
	requestPipe.writeFd = NONE_FD;
	replyPipe.readFd = NONE_FD;
	replyPipe.writeFd = NONE_FD;
	eventPipe.readFd = NONE_FD;
	eventPipe.writeFd = NONE_FD;
	clientFd = NONE_FD;
	success = false;
	if((*(ServerBackend *)backend).registrationEpollFd == NONE_FD or (*(ServerBackend *)backend).requestEpollFd == NONE_FD or (*(ServerBackend *)backend).newClientFd == NONE_FD){
		jmp emergencyExit;
	}
	clientFd = (*(ServerBackend *)backend).newClientFd;
	if(pipe((void *)&requestPipe) == PIPE_FAILURE){ /*! check for surprise errors */
		jmp emergencyExit;
	}
	if(pipe((void *)&replyPipe) == PIPE_FAILURE){ /*! check for surprise errors */
		jmp emergencyExit;
	}
	if(pipe((void *)&eventPipe) == PIPE_FAILURE){ /*! check for surprise errors */
		jmp emergencyExit;
	}
	{
		int fd[3];
		*(fd + 0) = requestPipe.writeFd;
		*(fd + 1) = replyPipe.readFd;
		*(fd + 2) = eventPipe.readFd;
		if(!sendFd(clientFd, fd, countof(fd))){ /*! errors? client might not send, how to mitigate? */
			jmp emergencyExit;
		}
	}
	{
		const int flag = fcntl(requestPipe.readFd, F_GETFL, 0); /*! errors? */
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		if(fcntl(requestPipe.readFd, F_SETFL, flag | O_NONBLOCK) == FCNTL_FAILURE){ /*! errors? */
			jmp emergencyExit;
		}
	}
	{
		struct epoll_event event;
		event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
		event.data.fd = requestPipe.readFd;
		if(epoll_ctl((*(ServerBackend *)backend).requestEpollFd, EPOLL_CTL_ADD, requestPipe.readFd, &event) == EPOLL_CTL_FAILURE){
			jmp emergencyExit;
		}
	}
	jmp insertClient;
	insertClient:{
		if((*(ServerBackend *)backend).clientAllocated == (*(ServerBackend *)backend).clientSize){
			void *temp;
			if(!(*(ServerBackend *)backend).clientBlockSize){
				jmp emergencyExit;
			}
			(*(ServerBackend *)backend).clientSize += (*(ServerBackend *)backend).clientBlockSize;
			temp = realloc((*(ServerBackend *)backend).clientStart, (*(ServerBackend *)backend).clientSize * sizeof(Client));
			if(!temp){
				(*(ServerBackend *)backend).clientSize -= (*(ServerBackend *)backend).clientBlockSize;
				jmp emergencyExit;
			}
			(*(ServerBackend *)backend).clientStart = temp;
			if(!(*(ServerBackend *)backend).clientAllocated){
				inc (*(ServerBackend *)backend).clientAllocated;
				jmp insertClient;
			}
		}
		requestSlotSize = (*(ServerBackend *)backend).requestSlotSize;
		replySlotSize = (*(ServerBackend *)backend).replySlotSize;
		eventSlotSize = (*(ServerBackend *)backend).eventSlotSize;
		requestSize = (*(ServerBackend *)backend).requestSize;
		replySize = (*(ServerBackend *)backend).replySize;
		eventSize = (*(ServerBackend *)backend).eventSize;
		requestSlotMemorySize = (requestSlotSize * sizeof(MessageSlot) + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
		replySlotMemorySize = (replySlotSize * sizeof(MessageSlot) + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
		eventSlotMemorySize = (eventSlotSize * sizeof(MessageSlot) + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
		requestMemorySize = (requestSize * sizeof(uint8) + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
		replyMemorySize = (replySize * sizeof(uint8) + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
		eventMemorySize = (eventSize * sizeof(uint8) + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
		clientId = (*(ServerBackend *)backend).clientAllocated;
		shmId = shmget((clientId << 16) | (*(ServerBackend *)backend).shmKey, sizeof(Header) + requestSlotMemorySize + replySlotMemorySize + eventSlotMemorySize + requestMemorySize + replyMemorySize + eventMemorySize, IPC_CREAT | 0666);
		if(!shmId){
			jmp emergencyExit;
		}
		shmStart = shmat(shmId, NULL, SHM_NONE); /*! params? */
		if(shmStart == SHMAT_FAILURE){
			jmp emergencyExit;
		}
		header.requestSlotStartOffset = 0 + sizeof(Header);
		header.replySlotStartOffset = header.requestSlotStartOffset + requestSlotMemorySize;
		header.eventSlotStartOffset = header.replySlotStartOffset + replySlotMemorySize;
		header.requestStartOffset = header.eventSlotStartOffset + eventSlotMemorySize;
		header.replyStartOffset = header.requestStartOffset + requestMemorySize;
		header.eventStartOffset = header.replyStartOffset + replyMemorySize;
		header.requestSlotSize = requestSlotSize;
		header.replySlotSize = replySlotSize;
		header.eventSlotSize = eventSlotSize;
		header.requestSize = requestSize;
		header.replySize = replySize;
		header.eventSize = eventSize;
		header.requestCurrentWriter = 0;
		header.requestCurrentReader = 0;
		header.replyCurrentWriter = 0;
		header.replyCurrentReader = 0;
		header.eventCurrentWriter = 0;
		header.eventCurrentReader = 0;
		header.clientId = clientId;
		client = (*(ServerBackend *)backend).clientStart + clientId;
		(*client).shmStart = shmStart;
		(*client).shmId = shmId;
		(*client).requestSlotStart = (void *)((uint8 *)shmStart + header.requestSlotStartOffset);
		(*client).replySlotStart = (void *)((uint8 *)shmStart + header.replySlotStartOffset);
		(*client).eventSlotStart = (void *)((uint8 *)shmStart + header.eventSlotStartOffset);
		(*client).requestStart = (void *)((uint8 *)shmStart + header.requestStartOffset);
		(*client).replyStart = (void *)((uint8 *)shmStart + header.replyStartOffset);
		(*client).eventStart = (void *)((uint8 *)shmStart + header.eventStartOffset);
		(*client).requestCurrent = (*client).requestStart;
		(*client).replyCurrent = (*client).replyStart;
		(*client).eventCurrent = (*client).eventStart;
		(*client).requestSlotSize = requestSlotSize;
		(*client).replySlotSize = replySlotSize;
		(*client).eventSlotSize = eventSlotSize;
		(*client).requestSize = requestSize;
		(*client).replySize = replySize;
		(*client).eventSize = eventSize;
		(*client).requestFd = requestPipe.readFd;
		(*client).replyFd = replyPipe.writeFd;
		(*client).eventFd = eventPipe.writeFd;
		(*client).handshakeDataStart = (*(ServerBackend *)backend).handshakeDataStart;
		(*client).handshakeDataSize = (*(ServerBackend *)backend).handshakeDataSize;
		(*client).id = clientId;
		(*client).handle = 0;
		memcpy(shmStart, &header, sizeof(Header)); /*! replace with toolkit function */
		if(send(clientFd, &shmId, sizeof(shmId), 0) == SEND_FAILURE){ /*! errors? client might not send, how to mitigate? */
			jmp emergencyExit;
		}
		{
			const uint64 message = ((uint64)clientId << 32) | 0;
			write((*(ServerBackend *)backend).requestWriteFd, &message, sizeof(message)); /*! errors? */
		}
		(*(ServerBackend *)backend).handshakeDataStart = NULL;
		(*(ServerBackend *)backend).handshakeDataSize = 0;
		inc (*(ServerBackend *)backend).clientAllocated;
		success = true;
		jmp emergencyExit;
		emergencyExit:{
			if(clientFd != NONE_FD) /*------------*/ close(clientFd); /*! on signal interrupt? */
			if(requestPipe.writeFd != NONE_FD) /*-*/ close(requestPipe.writeFd); /*! on signal interrupt? */
			if(replyPipe.readFd != NONE_FD) /*----*/ close(replyPipe.readFd); /*! on signal interrupt? */
			if(eventPipe.readFd != NONE_FD) /*----*/ close(eventPipe.readFd); /*! on signal interrupt? */
			if(!success){
				if(requestPipe.readFd != NONE_FD) /*-*/ close(requestPipe.readFd); /*! on signal interrupt? */
				if(replyPipe.writeFd != NONE_FD) /*--*/ close(replyPipe.writeFd); /*! on signal interrupt? */
				if(eventPipe.writeFd != NONE_FD) /*--*/ close(eventPipe.writeFd); /*! on signal interrupt? */
				ret false;
			}
			(*(ServerBackend *)backend).newClientFd = NONE_FD;
			ret true;
		}
	}
}

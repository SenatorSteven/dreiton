#define _POSIX_C_SOURCE /*-*/ (200809L)

#include <pthread.h>
#include <signal.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#include "headers/cold/cold.hold"
#include "headers/dreiton-protocol.hold"
#include "headers/dreiton-transport.hold"
#include "headers/dreiton-extension.hold"
#include "headers/dreiton-core.hold"
#include "headers/server.hold"

def struct{
	void /*--*/ (*handler)(const int signal);
	int32 /*-*/ signal;
	uint8 /*-*/ pad0[4];
} SignalHandler;

local const char * /*--------*/ serverName;
local DreitonCore /*---------*/ dreitonCore;
local DreitonCoreDatabase /*-*/ database;

#define BOOTSIGNALTHREAD() /*-------*/ bool   bootSignalThread(const uint64 signalHandlerSize, const SignalHandler *const signalHandlerStart)
#define SIGNALMAIN() /*-------------*/ void * signalMain(void *const arg)
#define INTERRUPTSIGNALHANDLER() /*-*/ void   interruptSignalHandler(const int signal)
#define PIPESIGNALHANDLER() /*------*/ void   pipeSignalHandler(const int signal)

BOOTSIGNALTHREAD();
SIGNALMAIN();
INTERRUPTSIGNALHANDLER();
PIPESIGNALHANDLER();

int main(const int argumentSize, const char *const *const argumentStart){
	if(argumentSize != 2){
		ret 0;
	}
	serverName = *(argumentStart + 1);
	{
		SignalHandler signalHandler[2];
		(*(signalHandler + 0)).handler = &interruptSignalHandler;
		(*(signalHandler + 0)).signal = SIGINT;
		(*(signalHandler + 1)).handler = &pipeSignalHandler;
		(*(signalHandler + 1)).signal = SIGPIPE;
		bootSignalThread(countof(signalHandler), signalHandler);
	}
	fprintf(stdout, "starting dreiton core @ \'%s\'\n", serverName);



	/*! actually use the server name */

	initDreitonCore(&dreitonCore);
	setDreitonCoreServerChannelPath(&dreitonCore, "/dev/shm/registration-form");
	setDreitonCoreClientChannelPath(&dreitonCore, "/dev/shm/client-writer");
	setDreitonCoreDatabase(&dreitonCore, &database);
	setDreitonCoreOwner(&dreitonCore, NONE_DREITON_CORE_OWNER);
	setDreitonCoreExtensionBlockSize(&dreitonCore, 16);
	setDreitonCoreClientBlockSize(&dreitonCore, 16);
	bootDreitonCoreReplyLoopThread(&dreitonCore);
	bootDreitonCoreEventLoopThread(&dreitonCore);
	bootDreitonCoreRegistrationLoopThread(&dreitonCore);



	/*! all clients closing and turning the hint on will still cause us to not exit the program. fix. */

	awaitDreitonCoreRegistrationLoopThreadExit(&dreitonCore);
	awaitDreitonCoreReplyLoopThreadExit(&dreitonCore);
	awaitDreitonCoreEventLoopThreadExit(&dreitonCore);



	finiDreitonCore(&dreitonCore);
	ret 0;
}
BOOTSIGNALTHREAD(){
	#define PTHREAD_CREATE_FAILURE /*-*/ (-1)
	sigset_t blockSet;
	if(!signalHandlerSize){
		sigfillset(&blockSet);
		pthread_sigmask(SIG_BLOCK, &blockSet, NULL);
	}else{
		void *data;
		pthread_t thread;
		if(!signalHandlerStart){
			ret false;
		}
		data = malloc(1 * sizeof(uint64) + signalHandlerSize * sizeof(SignalHandler));
		if(!data){
			ret false;
		}
		*(uint64 *)data = signalHandlerSize;
		memcpy((uint64 *)data + 1, signalHandlerStart, signalHandlerSize * sizeof(SignalHandler));
		sigfillset(&blockSet);
		pthread_sigmask(SIG_BLOCK, &blockSet, NULL);
		if(pthread_create(&thread, NULL, &signalMain, data) == PTHREAD_CREATE_FAILURE){
			free(data);
			ret false;
		}
	}
	ret true;
}
SIGNALMAIN(){
	#define SIGWAIT_FAILURE /*-*/ (-1)
	#define SIGMIN /*----------*/ (0)
	#define SIGMAX /*----------*/ (64)
	void (*handler[SIGMAX])(const int signal);
	sigset_t waitSet;
	if(!arg){
		ret NULL;
	}
	jmp setHandlers;
	setHandlers:{
		void (**handlerCurrent)(const int signal) = handler + SIGMIN;
		void (*const *const handlerWall)(const int signal) = handler + SIGMAX;
		jmp setHandlerLoop;
		setHandlerLoop:{
			if(handlerCurrent < handlerWall){
				*handlerCurrent = NULL;
				inc handlerCurrent;
				jmp setHandlerLoop;
			}
			jmp setSignalHandlers;
		}
	}
	setSignalHandlers:{
		const SignalHandler *signalHandlerCurrent = (void *)((uint64 *)arg + 1);
		const SignalHandler *const signalHandlerWall = signalHandlerCurrent + *(uint64 *)arg;
		sigemptyset(&waitSet);
		jmp setSignalHandlerLoop;
		setSignalHandlerLoop:{
			if(signalHandlerCurrent < signalHandlerWall){
				const int signal = (*signalHandlerCurrent).signal;
				if(signal >= SIGMIN and signal < SIGMAX){
					void (*handle)(const int signal) = (*signalHandlerCurrent).handler;
					*(handler + signal) = handle;
					sigaddset(&waitSet, signal);
				}
				inc signalHandlerCurrent;
				jmp setSignalHandlerLoop;
			}
			free(arg);
			jmp signalLoop;
		}
	}
	signalLoop:{
		int signal;
		if(sigwait(&waitSet, &signal) == SIGWAIT_FAILURE){
			jmp signalLoop;
		}
		if(signal < SIGMIN or signal >= SIGMAX){
			jmp signalLoop;
		}
		jmp handleSignal;
		handleSignal:{
			void (*h)(const int signal) = *(handler + signal);
			if(!h){
				jmp signalLoop;
			}
			(*h)(signal);
			jmp signalLoop;
		}
	}
}
INTERRUPTSIGNALHANDLER(){
	(void)signal;



	/*!*/

	fprintf(stdout, "\n");
	quitDreitonCoreRegistrationLoopThread(&dreitonCore);
	quitDreitonCoreReplyLoopThread(&dreitonCore);
	quitDreitonCoreEventLoopThread(&dreitonCore);



	ret;
}
PIPESIGNALHANDLER(){
	(void)signal;
	fprintf(stderr, "\tpipe error\n");
	ret;
}


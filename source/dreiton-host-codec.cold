#include <stdint.h>
#include <string.h>

#include "headers/cold/cold.hold"
#include "headers/protocols/dreiton-protocol.hold"
#include "headers/protocols/dreiton-codec-protocol.hold"
#include "headers/dreiton-host-codec.hold"

#define CALCULATEDREITONCODECFRAMESIZE() /*----------*/ local bool  calculateDreitonCodecFrameSize(const uint32 messageSize, const uint32 payloadItemAmount, const uint32 *const payloadItemSizeStart, uint32 *const frameSizeReturn)
#define ENCODEDREITONCODECMESSAGE() /*---------------*/ local bool  encodeDreitonCodecMessage(uint32 messageSize, const void *const message, const uint32 payloadItemAmount, const uint32 *const payloadItemSizeStart, const void *const *const payloadItemDataStart, const uint32 frameSize, void *const frame)
#define DECODEDREITONCODECMESSAGE() /*---------------*/ local bool  decodeDreitonCodecMessage(const void *const frame, void *const decodedFrame, void **const messageHeaderReturn)
#define GETDREITONCODECENCODEDTOKEN() /*-------------*/ local bool  getDreitonCodecEncodedToken(const void *const frame, uint32 *const tokenReturn)
#define GETDREITONCODECENCODEDFRAMESIZE() /*---------*/ local bool  getDreitonCodecEncodedFrameSize(const void *const frame, uint32 *const frameSizeReturn)
#define GETDREITONCODECDECODEDPAYLOADITEMAMOUNT() /*-*/ local bool  getDreitonCodecDecodedPayloadItemAmount(const void *const frame, uint32 *const payloadItemAmountReturn)
#define GETDREITONCODECDECODEDITEM() /*--------------*/ local bool  getDreitonCodecDecodedItem(const void *const frame, const uint32 which, uint32 *const itemSizeReturn, void **const itemStartReturn)

#define writeDreitonCodec8(source, destination) /*---*/ (*(uint8 *)(destination) = *(uint8 *)(source))
#define writeDreitonCodec16(source, destination) /*--*/ (*(uint16 *)(destination) = *(uint16 *)(source))
#define writeDreitonCodec32(source, destination) /*--*/ (*(uint32 *)(destination) = *(uint32 *)(source))
#define writeDreitonCodec64(source, destination) /*--*/ (*(uint64 *)(destination) = *(uint64 *)(source))

CALCULATEDREITONCODECFRAMESIZE();
ENCODEDREITONCODECMESSAGE();
DECODEDREITONCODECMESSAGE();
GETDREITONCODECENCODEDTOKEN();
GETDREITONCODECENCODEDFRAMESIZE();
GETDREITONCODECDECODEDPAYLOADITEMAMOUNT();
GETDREITONCODECDECODEDITEM();

const DreitonCodecDescriptor /*-*/ dreitonCodecDescriptor = {
	  sizeof(DreitonCodecDescriptor)
	, DREITON_HOST_CODEC_PROTOCOL_VERSION
	, DREITON_HOST_CODEC_CODEC_VERSION
	, lengthof(DREITON_HOST_CODEC_CODEC_NAME)
	, lengthof(DREITON_HOST_CODEC_AUTHOR_NAME)
	, {0, 0, 0, 0}
	, DREITON_HOST_CODEC_CODEC_NAME
	, DREITON_HOST_CODEC_AUTHOR_NAME
	, &calculateDreitonCodecFrameSize
	, &encodeDreitonCodecMessage
	, &decodeDreitonCodecMessage
	, &getDreitonCodecEncodedToken
	, &getDreitonCodecEncodedFrameSize
	, &getDreitonCodecDecodedPayloadItemAmount
	, &getDreitonCodecDecodedItem
};



























CALCULATEDREITONCODECFRAMESIZE(){
	const uint32 *current = payloadItemSizeStart;
	const uint32 *const wall = current + payloadItemAmount;
	uint32 frameSize = 2 * sizeof(uint32) + ((messageSize + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1)) + ((sizeof(uint16) + 2 * payloadItemAmount * sizeof(uint16) + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1));
	jmp calculatePayloadSizeLoop;
	calculatePayloadSizeLoop:{
		if(current < wall){
			frameSize += (*current + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
			inc current;
			jmp calculatePayloadSizeLoop;
		}
		*frameSizeReturn = frameSize;
		ret true;
	}
}
ENCODEDREITONCODECMESSAGE(){
	uint8 *frameCurrent;
	uint32 payloadSize;
	messageSize = (messageSize + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
	payloadSize = frameSize - 8 * sizeof(uint8) - messageSize;
	{
		const uint32 payloadSize = 0;
		const uint8 *messageCurrent = message;
		frameCurrent = frame;
		writeDreitonCodec32(&messageSize, frameCurrent);
		frameCurrent += sizeof(uint32);
		writeDreitonCodec32(&payloadSize, frameCurrent);
		frameCurrent += sizeof(uint32);
		memmove(frameCurrent, messageCurrent, 16 * sizeof(uint8));
		frameCurrent += 16 * sizeof(uint8);
		messageCurrent += 16 * sizeof(uint8);
	}
	if(payloadItemAmount and payloadItemSizeStart and payloadItemDataStart and payloadSize){
		const uint32 padding = (4 - ((1 + 2 * payloadItemAmount) & 3)) & 3;
		const uint32 *payloadItemSizeCurrent = payloadItemSizeStart;
		const uint32 *const payloadItemSizeWall = payloadItemSizeCurrent + payloadItemAmount;
		const void *const *payloadItemDataCurrent = payloadItemDataStart;
		uint16 *frameSizeCurrent;
		uint16 *frameOffsetCurrent;
		uint8 *framePointerCurrent;
		writeDreitonCodec32(&payloadSize, (uint8 *)frame + 4 * sizeof(uint8));
		writeDreitonCodec16(&payloadItemAmount, frameCurrent);
		frameCurrent += sizeof(uint16);
		frameSizeCurrent = (void *)frameCurrent;
		frameOffsetCurrent = frameSizeCurrent + payloadItemAmount;
		framePointerCurrent = (void *)(frameOffsetCurrent + payloadItemAmount + padding);
		jmp encodePayloadItemLoop;
		encodePayloadItemLoop:{
			if(payloadItemSizeCurrent < payloadItemSizeWall){
				const uint16 itemOffset = framePointerCurrent - (uint8 *)frame;
				writeDreitonCodec16(payloadItemSizeCurrent, frameSizeCurrent);
				writeDreitonCodec16(&itemOffset, frameOffsetCurrent);
				switch(*payloadItemSizeCurrent){
					to sizeof(uint8):{
						writeDreitonCodec8(*payloadItemDataCurrent, framePointerCurrent);
						brk;
					}
					to sizeof(uint16):{
						writeDreitonCodec16(*payloadItemDataCurrent, framePointerCurrent);
						brk;
					}
					to sizeof(uint32):{
						writeDreitonCodec32(*payloadItemDataCurrent, framePointerCurrent);
						brk;
					}
					to sizeof(uint64):{
						writeDreitonCodec64(*payloadItemDataCurrent, framePointerCurrent);
						brk;
					}
					off:{
						memmove(framePointerCurrent, *payloadItemDataCurrent, *payloadItemSizeCurrent * sizeof(uint8));
						brk;
					}
				}
				inc frameSizeCurrent;
				inc frameOffsetCurrent;
				framePointerCurrent += (*payloadItemSizeCurrent + (sizeof(uint64) - 1)) & ~(sizeof(uint64) - 1);
				inc payloadItemDataCurrent;
				inc payloadItemSizeCurrent;
				jmp encodePayloadItemLoop;
			}
		}
	}
	ret true;
}
DECODEDREITONCODECMESSAGE(){
	memmove(decodedFrame, frame, *(uint32 *)((uint8 *)frame + 0 * sizeof(uint8)) + *(uint32 *)((uint8 *)frame + 4 * sizeof(uint8)));
	*messageHeaderReturn = (uint8 *)decodedFrame + 8 * sizeof(uint8);
	ret true;
}
GETDREITONCODECENCODEDTOKEN(){
	writeDreitonCodec32((uint8 *)frame + 12 * sizeof(uint8), tokenReturn);
	ret true;
}
GETDREITONCODECENCODEDFRAMESIZE(){
	uint32 messageSize;
	uint32 payloadSize;
	writeDreitonCodec32(frame, &messageSize);
	writeDreitonCodec32((uint8 *)frame + 4 * sizeof(uint8), &payloadSize);
	*frameSizeReturn = 8 * sizeof(uint8) + messageSize + payloadSize;
	ret true;
}
GETDREITONCODECDECODEDPAYLOADITEMAMOUNT(){
	if(!*(uint32 *)((uint8 *)frame + 4 * sizeof(uint8))){
		*payloadItemAmountReturn = 0;
		ret true;
	}
	*payloadItemAmountReturn = *(uint16 *)((uint8 *)frame + 24 * sizeof(uint8));
	ret true;
}
GETDREITONCODECDECODEDITEM(){
	*itemSizeReturn = *(uint16 *)((uint8 *)frame + 26 * sizeof(uint8) + which * 2 * sizeof(uint8));
	*itemStartReturn = (uint8 *)frame + *(uint16 *)((uint8 *)frame + 26 * sizeof(uint8) + (*(uint16 *)((uint8 *)frame + 24 * sizeof(uint8)) + which) * 2 * sizeof(uint8));
	ret true;
}




























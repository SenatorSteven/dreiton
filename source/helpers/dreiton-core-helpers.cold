	}
	if(size != sizeof(uint32)){
		jmp emergencyExit;
	}
	*extensionReturn = *(uint32 *)start;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

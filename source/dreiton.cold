#include "headers/dreiton.hold"

#define DLCLOSE_SUCCESS /*-------------*/ (0)

#define CACHEDREITONREPLY() /*---------*/ bool  cacheDreitonReply(Dreiton *const dreiton, const DreitonClientTransportDescriptor *const transportDescriptor, const DreitonCodecDescriptor *const codecDescriptor, const uint32 token, const uint32 frameSize, void *const transportFrame)
#define RECOVERDREITONCACHEDREPLY() /*-*/ bool  recoverDreitonCachedReply(Dreiton *const dreiton, const uint32 token, DreitonReply **const replyReturn, bool *const slotStatusReturn)

CACHEDREITONREPLY();
RECOVERDREITONCACHEDREPLY();

INITDREITON(){
	if(!dreiton){
		ret false;
	}
	(*dreiton).transportDescriptorHandle = NULL;
	(*dreiton).transportDescriptor = NULL;
	(*dreiton).transportHandle = NULL;
	(*dreiton).codecDescriptorHandle = NULL;
	(*dreiton).codecDescriptor = NULL;
	(*dreiton).replyCacheSlotStart = NULL;
	(*dreiton).replyCacheSlotSize = 0;
	(*dreiton).replyCacheStorageSlotStart = NULL;
	(*dreiton).replyCacheStorageSlotSize = 0;
	(*dreiton).replyCacheStorageSlotAllocated = 0;
	(*dreiton).clientUuid.uuid0 = 0;
	(*dreiton).clientUuid.uuid1 = 0;
	(*dreiton).currentToken = 0;
	(*dreiton).isRunning = false;
	(*dreiton).status = NONE_DREITON_TRANSPORT_STATUS;
	ret true;
}
SETDREITONREPLYCACHESLOTSIZE(){
	DreitonCacheSlot *current;
	DreitonCacheSlot *wall;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if((*dreiton).replyCacheSlotSize){
		jmp emergencyExit;
	}
	(*dreiton).replyCacheSlotStart = malloc(replyCacheSlotSize * (sizeof(DreitonCacheSlot) + sizeof(DreitonCacheStorageSlot)));
	(*dreiton).replyCacheSlotSize = replyCacheSlotSize;
	(*dreiton).replyCacheStorageSlotStart = (void *)((*dreiton).replyCacheSlotStart + replyCacheSlotSize);
	(*dreiton).replyCacheStorageSlotSize = replyCacheSlotSize;
	(*dreiton).replyCacheStorageSlotAllocated = 0;
	current = (*dreiton).replyCacheSlotStart;
	wall = current + replyCacheSlotSize;
	jmp fillSlotLoop;
	fillSlotLoop:{
		if(current < wall){
			(*current).dataSize = 0;
			(*current).token = 0;
			inc current;
			jmp fillSlotLoop;
		}
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
LOADDREITONTRANSPORT(){
	void *transportDescriptorHandle;
	DreitonClientTransportDescriptor *transportDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if((*dreiton).transportDescriptor or !path){
		jmp emergencyExit;
	}
	transportDescriptorHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
	if(!transportDescriptorHandle){
		jmp emergencyExit;
	}
	transportDescriptor = dlsym(transportDescriptorHandle, "dreitonClientTransportDescriptor");
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).initDreitonTransportDescriptorConnection){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).initDreitonTransportDescriptorConnection)(&(*dreiton).transportHandle)){
		jmp emergencyExit;
	}
	(*dreiton).transportDescriptorHandle = transportDescriptorHandle;
	(*dreiton).transportDescriptor = transportDescriptor;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
LOADDREITONCONDITIONALCODEC(){
	const uint32 variable = 1;
	if(*(uint8 *)&variable != (DREITON_ENDIANNESS == LITTLE_DREITON_ENDIANNESS)){
		path = endianPath;
	}
	ret loadDreitonCodec(dreiton, path);
}
LOADDREITONCODEC(){
	void *codecDescriptorHandle;
	DreitonCodecDescriptor *codecDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if((*dreiton).codecDescriptor or !path){
		jmp emergencyExit;
	}
	codecDescriptorHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
	if(!codecDescriptorHandle){
		jmp emergencyExit;
	}
	codecDescriptor = dlsym(codecDescriptorHandle, "dreitonCodecDescriptor");
	if(!codecDescriptor){
		jmp emergencyExit;
	}
	(*dreiton).codecDescriptorHandle = codecDescriptorHandle;
	(*dreiton).codecDescriptor = codecDescriptor;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
CONNECTTODREITON(){
	DreitonClientTransportDescriptor *transportDescriptor;
	DreitonUuid clientUuid;
	bool success;
	if(!dreiton){
		ret false;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	success = false;
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).connectToDreitonTransportDescriptorConnection){
		jmp emergencyExit;
	}
	clientUuid.uuid0 = 0;
	clientUuid.uuid1 = 0;
	if(!(*(*transportDescriptor).connectToDreitonTransportDescriptorConnection)((*dreiton).transportHandle, argument, sizeof(DreitonUuid), &clientUuid, sizeof(DreitonUuid), &(*dreiton).clientUuid)){
		jmp emergencyExit;
	}
	if(!(*dreiton).clientUuid.uuid0 or !(*dreiton).clientUuid.uuid1){
		jmp emergencyExit;
	}
	(*dreiton).currentToken = 0;
	(*dreiton).isRunning = true;
	(*dreiton).status = NONE_DREITON_TRANSPORT_STATUS;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
SENDDREITONREQUEST(){
	DreitonClientTransportDescriptor *transportDescriptor;
	DreitonCodecDescriptor *codecDescriptor;
	uint32 currentToken;
	uint32 frameSize;
	void *frame;
	DreitonRequestHeader header;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if((*dreiton).status){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	codecDescriptor = (*dreiton).codecDescriptor;
	if(!transportDescriptor or !codecDescriptor){
		jmp emergencyExit;
	}
	if(!(*codecDescriptor).calculateDreitonCodecFrameSize or !(*transportDescriptor).getDreitonTransportDescriptorRequestFrame or !(*codecDescriptor).encodeDreitonCodecMessage or !(*transportDescriptor).sendDreitonTransportDescriptorRequest){
		jmp emergencyExit;
	}
	currentToken = (*dreiton).currentToken + 1;
	if(!currentToken){
		currentToken = 1;
	}
	if(!(*(*codecDescriptor).calculateDreitonCodecFrameSize)(sizeof(DreitonRequestHeader), payloadItemAmount, payloadItemSizeStart, &frameSize)){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).getDreitonTransportDescriptorRequestFrame)((*dreiton).transportHandle, frameSize, &frame)){
		jmp emergencyExit;
	}
	header.type = type;
	header.extension = extension;
	header.token = currentToken;
	header.flags = !!tokenReturn * SEND_REPLY_DREITON_REQUEST_FLAG;
	if(!(*(*codecDescriptor).encodeDreitonCodecMessage)(sizeof(DreitonRequestHeader), &header, payloadItemAmount, payloadItemSizeStart, payloadItemDataStart, frameSize, frame)){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).sendDreitonTransportDescriptorRequest)((*dreiton).transportHandle, frameSize, frame)){
		jmp emergencyExit;
	}
	(*dreiton).currentToken = currentToken;
	if(tokenReturn){
		*tokenReturn = currentToken;
	}
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
FLUSHDREITONBUFFER(){
	DreitonClientTransportDescriptor *transportDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if((*dreiton).status){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).flushDreitonTransportDescriptorRequestBuffer){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).flushDreitonTransportDescriptorRequestBuffer)((*dreiton).transportHandle)){
		jmp emergencyExit;
	}
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}



























/*!
	validate token is good (not too big, or is in running window. meaning, maintain list of tokens that we care for in a buffer some kind of way.)
	transport should return frame size returned to check with codec. if there are differences in the sizes, drop reply.
	client library should introduce maximum allowed size for reply to come in for sanity.
	accept only the next token as a valid reply. want up to n, n + 1 or n - 1 before n - 2 is not valid.
*/

WAITFORDREITONREPLY(){
	DreitonClientTransportDescriptor *transportDescriptor;
	DreitonCodecDescriptor *codecDescriptor;
	uint32 transportFrameSize;
	void *transportFrame;
	uint8 status;
	DreitonReply *reply;
	void *frame;
	void *header;
	bool success;
	if(!dreiton){
		ret false;
	}
	reply = NULL;
	success = false;
	if((*dreiton).status or !token or !replyReturn){
		jmp emergencyExit;
	}
	if((*dreiton).replyCacheSlotSize){
		if(recoverDreitonCachedReply(dreiton, token, replyReturn, &success)){
			jmp emergencyExit;
		}
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	codecDescriptor = (*dreiton).codecDescriptor;
	if(!transportDescriptor or !codecDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).waitForDreitonTransportDescriptorReply or !(*codecDescriptor).getDreitonCodecEncodedFrameSize or !(*codecDescriptor).decodeDreitonCodecMessage or !(*transportDescriptor).consumeDreitonTransportDescriptorReply){
		jmp emergencyExit;
	}
	jmp waitForDreitonReplyLoop;
	waitForDreitonReplyLoop:{
		uint32 headerToken;
		uint32 frameSize;
		if(!(*(*transportDescriptor).waitForDreitonTransportDescriptorReply)((*dreiton).transportHandle, &transportFrameSize, &transportFrame, &status)){
			(*dreiton).status = status;
			jmp emergencyExit;
		}
		if(!(*(*codecDescriptor).getDreitonCodecEncodedToken)(transportFrame, &headerToken)){
			jmp emergencyExit;
		}
		if(!(*(*codecDescriptor).getDreitonCodecEncodedFrameSize)(transportFrame, &frameSize)){
			jmp emergencyExit;
		}
		if(transportFrameSize != frameSize){
			(*dreiton).status = FAILURE_DREITON_TRANSPORT_STATUS
			jmp emergencyExit;
		}
		if(headerToken != token){
			if(!(*dreiton).replyCacheSlotSize){
				if(!(*(*transportDescriptor).consumeDreitonTransportDescriptorReply)((*dreiton).transportHandle, transportFrame)){
					jmp emergencyExit;
				}
				jmp emergencyExit;
			}
			if(!cacheDreitonReply(dreiton, transportDescriptor, codecDescriptor, headerToken, frameSize, transportFrame)){
				jmp emergencyExit;
			}
			jmp waitForDreitonReplyLoop;
		}
		reply = malloc(sizeof(DreitonReply) + frameSize * sizeof(uint8));
		if(!reply){
			jmp emergencyExit;
		}
		frame = (uint8 *)reply + sizeof(DreitonReply);
		if(!(*(*codecDescriptor).decodeDreitonCodecMessage)(transportFrame, frame, &header)){
			jmp emergencyExit;
		}
		if(!(*(*transportDescriptor).consumeDreitonTransportDescriptorReply)((*dreiton).transportHandle, transportFrame)){
			jmp emergencyExit;
		}
		(*reply).header = header;
		(*reply).frame = frame;
		*replyReturn = reply;
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			free(reply);
			ret false;
		}
		ret true;
	}
}



























WAITFORDREITONEVENT(){
	DreitonClientTransportDescriptor *transportDescriptor;
	DreitonCodecDescriptor *codecDescriptor;
	void *transportFrame;
	uint8 status;
	uint32 frameSize;
	DreitonEvent *event;
	void *frame;
	void *header;
	bool success;
	if(!dreiton){
		ret false;
	}
	event = NULL;
	success = false;
	if((*dreiton).status or !eventReturn){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	codecDescriptor = (*dreiton).codecDescriptor;
	if(!transportDescriptor or !codecDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).waitForDreitonTransportDescriptorEvent or !(*codecDescriptor).getDreitonCodecEncodedFrameSize or !(*codecDescriptor).decodeDreitonCodecMessage or !(*transportDescriptor).consumeDreitonTransportDescriptorEvent){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).waitForDreitonTransportDescriptorEvent)((*dreiton).transportHandle, &transportFrame, &status)){
		(*dreiton).status = status;
		jmp emergencyExit;
	}
	if(!(*(*codecDescriptor).getDreitonCodecEncodedFrameSize)(transportFrame, &frameSize)){
		jmp emergencyExit;
	}
	event = malloc(sizeof(DreitonEvent) + frameSize * sizeof(uint8));
	if(!event){
		jmp emergencyExit;
	}
	frame = (uint8 *)event + sizeof(DreitonEvent);
	if(!(*(*codecDescriptor).decodeDreitonCodecMessage)(transportFrame, frame, &header)){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).consumeDreitonTransportDescriptorEvent)((*dreiton).transportHandle, transportFrame)){
		jmp emergencyExit;
	}
	(*event).header = header;
	(*event).frame = frame;
	*eventReturn = event;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			free(event);
			ret false;
		}
		ret true;
	}
}



























/*!*/

WAITFORDREITONUNCONSUMEDREPLY(){
	DreitonClientTransportDescriptor *transportDescriptor;
	DreitonCodecDescriptor *codecDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if((*dreiton).status or !token or !replyReturn){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	codecDescriptor = (*dreiton).codecDescriptor;
	if(!transportDescriptor or !codecDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).waitForDreitonTransportDescriptorReply or !(*codecDescriptor).decodeDreitonCodecMessage){
		jmp emergencyExit;
	}









	/*! store reply if not the one we want using this here given token */



	void *transportReply;
	uint8 status;
	void *header;
	if(!(*(*transportDescriptor).waitForDreitonTransportDescriptorReply)((*dreiton).transportHandle, &transportReply, &status)){
		(*dreiton).status = status;
		jmp emergencyExit;
	}
	if(!(*(*codecDescriptor).decodeDreitonCodecMessage)(transportReply, transportReply, &header)){
		jmp emergencyExit;
	}
	(*replyReturn).header = header;
	(*replyReturn).frame = transportReply;









	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}


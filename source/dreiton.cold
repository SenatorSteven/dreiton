CACHEDREITONREPLY(){
	#define NONE_METHOD /*----*/ (b(00))
	#define SLOT_METHOD /*----*/ (b(01))
	#define STORAGE_METHOD /*-*/ (b(10))
	DreitonCacheSlot *slot;
	DreitonCacheStorageSlot *storageSlot;
	uint8 method;
	uint32 counter;
	void *reply;
	uint32 zero;
	void **dataStart;
	uint32 *dataSize;
	uint32 *dataAllocated;
	void *header;
	bool success;
	if(!dreiton){
		ret false;
	}
	reply = NULL;
	success = false;
	if(!token or !transportFrame){
		jmp emergencyExit;
	}
	slot = (*dreiton).replyCacheSlotStart + token % (*dreiton).replyCacheSlotSize;
	method = NONE_METHOD;
	counter = 0;
	zero = 0;
	if((*slot).dataSize){
		if((*slot).dataSize >= frameSize){
			jmp pickSlot;
		}
		method |= SLOT_METHOD;
	}
	if((*dreiton).replyCacheStorageSlotAllocated){
		storageSlot = (*dreiton).replyCacheStorageSlotStart + (*dreiton).replyCacheStorageSlotAllocated - 1;
		if((*storageSlot).dataSize >= frameSize){
			jmp pickStorage;
		}
		method |= STORAGE_METHOD;
	}
	if(method & SLOT_METHOD){
		jmp pickSlot;
	}
	if(method & STORAGE_METHOD){
		jmp pickStorage;
	}
	jmp pickCreate;
	pickSlot:{
		dataStart = &(*slot).dataStart;
		dataSize = &(*slot).dataSize;
		dataAllocated = &counter;
		jmp storeReply;
	}
	pickStorage:{
		dataStart = &(*storageSlot).dataStart;
		dataSize = &(*storageSlot).dataSize;
		dataAllocated = &(*dreiton).replyCacheStorageSlotAllocated;
		jmp storeReply;
	}
	pickCreate:{
		dataStart = (void *)&reply;
		dataSize = &zero;
		dataAllocated = &counter;
		jmp storeReply;
	}
	storeReply:{
		if(*dataSize < frameSize){
			void *const temp = realloc(*dataStart, frameSize * sizeof(uint8));
			if(!temp){
				jmp emergencyExit;
			}
			*dataStart = temp;
			*dataSize = frameSize;
		}
		if(!(*(*codecDescriptor).decodeDreitonCodecMessage)(transportFrame, *dataStart, &header)){
			jmp emergencyExit;
		}
		if(!(*(*transportDescriptor).consumeDreitonTransportDescriptorReply)((*dreiton).transportHandle, transportFrame)){
			jmp emergencyExit;
		}
		(*slot).dataStart = *dataStart;
		(*slot).dataSize = *dataSize;
		(*slot).headerOffset = (uint8 *)header - (uint8 *)*dataStart;
		(*slot).token = token;
		(*slot).frameSize = frameSize;
		if(dataStart != &(*slot).dataStart){
			*dataStart = NULL;
			*dataSize = 0;
		}
		dec *dataAllocated;
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			free(reply);
			ret false;
		}
		ret true;
	}
	#undef  STORAGE_METHOD
	#undef  SLOT_METHOD
	#undef  NONE_METHOD
}
RECOVERDREITONCACHEDREPLY(){
	DreitonCacheSlot *slot;
	uint32 slotToken;
	DreitonCacheStorageSlot *storageSlot;
	DreitonReply *reply;
	void *frame;
	void *header;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if(!token or !replyReturn){
		jmp emergencyExit;
	}
	slot = (*dreiton).replyCacheSlotStart + token % (*dreiton).replyCacheSlotSize;
	slotToken = (*slot).token;
	if(slotToken < token){
		jmp emergencyExit;
	}
	if(slotToken > token){
		if((*slot).dataSize){
			storageSlot = (*dreiton).replyCacheStorageSlotStart + (*dreiton).replyCacheStorageSlotAllocated;
			(*storageSlot).dataStart = (*slot).dataStart;
			(*storageSlot).dataSize = (*slot).dataSize;
			(*slot).dataSize = 0;
			inc (*dreiton).replyCacheStorageSlotAllocated;
		}
		*slotStatusReturn = false;
		success = true;
		jmp emergencyExit;
	}
	reply = malloc(sizeof(DreitonReply) + (*slot).frameSize * sizeof(uint8));
	if(!reply){
		jmp emergencyExit;
	}
	frame = (uint8 *)reply + sizeof(DreitonReply);
	header = (uint8 *)frame + (*slot).headerOffset;
	memcpy(frame, (*slot).dataStart, (*slot).frameSize * sizeof(uint8));
	(*reply).header = header;
	(*reply).frame = frame;
	*replyReturn = reply;
	storageSlot = (*dreiton).replyCacheStorageSlotStart + (*dreiton).replyCacheStorageSlotAllocated;
	(*storageSlot).dataStart = (*slot).dataStart;
	(*storageSlot).dataSize = (*slot).dataSize;
	(*slot).dataSize = 0;
	inc (*dreiton).replyCacheStorageSlotAllocated;
	*slotStatusReturn = true;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
WAKEUPDREITONREPLY(){
	DreitonClientTransportDescriptor *transportDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	success = false;
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).wakeUpDreitonTransportDescriptorReply){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).wakeUpDreitonTransportDescriptorReply)((*dreiton).transportHandle, status)){
		jmp emergencyExit;
	}
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
WAKEUPDREITONEVENT(){
	DreitonClientTransportDescriptor *transportDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	success = false;
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).wakeUpDreitonTransportDescriptorEvent){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).wakeUpDreitonTransportDescriptorEvent)((*dreiton).transportHandle, status)){
		jmp emergencyExit;
	}
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
DISCONNECTFROMDREITON(){
	DreitonClientTransportDescriptor *transportDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if(!(*dreiton).isRunning){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).disconnectFromDreitonTransportDescriptorConnection){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).disconnectFromDreitonTransportDescriptorConnection)((*dreiton).transportHandle, !(*dreiton).status)){
		jmp emergencyExit;
	}
	(*dreiton).clientUuid.uuid0 = 0;
	(*dreiton).clientUuid.uuid1 = 0;
	(*dreiton).currentToken = 0;
	(*dreiton).isRunning = false;
	(*dreiton).status = NONE_DREITON_TRANSPORT_STATUS;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
UNLOADDREITONCODEC(){
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if(!(*dreiton).codecDescriptorHandle){
		jmp emergencyExit;
	}
	if(dlclose((*dreiton).codecDescriptorHandle) != DLCLOSE_SUCCESS){
		jmp emergencyExit;
	}
	(*dreiton).codecDescriptorHandle = NULL;
	(*dreiton).codecDescriptor = NULL;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
UNLOADDREITONTRANSPORT(){
	DreitonClientTransportDescriptor *transportDescriptor;
	bool success;
	if(!dreiton){
		ret false;
	}
	success = false;
	if(!(*dreiton).transportDescriptorHandle){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreiton).transportDescriptor;
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if((*transportDescriptor).finiDreitonTransportDescriptorConnection){
		if(!(*(*transportDescriptor).finiDreitonTransportDescriptorConnection)((*dreiton).transportHandle)){
			jmp emergencyExit;
		}
	}
	(*dreiton).transportHandle = NULL;
	if(dlclose((*dreiton).transportDescriptorHandle) != DLCLOSE_SUCCESS){
		jmp emergencyExit;
	}
	(*dreiton).transportDescriptorHandle = NULL;
	(*dreiton).transportDescriptor = NULL;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
DREITONHASERROR(){
	if(!dreiton){
		ret false;
	}
	ret (*dreiton).status;
}
FINIDREITON(){
	DreitonCacheStorageSlot *storageSlotCurrent;
	DreitonCacheStorageSlot *storageSlotWall;
	DreitonCacheSlot *slotCurrent;
	DreitonCacheSlot *slotWall;
	if(!dreiton){
		ret false;
	}
	if((*dreiton).isRunning){
		if(!disconnectFromDreiton(dreiton)){
			ret false;
		}
	}
	if((*dreiton).codecDescriptorHandle){
		if(!unloadDreitonCodec(dreiton)){
			ret false;
		}
	}
	if((*dreiton).transportDescriptorHandle){
		if(!unloadDreitonTransport(dreiton)){
			ret false;
		}
	}
	storageSlotCurrent = (*dreiton).replyCacheStorageSlotStart;
	storageSlotWall = storageSlotCurrent + (*dreiton).replyCacheStorageSlotAllocated;
	slotCurrent = (*dreiton).replyCacheSlotStart;
	slotWall = slotCurrent + (*dreiton).replyCacheSlotSize;
	jmp freeStorageSlotLoop;
	freeStorageSlotLoop:{
		if(storageSlotCurrent < storageSlotWall){
			free((*storageSlotCurrent).dataStart);
			if((*slotCurrent).dataSize){
				free((*slotCurrent).dataStart);
			}
			inc slotCurrent;
			inc storageSlotCurrent;
			jmp freeStorageSlotLoop;
		}
		jmp freeSlotLoop;
	}
	freeSlotLoop:{
		if(slotCurrent < slotWall){
			if((*slotCurrent).dataSize){
				free((*slotCurrent).dataStart);
			}
			inc slotCurrent;
			jmp freeSlotLoop;
		}
		free((*dreiton).replyCacheSlotStart);
		(*dreiton).replyCacheSlotStart = NULL;
		(*dreiton).replyCacheSlotSize = 0;
		(*dreiton).replyCacheStorageSlotStart = NULL;
		(*dreiton).replyCacheStorageSlotSize = 0;
		(*dreiton).replyCacheStorageSlotAllocated = 0;
		ret true;
	}
}


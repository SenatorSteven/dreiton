#define _POSIX_C_SOURCE /*-*/ (200809L)

#include <signal.h>
#include <stdint.h>
#include <stdio.h>

#include "headers/cold/cold.hold"
#include "headers/dreiton-protocol.hold"
#include "headers/dreiton-transport.hold"
#include "headers/dreiton.hold"
#include "headers/dreiton-helpers.hold"
#include "headers/dreiton-base-extension.hold"
#include "headers/dreiton-base-extension-helpers.hold"
#include "headers/client.hold"

def struct{ /*! basic but pretty bad solution to the event problem. use a proper way to copy an event over regardless of payload size. */
	GenericDreitonEvent /*-*/ event;
	uint8 /*---------------*/ payload[256];
} EventContainer;

local Dreiton /*--------*/ _dreiton;
local Dreiton * /*------*/ dreiton;
local uint32 /*---------*/ dreitonBaseExtension;
local uint32 /*---------*/ dreitonBase1Extension;
local EventContainer /*-*/ eventContainer;

void signalHandler(const int signal){
	if(signal == SIGINT){
		fprintf(stdout, "\n");
	}
	if(signal == SIGPIPE){
		fprintf(stderr, "\tpipe error\n");
	}
	ret;
}
int main(void){
	{
		dreiton = &_dreiton;
		dreitonBaseExtension = 0;
		dreitonBase1Extension = 0;
	}
	/*!setSignals:*/{
		struct sigaction s;
		s.sa_handler = signalHandler;
		s.sa_flags = SA_RESTART;
		sigemptyset(&s.sa_mask);
		sigaction(SIGINT , &s, NULL);
		sigaction(SIGPIPE, &s, NULL);
	}
	initDreiton(dreiton);
	setDreitonServerChannelPath(dreiton, "/dev/shm/registration-form");
	if(!connectToDreiton(dreiton)){
		fprintf(stdout, "failed dreiton\n");
		ret 0;
	}
	{
		uint32 token;
		ClaimOwnershipDreitonReply claimOwnershipDreitonReply;
		requestDreitonClaimOwnership(dreiton, &token);
		flushDreitonBuffer(dreiton);
		waitForDreitonReply(dreiton, token, &claimOwnershipDreitonReply);
		if(claimOwnershipDreitonReply.reply.status & SUCCESS_DREITON_REPLY_STATUS){
			/*! requestDreitonCloseOnIdle(dreiton, &token); */
		}
		{
			#define PATH /*-*/ "/tmp/dreiton-base-extension/output/libdreiton-base-extension.so"
			EnableExtensionDreitonReply enableExtensionDreitonReply;
			requestDreitonEnableExtension(dreiton, lengthof(PATH) + 1, PATH, &token);
			flushDreitonBuffer(dreiton);
			waitForDreitonReply(dreiton, token, &enableExtensionDreitonReply);
			dreitonBaseExtension = enableExtensionDreitonReply.extension;
			#undef  PATH
		}
		{
			#define PATH /*-*/ "/tmp/dreiton-base1-extension/output/libdreiton-base1-extension.so"
			EnableExtensionDreitonReply enableExtensionDreitonReply;
			requestDreitonEnableExtension(dreiton, lengthof(PATH) + 1, PATH, &token);
			flushDreitonBuffer(dreiton);
			waitForDreitonReply(dreiton, token, &enableExtensionDreitonReply);
			dreitonBase1Extension = enableExtensionDreitonReply.extension;
			#undef  PATH
		}
		if(claimOwnershipDreitonReply.reply.status & SUCCESS_DREITON_REPLY_STATUS){
			requestDreitonSealOwnership(dreiton, &token);
			flushDreitonBuffer(dreiton);
		}
	}
	requestDreitonApplyForEvent(dreiton, dreitonBaseExtension, MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE_MASK, NULL);
	requestDreitonApplyForEvent(dreiton, dreitonBase1Extension, MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE_MASK, NULL);
	{
		const uint32 magicNumber = 123;
		uint32 token;
		GetMagicNumberDreitonBaseReply getMagicNumberDreitonBaseReply;
		requestDreitonBaseSetMagicNumber(dreiton, dreitonBaseExtension, magicNumber, NULL);
		requestDreitonBaseGetMagicNumber(dreiton, dreitonBaseExtension, &token);
		flushDreitonBuffer(dreiton);
		waitForDreitonBaseGetMagicNumberReply(dreiton, token, &getMagicNumberDreitonBaseReply);
		fprintf(stdout, "we got the %s number back (%u)\n", getMagicNumberDreitonBaseReply.magicNumber == magicNumber? "right" : "wrong", getMagicNumberDreitonBaseReply.magicNumber);
	}
	{
		const uint32 magicNumber = 1234;
		uint32 token;
		GetMagicNumberDreitonBaseReply getMagicNumberDreitonBaseReply;
		requestDreitonBaseSetMagicNumber(dreiton, dreitonBase1Extension, magicNumber, NULL);
		requestDreitonBaseGetMagicNumber(dreiton, dreitonBase1Extension, &token);
		flushDreitonBuffer(dreiton);
		waitForDreitonBaseGetMagicNumberReply(dreiton, token, &getMagicNumberDreitonBaseReply);
		fprintf(stdout, "we got the %s number back (%u)\n", getMagicNumberDreitonBaseReply.magicNumber == magicNumber? "right" : "wrong", getMagicNumberDreitonBaseReply.magicNumber);
		jmp eventLoop;
	}
	eventLoop:{
		flushDreitonBuffer(dreiton);
		if(!waitForDreitonEvent(dreiton, &eventContainer)){
			if((*dreiton).hasError){
				jmp emergencyExit;
			}
			jmp eventLoop;
		}
		if(!eventContainer.event.extension){
			jmp switchEvent;
		}
		if(eventContainer.event.extension == dreitonBaseExtension){
			jmp switchBaseExtensionEvent;
		}
		if(eventContainer.event.extension == dreitonBase1Extension){
			jmp switchBase1ExtensionEvent;
		}
		jmp eventLoop;
	}
	switchEvent:{
		switch(eventContainer.event.eventType){
			to NONE_DREITON_EVENT_TYPE: /*----------------------*/ fprintf(stdout, "got \"none\" event\n"); /*----------------------*/ jmp eventLoop;
			off: /*---------------------------------------------*/ fprintf(stdout, "got other event\n"); /*-------------------------*/ jmp eventLoop;
		}
	}
	switchBaseExtensionEvent:{
		switch(eventContainer.event.eventType){
			to NONE_DREITON_BASE_EVENT_TYPE: /*-----------------*/ fprintf(stdout, "got \"none\" base event\n"); /*-----------------*/ jmp eventLoop;
			to MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE: /*-*/ fprintf(stdout, "got \"magic number changed\" base event\n"); /*-*/ jmp magicNumberChangedEvent;
			off: /*---------------------------------------------*/ fprintf(stdout, "got other base event\n"); /*--------------------*/ jmp eventLoop;
		}
	}
	switchBase1ExtensionEvent:{
		switch(eventContainer.event.eventType){
			to NONE_DREITON_BASE_EVENT_TYPE: /*-----------------*/ fprintf(stdout, "got \"none\" base1 event\n"); /*-----------------*/ jmp eventLoop;
			to MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE: /*-*/ fprintf(stdout, "got \"magic number changed\" base1 event\n"); /*-*/ jmp magicNumberChangedEvent1;
			off: /*---------------------------------------------*/ fprintf(stdout, "got other base1 event\n"); /*--------------------*/ jmp eventLoop;
		}
	}
	magicNumberChangedEvent:{
		MagicNumberChangedDreitonBaseEvent *const event = (void *)&eventContainer;
		fprintf(stdout, "new magic number: %u\n", (*event).magicNumber);
		jmp eventLoop;
	}
	magicNumberChangedEvent1:{
		MagicNumberChangedDreitonBaseEvent *const event = (void *)&eventContainer;
		fprintf(stdout, "new magic number: %u\n", (*event).magicNumber);
		jmp eventLoop;
	}
	emergencyExit:{
		uint32 token;
		requestDreitonSync(dreiton, &token);
		flushDreitonBuffer(dreiton);
		waitForDreitonReply(dreiton, token, NULL);
		disconnectFromDreiton(dreiton);
		finiDreiton(dreiton);
		fprintf(stdout, "done\n");
		ret 0;
	}
}


#define _POSIX_C_SOURCE /*-*/ (200809L)

#define MAIN

#include <signal.h>
#include <stdint.h>
#include <stdio.h>

#include "../headers/cold/cold.hold"
#include "../headers/server-api.hold"
#include "../headers/server-extension-api.hold"
#include "../headers/systems/server-system.hold"
#include "../headers/systems/client-system.hold"

local ServerConnectionSystem /*-*/ serverConnectionSystem;

void signalHandler(const int signal){
	if(signal == SIGINT){
		fprintf(stdout, "\n");
	}
	if(signal == SIGPIPE){
		fprintf(stderr, "\tpipe error\n");
	}
	ret;
}
int main(void){
	uint32 token[10];
	/*!setSignals:*/{
		struct sigaction s;
		s.sa_handler = signalHandler;
		s.sa_flags = SA_RESTART;
		sigemptyset(&s.sa_mask);
		sigaction(SIGINT , &s, NULL);
		sigaction(SIGPIPE, &s, NULL);
	}



#ifdef a
	/*!blockAllSignals:*/{
		sigset_t signalSet;
		sigfillset(&signalSet);
		pthread_sigmask(SIG_BLOCK, &signalSet, NULL);
	}
#endif



	initServerConnection(&serverConnectionSystem);
	setServerConnectionServerChannelPath(&serverConnectionSystem, "/dev/shm/registration-form");
	if(!connectToServer(&serverConnectionSystem)){
		fprintf(stdout, "failed serverConnectionSystem\n");
		ret 0;
	}
	{
		uint i;
/*!
		SetMagicNumberRequest setMagicNumberRequest;
		setMagicNumberRequest.magicNumber = 123;
*/
		sendServerRequest(&serverConnectionSystem, ENABLE_EXTENSION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 0);
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 1);
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 2);
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 3);
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 4);
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 5);
		/*! sendServerRequest(&serverConnectionSystem, SET_MAGIC_NUMBER_SERVER_REQUEST_TYPE, 0, &setMagicNumberRequest, sizeof(SetMagicNumberRequest),  true, token + 5); */
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 6);
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 7);
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 8);
		/*! sendServerRequest(&serverConnectionSystem, GET_MAGIC_NUMBER_SERVER_REQUEST_TYPE, 0,                   NULL,                             0,  true, token + 9); */
		sendServerRequest(&serverConnectionSystem,     NO_OPERATION_SERVER_REQUEST_TYPE, 0,                   NULL,                             0, false, token + 9);
		flushServerBuffer(&serverConnectionSystem);
		for(i = 0; i < countof(token); inc i){
			uint ii = i;
			GenericReply genericReply;
			waitForServerReply(&serverConnectionSystem, *(token + ii), &genericReply);
			fprintf(stdout, "got response on %i\n", ii);
/*!
			if(genericReply.replyType == GET_MAGIC_NUMBER_SERVER_REPLY_TYPE){
				GetMagicNumberReply *const getMagicNumberReply = (void *)&genericReply;
				fprintf(stdout, "%u: value got: %u\n", ii, (*getMagicNumberReply).magicNumber);
			}
*/
		}
		jmp eventLoop;
	}
	eventLoop:{
		GenericEvent event;
		fprintf(stdout, "waiting on event\n");
		waitForServerEvent(&serverConnectionSystem, &event);
		if(!serverConnectionSystem.hasError){
			jmp eventLoop;
		}
		jmp emergencyExit;
	}
	emergencyExit:{
		uint32 token;
		fprintf(stdout, "leaving\n");
		sendServerRequest(&serverConnectionSystem, SYNC_SERVER_REQUEST_TYPE, 0, NULL, 0, true, &token);
		flushServerBuffer(&serverConnectionSystem);
		waitForServerReply(&serverConnectionSystem, token, NULL);
		disconnectFromServer(&serverConnectionSystem);
		finiServerConnection(&serverConnectionSystem);
		fprintf(stdout, "done\n");
		ret 0;
	}
}


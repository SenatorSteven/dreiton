
#ifdef a
#include <stdio.h>
#include <stdint.h>
#include "repositories/cold-repository/cold.hold"

int main(void){
	uint16 reply = 0;
	uint16 size = 128;
	uint16 highest = 0;
	for(;;){
		inc reply;
		if(!reply){
			inc reply;
		}
		if(reply >= size){
			reply = 1;
		}
		if(reply > highest or reply + size - 2 <= highest){
			highest = reply;
		}
		fprintf(stdout, "highest: %u\n", highest);
	}
	ret 0;
}
#endif

#ifdef a
	/*!blockAllSignals:*/{
		sigset_t signalSet;
		sigfillset(&signalSet);
		pthread_sigmask(SIG_BLOCK, &signalSet, NULL);
	}
#endif




























#define _POSIX_C_SOURCE /*-*/ (199506L)

#include <stdint.h>



/*! remove later */

#include <stdio.h>



#include "headers/cold/cold.hold"
#include "headers/signal-handler.hold"
#include "headers/protocols/dreiton-protocol.hold"
#include "headers/protocols/dreiton-transport-protocol.hold"
#include "headers/protocols/dreiton-codec-protocol.hold"
#include "headers/dreiton.hold"
#include "headers/dreiton-base-extension.hold"
#include "headers/helpers/dreiton-helpers.hold"
#include "headers/helpers/dreiton-base-extension-helpers.hold"
#include "headers/client.hold"

#define NONE_CONNECTION /*------------*/ (0)
#define SHM_CONNECTION /*-------------*/ (1)
#define TCP_CONNECTION /*-------------*/ (2)

#define TERMINATIONSIGNALHANDLER() /*-*/ local void  terminationSignalHandler(const int signal)
#define PIPESIGNALHANDLER() /*--------*/ local void  pipeSignalHandler(const int signal)
#define ISBIGENDIAN() /*--------------*/ local bool  isBigEndian(void)

TERMINATIONSIGNALHANDLER();
PIPESIGNALHANDLER();
ISBIGENDIAN();

local const char * /*---------*/ name;
local const char * /*---------*/ transport;
local const char * /*---------*/ codec;
local const char * /*---------*/ connectionName;
local pthread_t /*------------*/ thread;
local Dreiton /*--------------*/ dreiton;
local DreitonEvent * /*-------*/ event;
local DreitonEventHeader * /*-*/ eventHeader;

int main(const int argumentSize, const char *const *const argumentStart){
	uint8 type = SHM_CONNECTION;
	(void)argumentSize;
	(void)argumentStart;
	{
		event = NULL;
	}
	{
		SignalHandler signalHandler[5];
		SignalHandler *signalHandlerCurrent = signalHandler;
		(*signalHandlerCurrent).handler = &terminationSignalHandler;
		(*signalHandlerCurrent).signal = SIGHUP;
		(*signalHandlerCurrent).terminal = true;
		inc signalHandlerCurrent;
		(*signalHandlerCurrent).handler = &terminationSignalHandler;
		(*signalHandlerCurrent).signal = SIGINT;
		(*signalHandlerCurrent).terminal = true;
		inc signalHandlerCurrent;
		(*signalHandlerCurrent).handler = &terminationSignalHandler;
		(*signalHandlerCurrent).signal = SIGQUIT;
		(*signalHandlerCurrent).terminal = true;
		inc signalHandlerCurrent;
		(*signalHandlerCurrent).handler = &pipeSignalHandler;
		(*signalHandlerCurrent).signal = SIGPIPE;
		(*signalHandlerCurrent).terminal = false;
		inc signalHandlerCurrent;
		(*signalHandlerCurrent).handler = &terminationSignalHandler;
		(*signalHandlerCurrent).signal = SIGTERM;
		(*signalHandlerCurrent).terminal = true;
		inc signalHandlerCurrent;
		bootSignalThread(countof(signalHandler), signalHandler, &thread);
	}
	initDreiton(&dreiton);
	if(type == SHM_CONNECTION){
		name = "shm";
		transport = "libdreiton-shm-transport.so";
		connectionName = "/tmp/dreiton-one";
	}else{
		name = "tcp";
		transport = "libdreiton-tcp-transport.so";
		connectionName = "127.0.0.1:23170";
	}
	{
		const bool hostIsBigEndian = isBigEndian();
		const bool protocolIsBigEndian = DREITON_ENDIANNESS == BIG_DREITON_ENDIANNESS;
		const bool differentEndianness = !hostIsBigEndian != !protocolIsBigEndian;
		if(differentEndianness){
			codec = "libdreiton-endian-codec.so";
		}else{
			codec = "libdreiton-xyz-codec.so";
		}
	}
	setDreitonReplyCacheSlotSize(&dreiton, 3);
	if(!loadDreitonTransport(&dreiton, transport)){
		fprintf(stdout, "could not load transport @ %s\n", transport);
		jmp emergencyExit;
	}
	fprintf(stdout, "using transport @ %s\n", transport);
	if(!loadDreitonCodec(&dreiton, codec)){
		fprintf(stdout, "could not load codec @ %s\n", codec);
		jmp emergencyExit;
	}
	fprintf(stdout, "using codec @ %s\n", codec);
	if(!connectToDreiton(&dreiton, connectionName)){
		fprintf(stdout, "could not connect to %s server @ %s\n", name, connectionName);
		jmp emergencyExit;
	}
	fprintf(stdout, "connected to %s server @ %s\n\n", name, connectionName);
	{
		uint32 token = 0;
		EnableExtensionDreitonReply *reply = NULL;
		requestDreitonBaseEnableExtension(&dreiton, &token);
		flushDreitonBuffer(&dreiton);
		waitForDreitonBaseEnableExtensionReply(&dreiton, token, &reply);
		free(reply);
	}
	requestDreitonBaseApplyForEvent(&dreiton, MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE_MASK, NULL);
	{
		const uint32 magicNumber = 113;
		uint32 token[10];
		GetMagicNumberDreitonBaseReply *reply;
		requestDreitonBaseGetMagicNumber(&dreiton, token + 0);
		requestDreitonBaseSetMagicNumber(&dreiton, magicNumber, token + 1);
		flushDreitonBuffer(&dreiton);
		{
			int i = 1;
			while(i >= 0){
				fprintf(stdout, "waiting on reply %u\n", *(token + i));
				if(waitForDreitonReply(&dreiton, *(token + i), &reply)){
					fprintf(stdout, "++++++++++++++++++++reply came in for %u\n", *(token + i));
					free(reply);
				}else{
					fprintf(stdout, "--------------------reply did not come for %u\n", *(token + i));
				}
				dec i;
			}
		}
		requestDreitonBaseGetMagicNumber(&dreiton, token + 2);
		requestDreitonBaseSetMagicNumber(&dreiton, magicNumber, token + 3);
		requestDreitonBaseGetMagicNumber(&dreiton, token + 4);
		requestDreitonBaseSetMagicNumber(&dreiton, magicNumber, token + 5);
		requestDreitonBaseGetMagicNumber(&dreiton, token + 6);
		requestDreitonBaseSetMagicNumber(&dreiton, magicNumber, token + 7);
		requestDreitonBaseGetMagicNumber(&dreiton, token + 8);
		requestDreitonBaseSetMagicNumber(&dreiton, magicNumber, token + 9);
		flushDreitonBuffer(&dreiton);
		fprintf(stdout, "waiting on replies [%u, %u]\n", *(token + 1), *(token + 9));
		{
			int i = countof(token) - 2;
			while(i >= 2){
				fprintf(stdout, "waiting on reply %u\n", *(token + i));
				if(waitForDreitonReply(&dreiton, *(token + i), &reply)){
					uint16 type = (*(*reply).header).type;
					fprintf(stdout, "++++++++++++++++++++reply came in for %u with type %u\n", *(token + i), type);
					free(reply);
				}else{
					fprintf(stdout, "--------------------reply did not come for %u\n", *(token + i));
				}
				dec i;
			}
		}
#ifdef a
		if(waitForDreitonReply(&dreiton, *(token + 0), &reply)){
			/*! uint32 number;
			fprintf(stdout, "get number said %u\n", getDreitonBaseGetMagicNumberReplyMagicNumber(&dreiton, reply, &number)); */
			fprintf(stdout, "reply came in for %u\n", *(token + 0));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 1));
		if(waitForDreitonReply(&dreiton, *(token + 1), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 1));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 2));
		if(waitForDreitonReply(&dreiton, *(token + 2), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 2));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 3));
		if(waitForDreitonReply(&dreiton, *(token + 3), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 3));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 4));
		if(waitForDreitonReply(&dreiton, *(token + 4), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 4));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 5));
		if(waitForDreitonReply(&dreiton, *(token + 5), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 5));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 6));
		if(waitForDreitonReply(&dreiton, *(token + 6), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 6));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 7));
		if(waitForDreitonReply(&dreiton, *(token + 7), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 7));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 8));
		if(waitForDreitonReply(&dreiton, *(token + 8), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 8));
			free(reply);
		}
		fprintf(stdout, "waiting on reply %u\n", *(token + 9));
		if(waitForDreitonReply(&dreiton, *(token + 9), &reply)){
			fprintf(stdout, "reply came in for %u\n", *(token + 9));
			free(reply);
		}
#endif
		fprintf(stdout, "done with replies\n");
	}
	jmp eventLoop;
	eventLoop:{
		uint32 extension;
		flushDreitonBuffer(&dreiton);
		free(event);
		event = NULL;
		if(!waitForDreitonEvent(&dreiton, &event)){
			if(dreitonHasError(&dreiton)){
				printDreitonConnectionError(&dreiton);
				jmp emergencyExit;
			}
			jmp eventLoop;
		}
		eventHeader = (*event).header;
		extension = (*eventHeader).extension;
		if(!extension){
			jmp switchEvent;
		}
		if(IS_DREITON_BASE_EXTENSION_EVENT(extension)){
			jmp switchBaseExtensionEvent;
		}
		jmp eventLoop;
	}
	switchEvent:{
		printDreitonEvent(event);
		switch((*eventHeader).type){
			to NONE_DREITON_EVENT_TYPE: /*----------------------*/ jmp errorEvent;
			off: /*---------------------------------------------*/ jmp eventLoop;
		}
	}
	switchBaseExtensionEvent:{
		printDreitonBaseEvent(event);
		switch((*eventHeader).type){
			to NONE_DREITON_BASE_EVENT_TYPE: /*-----------------*/ jmp errorBaseEvent;
			to MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE: /*-*/ jmp magicNumberChangedBaseEvent;
			off: /*---------------------------------------------*/ jmp eventLoop;
		}
	}
	errorEvent:{
		printDreitonError((void *)event);
		jmp eventLoop;
	}
	errorBaseEvent:{
		printDreitonBaseError((void *)event);
		jmp eventLoop;
	}
	magicNumberChangedBaseEvent:{
		uint32 magicNumber;
		getDreitonBaseMagicNumberChangedEventMagicNumber(&dreiton, event, &magicNumber);
		fprintf(stdout, "\t/// magic number changed event ///////////////////////\n");
		fprintf(stdout, "\t\tnew magic number: %u\n", magicNumber);
		fprintf(stdout, "\t//////////////////////////////////////////////////////\n\n");
		jmp eventLoop;
	}
	emergencyExit:{
		uint32 token = 0;
		DreitonReply *reply = NULL;
		requestDreitonSync(&dreiton, &token);
		flushDreitonBuffer(&dreiton);
		waitForDreitonReply(&dreiton, token, &reply);
		free(reply);
		disconnectFromDreiton(&dreiton);
		unloadDreitonCodec(&dreiton);
		unloadDreitonTransport(&dreiton);
		finiDreiton(&dreiton);
		pthread_kill(thread, SIGTERM);
		pthread_join(thread, NULL);
		ret 0;
	}
}
TERMINATIONSIGNALHANDLER(){
	(void)signal;
	wakeUpDreitonReply(&dreiton, EXIT_DREITON_TRANSPORT_STATUS);
	wakeUpDreitonEvent(&dreiton, EXIT_DREITON_TRANSPORT_STATUS);
	ret;
}
PIPESIGNALHANDLER(){
	(void)signal;
	fprintf(stderr, "\tpipe error\n");
	ret;
}
ISBIGENDIAN(){
	const uint32 variable = 1;
	ret *(uint8 *)&variable == 0;
}


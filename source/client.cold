#define _POSIX_C_SOURCE /*-*/ (200809L)

#include <signal.h>
#include <stdint.h>
#include <stdio.h>

#include "headers/cold/cold.hold"
#include "headers/client-api.hold"
#include "headers/server-api.hold"
#include "headers/base-server-extension.hold"
#include "headers/systems/server-system.hold"
#include "headers/systems/client-system.hold"

local ServerConnectionSystem /*---*/ _serverConnectionSystem;
local ServerConnectionSystem * /*-*/ serverConnectionSystem;
local GenericEvent /*-------------*/ event;
local uint32 /*-------------------*/ baseServerExtensionId;



bool requestServerNoOperation(ServerConnectionSystem *const serverConnectionSystem, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, NO_OPERATION_SERVER_REQUEST_TYPE, 0, NULL, NO_OPERATION_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerSync(ServerConnectionSystem *const serverConnectionSystem, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, SYNC_SERVER_REQUEST_TYPE, 0, NULL, SYNC_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestServerEnableExtension(ServerConnectionSystem *const serverConnectionSystem, const uint32 pathSize, const char *const pathStart, uint32 *const tokenReturn){
	EnableExtensionServerRequest enableExtensionServerRequest;
	enableExtensionServerRequest.pathSize = pathSize;
	enableExtensionServerRequest.pathStart = (void *)pathStart;
	ret sendServerRequest(serverConnectionSystem, ENABLE_EXTENSION_SERVER_REQUEST_TYPE, NONE_SERVER_EXTENSION, &enableExtensionServerRequest, ENABLE_EXTENSION_SERVER_REQUEST_ITEM_AMOUNT, tokenReturn);
}
inline bool waitForServerNoOperationReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, NoOperationServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerSyncReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, SyncServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForServerEnableExtensionReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, EnableExtensionServerReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}



bool requestBaseGetMagicNumber(ServerConnectionSystem *const serverConnectionSystem, const uint32 extensionId, uint32 *const tokenReturn){
	ret sendServerRequest(serverConnectionSystem, GET_MAGIC_NUMBER_BASE_REQUEST_TYPE, extensionId, NULL, GET_MAGIC_NUMBER_BASE_REQUEST_ITEM_AMOUNT, tokenReturn);
}
bool requestBaseSetMagicNumber(ServerConnectionSystem *const serverConnectionSystem, const uint32 extensionId, const uint32 magicNumber, uint32 *const tokenReturn){
	SetMagicNumberBaseRequest setMagicNumberBaseRequest;
	setMagicNumberBaseRequest.magicNumberSize = sizeof(uint32);
	setMagicNumberBaseRequest.magicNumberStart = (void *)&magicNumber;
	ret sendServerRequest(serverConnectionSystem, SET_MAGIC_NUMBER_BASE_REQUEST_TYPE, extensionId, &setMagicNumberBaseRequest, SET_MAGIC_NUMBER_BASE_REQUEST_ITEM_AMOUNT, tokenReturn);
}
inline bool waitForBaseGetMagicNumberReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, GetMagicNumberBaseReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}
inline bool waitForBaseSetMagicNumberReply(ServerConnectionSystem *const serverConnectionSystem, const uint32 token, SetMagicNumberBaseReply *const reply){
	ret waitForServerReply(serverConnectionSystem, token, reply);
}



void signalHandler(const int signal){
	if(signal == SIGINT){
		fprintf(stdout, "\n");
	}
	if(signal == SIGPIPE){
		fprintf(stderr, "\tpipe error\n");
	}
	ret;
}
int main(void){
	{
		serverConnectionSystem = &_serverConnectionSystem;
		baseServerExtensionId = 0;
	}
	/*!setSignals:*/{
		struct sigaction s;
		s.sa_handler = signalHandler;
		s.sa_flags = SA_RESTART;
		sigemptyset(&s.sa_mask);
		sigaction(SIGINT , &s, NULL);
		sigaction(SIGPIPE, &s, NULL);
	}
	initServerConnection(serverConnectionSystem);
	setServerConnectionServerChannelPath(serverConnectionSystem, "/dev/shm/registration-form");
	if(!connectToServer(serverConnectionSystem)){
		fprintf(stdout, "failed serverConnectionSystem\n");
		ret 0;
	}



	{
		uint32 token;
		ClaimOwnershipServerReply claimOwnershipServerReply;
		sendServerRequest(serverConnectionSystem, CLAIM_OWNERSHIP_SERVER_REQUEST_TYPE, 0, NULL, CLAIM_OWNERSHIP_SERVER_REQUEST_ITEM_AMOUNT, &token);
		flushServerBuffer(serverConnectionSystem);
		waitForServerReply(serverConnectionSystem, token, &claimOwnershipServerReply);
		if(claimOwnershipServerReply.reply.status & SUCCESS_REPLY_STATUS){
			#define PATH /*-*/ "/tmp/base-server-extension/output/base-server-extension.so"
			EnableExtensionServerReply enableExtensionServerReply;
			fprintf(stdout, "\nentering the owner seat...\n");
			sendServerRequest(serverConnectionSystem, CLOSE_ON_IDLE_SERVER_REQUEST_TYPE, 0, NULL, CLOSE_ON_IDLE_SERVER_REQUEST_ITEM_AMOUNT, NULL);
			requestServerEnableExtension(serverConnectionSystem, lengthof(PATH) + 1, PATH, &token);
			flushServerBuffer(serverConnectionSystem);
			waitForServerReply(serverConnectionSystem, token, &enableExtensionServerReply);
			baseServerExtensionId = enableExtensionServerReply.extensionId;
			fprintf(stdout, "extension id @ %u\n", baseServerExtensionId);
			sendServerRequest(serverConnectionSystem, SEAL_OWNERSHIP_SERVER_REQUEST_TYPE, 0, NULL, SEAL_OWNERSHIP_SERVER_REQUEST_ITEM_AMOUNT, NULL);
			flushServerBuffer(serverConnectionSystem);
			fprintf(stdout, "done\n");
			#undef  PATH
		}
	}



	{
		const uint32 magicNumber = 123;
		uint32 token;
		GetMagicNumberBaseReply getMagicNumberBaseReply;
		requestBaseSetMagicNumber(serverConnectionSystem, baseServerExtensionId, magicNumber, NULL);
		requestBaseGetMagicNumber(serverConnectionSystem, baseServerExtensionId, &token);
		flushServerBuffer(serverConnectionSystem);
		waitForBaseGetMagicNumberReply(serverConnectionSystem, token, &getMagicNumberBaseReply);
		fprintf(stdout, "we got the %s number back\n", getMagicNumberBaseReply.magicNumber == magicNumber? "right" : "wrong");
		jmp eventLoop;
	}
	eventLoop:{
		fprintf(stdout, "waiting on event\n");
		flushServerBuffer(serverConnectionSystem);
		if(!waitForServerEvent(serverConnectionSystem, &event)){
			fprintf(stdout, "wait for server event woke\n");
			if((*serverConnectionSystem).hasError){
				jmp emergencyExit;
			}
			jmp eventLoop;
		}
		fprintf(stdout, "wait for server event woke\n");
		jmp switchEvent;
	}
	switchEvent:{
		switch(event.eventType){
			to NONE_SERVER_EVENT_TYPE: /*-*/ jmp eventLoop;
			off: /*-----------------------*/ jmp eventLoop;
		}
	}
	emergencyExit:{
		uint32 token;
		requestServerSync(serverConnectionSystem, &token);
		flushServerBuffer(serverConnectionSystem);
		waitForServerReply(serverConnectionSystem, token, NULL);
		disconnectFromServer(serverConnectionSystem);
		finiServerConnection(serverConnectionSystem);
		fprintf(stdout, "done\n");
		ret 0;
	}
}


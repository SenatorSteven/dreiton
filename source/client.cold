
#ifdef a
#include <stdio.h>
#include <stdint.h>
#include "../../repositories/cold-repository/cold.hold"

int main(void){
	uint16 reply = 0;
	uint16 size = 128;
	uint16 highest = 0;
	for(;;){
		inc reply;
		if(!reply){
			inc reply;
		}
		if(reply >= size){
			reply = 1;
		}
		if(reply > highest or reply + size - 2 <= highest){
			highest = reply;
		}
		fprintf(stdout, "highest: %u\n", highest);
	}
	ret 0;
}
#endif

/*!
	consider everything multithreaded later, inluding who is epoll_wait()'ing what.
*/

/*!
	when writing the protocol for events/replies, keep replies lossless and events lossy. if the buffer fills up, lose events but do not lose replies.
*/

/*!
	facilitate a no-copying style of reply handling where the index is incremented on command after a separate function is called.
*/




























LOADDREITONCORETRANSPORT(){
	void *transportDescriptorHandle;
	DreitonServerTransportDescriptor *transportDescriptor;
	bool success;
	if(!dreitonCore){
		ret false;
	}
	success = false;
	if((*dreitonCore).transportDescriptor or !path){
		jmp emergencyExit;
	}
	transportDescriptorHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
	if(!transportDescriptorHandle){
		jmp emergencyExit;
	}
	transportDescriptor = dlsym(transportDescriptorHandle, "dreitonServerTransportDescriptor");
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).initDreitonTransportDescriptor){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).initDreitonTransportDescriptor)(&(*dreitonCore).transportHandle)){
		jmp emergencyExit;
	}
	(*dreitonCore).transportDescriptorHandle = transportDescriptorHandle;
	(*dreitonCore).transportDescriptor = transportDescriptor;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
LOADDREITONCORECONDITIONALCODEC(){
	const uint32 variable = 1;
	if(*(uint8 *)&variable != (DREITON_ENDIANNESS == LITTLE_DREITON_ENDIANNESS)){
		path = endianPath;
	}
	ret loadDreitonCoreCodec(dreitonCore, path);
}
LOADDREITONCORECODEC(){
	void *codecDescriptorHandle;
	DreitonCodecDescriptor *codecDescriptor;
	bool success;
	if(!dreitonCore){
		ret false;
	}
	success = false;
	if((*dreitonCore).codecDescriptor or !path){
		jmp emergencyExit;
	}
	codecDescriptorHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
	if(!codecDescriptorHandle){
		jmp emergencyExit;
	}
	codecDescriptor = dlsym(codecDescriptorHandle, "dreitonCodecDescriptor");
	if(!codecDescriptor){
		jmp emergencyExit;
	}
	(*dreitonCore).codecDescriptorHandle = codecDescriptorHandle;
	(*dreitonCore).codecDescriptor = codecDescriptor;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

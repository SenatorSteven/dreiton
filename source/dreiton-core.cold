#define DLCLOSE_SUCCESS /*-*/ (0)

INITDREITONCORE(){
	if(!dreitonCore){
		ret false;
	}
	(*dreitonCore).transportDescriptorHandle = NULL;
	(*dreitonCore).transportDescriptor = NULL;
	(*dreitonCore).transportHandle = NULL;
	(*dreitonCore).codecDescriptorHandle = NULL;
	(*dreitonCore).codecDescriptor = NULL;
	(*dreitonCore).clientStart = NULL;
	(*dreitonCore).clientSize = 0;
	(*dreitonCore).clientAllocated = 0;
	(*dreitonCore).clientBlockSize = 0;
	(*dreitonCore).extensionStart = NULL;
	(*dreitonCore).extensionSize = 0;
	(*dreitonCore).extensionAllocated = 0;
	(*dreitonCore).extensionBlockSize = 0;
	(*dreitonCore).eventStart = NULL;
	(*dreitonCore).eventSize = 0;
	(*dreitonCore).eventAllocated = 0;
	(*dreitonCore).baseEvent = 0;
	(*dreitonCore).requestReceiverCreated = false;
	(*dreitonCore).eventReceiverCreated = false;
	(*dreitonCore).registrationReceiverCreated = false;
	ret true;
}
SETDREITONCORECLIENTBLOCKSIZE(){
	bool success;
	if(!dreitonCore){
		ret false;
	}
	success = false;
	if(clientBlockSize == (*dreitonCore).clientBlockSize){
		jmp emergencyExit;
	}
	(*dreitonCore).clientBlockSize = clientBlockSize;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

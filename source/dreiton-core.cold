REMOVEALLDREITONCOREEXTENSIONS(){
	uint current;
	uint wall;
	bool success;
	if(!dreitonCore){
		ret false;
	}
	if(!(*dreitonCore).extensionStart and !(*dreitonCore).extensionSize and !(*dreitonCore).extensionAllocated){
		ret false;
	}
	current = 1;
	wall = (*dreitonCore).extensionAllocated;
	success = false;
	jmp removeDreitonCoreExtensionLoop;
	removeDreitonCoreExtensionLoop:{
		if(current < wall){
			unloadDreitonCoreExtension(dreitonCore, current, true);
			success = true;
			inc current;
			jmp removeDreitonCoreExtensionLoop;
		}
		jmp emergencyExit;
	}
	emergencyExit:{
		free((*dreitonCore).extensionStart);
		(*dreitonCore).extensionStart = NULL;
		(*dreitonCore).extensionSize = 0;
		(*dreitonCore).extensionAllocated = 0;
		if(!success){
			ret false;
		}
		ret true;
	}
}
ISVALIDDREITONCORECLIENT(){
	if(!dreitonCore){
		ret false;
	}
	if(client <= (*dreitonCore).clientStart or client >= (*dreitonCore).clientStart + (*dreitonCore).clientAllocated or !(*client).clientId){
		ret false;
	}
	ret true;
}
ISVALIDDREITONCOREEXTENSION(){
	if(!dreitonCore){
		ret false;
	}
	if(!extension or extension >= (*dreitonCore).extensionAllocated or !(*((*dreitonCore).extensionStart + extension)).extensionHandle){
		ret false;
	}
	ret true;
}
FINDDREITONCORECLIENTFD(){
	DreitonCoreClient *current;
	DreitonCoreClient *wall;
	if(!dreitonCore){
		ret NULL;
	}
	if(!(*dreitonCore).clientAllocated or !fd){
		ret NULL;
	}
	current = (*dreitonCore).clientStart + 1;
	wall = current + (*dreitonCore).clientAllocated;
	jmp findServerClientFdLoop;
	findServerClientFdLoop:{
		if(current < wall){
			if((*current).requestReadFd == fd and (*current).clientId){
				ret current;
			}
			inc current;
			jmp findServerClientFdLoop;
		}
		ret NULL;
	}
}
FINDDREITONCORECLIENTFDID(){
	DreitonCoreClient *client;
	if(!dreitonCore){
		ret NULL;
	}
	if(!fd or id >= (*dreitonCore).clientAllocated){ /*! update later when data types are added */
		ret NULL;
	}
	client = (*dreitonCore).clientStart + id;
	if(!(*client).clientId or (*client).requestReadFd != fd){
		ret NULL;
	}
	ret client;
}
FINIDREITONCORE(){
	if(!dreitonCore){
		ret false;
	}









	/*!*/

	if((*dreitonCore).registrationEventFd){
		close((*dreitonCore).registrationEventFd);
		(*dreitonCore).registrationEventFd = 0;
	}
	if((*dreitonCore).registrationEpollFd){
		close((*dreitonCore).registrationEpollFd);
		(*dreitonCore).registrationEpollFd = 0;
	}
	if((*dreitonCore).replyEventFd){
		close((*dreitonCore).replyEventFd);
		(*dreitonCore).replyEventFd = 0;
	}
	*((*dreitonCore).fdCopy + 0) = 0;
	*((*dreitonCore).fdCopy + 1) = 0;
	*((*dreitonCore).fdCopy + 2) = 0;









	if((*dreitonCore).registrationLoopThreadCreated){
		quitDreitonCoreRegistrationLoopThread(dreitonCore);
		pthread_join((*dreitonCore).registrationLoopThread, NULL);
		(*dreitonCore).registrationLoopThreadCreated = false;
	}
	if((*dreitonCore).eventLoopThreadCreated){
		quitDreitonCoreEventLoopThread(dreitonCore);
		pthread_join((*dreitonCore).eventLoopThread, NULL);
		(*dreitonCore).eventLoopThreadCreated = false;
	}
	if((*dreitonCore).replyLoopThreadCreated){
		quitDreitonCoreReplyLoopThread(dreitonCore);
		pthread_join((*dreitonCore).replyLoopThread, NULL);
		(*dreitonCore).replyLoopThreadCreated = false;
	}
	(*dreitonCore).registrationLoopRunning = false;
	(*dreitonCore).eventLoopRunning = false;
	(*dreitonCore).replyLoopRunning = false;



	/*! should someone else be responsible for these? namely the functions dealing with this stuff */

	if((*dreitonCore).signalEventFd){
		close((*dreitonCore).signalEventFd); /*! on signal interrupt? */ /*! errors? */
		(*dreitonCore).signalEventFd = 0;
	}

	/*!*/

#ifdef a
	int32 /*--------*/ replyEpollFd;
	int32 /*--------*/ eventReplyEpollFd;
	int32 /*--------*/ signalEventFd;
	uint32 /*-------*/ clientId;
#endif



	(*dreitonCore).baseEvent = 0;
	free((*dreitonCore).eventStart);
	(*dreitonCore).eventStart = NULL;
	(*dreitonCore).eventSize = 0;
	(*dreitonCore).eventAllocated = 0;



	(*dreitonCore).extensionBlockSize = 0;



	removeAllDreitonCoreExtensions(dreitonCore);



	(*dreitonCore).clientBlockSize = 0;



	removeAllDreitonCoreClients(dreitonCore);

	/*!*/



	(*dreitonCore).database = NULL;
	(*dreitonCore).clientChannelPath = NULL;
	(*dreitonCore).serverChannelPath = NULL;
	ret true;
}


INSERTDREITONCORECLIENT(){
	DreitonServerTransportDescriptor *transportDescriptor;
	DreitonCoreClient *client;
	bool success;
	if(!dreitonCore){
		ret false;
	}
	success = false;
	if(!transportId or dataSize != sizeof(DreitonCoreUuid) or !dataStart){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreitonCore).transportDescriptor;
	if(!transportDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).setDreitonTransportDescriptorClientHandle){
		jmp emergencyExit;
	}
	jmp insertClient;
	insertClient:{
		if((*dreitonCore).clientAllocated == (*dreitonCore).clientSize){
			void *temp;
			if(!(*dreitonCore).clientBlockSize){
				jmp emergencyExit;
			}
			(*dreitonCore).clientSize += (*dreitonCore).clientBlockSize;
			temp = realloc((*dreitonCore).clientStart, (*dreitonCore).clientSize * sizeof(DreitonCoreClient));
			if(!temp){
				(*dreitonCore).clientSize -= (*dreitonCore).clientBlockSize;
				jmp emergencyExit;
			}
			(*dreitonCore).clientStart = temp;
			if(!(*dreitonCore).clientAllocated){
				inc (*dreitonCore).clientAllocated;
				jmp insertClient;
			}
		}
		client = (*dreitonCore).clientStart + (*dreitonCore).clientAllocated;
		if(!(*(*transportDescriptor).setDreitonTransportDescriptorClientHandle)((*dreitonCore).transportHandle, transportId, (*dreitonCore).clientAllocated)){
			jmp emergencyExit;
		}
		(*client).clientId = (*dreitonCore).clientAllocated;
		(*client).transportId = transportId;
		(*client).clientUuid.uuid0 = *((uint64 *)dataStart + 0);
		(*client).clientUuid.uuid1 = *((uint64 *)dataStart + 1);
		(*client).subscriptionStart = NULL;
		(*client).eventOffsetStart = NULL;
		(*client).subscriptionSize = 0;
		(*client).subscriptionAllocated = 0;
		(*client).eventOffsetSize = 0;
		inc (*dreitonCore).clientAllocated;
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
DECODEDREITONCOREREQUEST(){
	DreitonServerTransportDescriptor *transportDescriptor;
	DreitonCodecDescriptor *codecDescriptor;
	void *frame;
	void *header;
	bool success;
	if(!dreitonCore){
		ret false;
	}
	success = false;
	if(!isValidDreitonCoreClient(dreitonCore, client) or !requestReturn){
		jmp emergencyExit;
	}
	transportDescriptor = (*dreitonCore).transportDescriptor;
	codecDescriptor = (*dreitonCore).codecDescriptor;
	if(!transportDescriptor or !codecDescriptor){
		jmp emergencyExit;
	}
	if(!(*transportDescriptor).getDreitonTransportDescriptorClientRequestFrame or !(*codecDescriptor).decodeDreitonCodecMessage){
		jmp emergencyExit;
	}
	if(!(*(*transportDescriptor).getDreitonTransportDescriptorClientRequestFrame)((*dreitonCore).transportHandle, (*client).transportId, &frame)){
		jmp emergencyExit;
	}
	if(!(*(*codecDescriptor).decodeDreitonCodecMessage)(frame, frame, &header)){
		jmp emergencyExit;
	}
	(*requestReturn).header = header;
	(*requestReturn).frame = frame;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}

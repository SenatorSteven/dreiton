FINDDREITONCORECLIENTID(){
	DreitonCoreClient *client;
	if(!dreitonCore){
		ret false;
	}
	if(!clientReturn){
		ret false;
	}
	if(!clientId or clientId >= (*dreitonCore).clientAllocated){
		ret false;
	}
	client = (*dreitonCore).clientStart + clientId;
	if(clientId != (*client).clientId){
		ret false;
	}
	*clientReturn = client;
	ret true;
}
ISVALIDDREITONCORECLIENT(){
	if(!dreitonCore){
		ret false;
	}
	if(client <= (*dreitonCore).clientStart or client >= (*dreitonCore).clientStart + (*dreitonCore).clientAllocated or !(*client).clientId){
		ret false;
	}
	ret true;
}
ISVALIDDREITONCOREEXTENSION(){
	if(!dreitonCore){
		ret false;
	}
	if(!extensionId or extensionId >= (*dreitonCore).extensionAllocated or !(*((*dreitonCore).extensionStart + extensionId)).extensionDescriptorHandle){
		ret false;
	}
	ret true;
}



























/*!*/

FINIDREITONCORE(){
	if(!dreitonCore){
		ret false;
	}
	{
		DreitonCoreClient *current = (*dreitonCore).clientStart + 1;
		DreitonCoreClient *wall = (*dreitonCore).clientStart + (*dreitonCore).clientAllocated;
		jmp loop0;
		loop0:{
			if(current < wall){
				DreitonCoreClient *client = current;
				if(isValidDreitonCoreClient(dreitonCore, client)){
					DreitonCoreClientSubscription *current = (*client).subscriptionStart;
					DreitonCoreClientSubscription *const wall = current + (*client).subscriptionAllocated;
					jmp unsubscribeEventLoop;
					unsubscribeEventLoop:{
						if(current < wall){
							const uint32 eventMask = 1 << ((*current).eventType - (*((*dreitonCore).extensionStart + (*current).eventExtensionId)).extensionBaseEvent - 1);
							unsubscribeFromDreitonCoreEvent(dreitonCore, client, (*current).eventExtensionId, eventMask);
							inc current;
							jmp unsubscribeEventLoop;
						}
						free((*client).subscriptionStart);
						free((*client).eventOffsetStart);
					}
					(*client).clientId = 0;
				}
				inc current;
				jmp loop0;
			}
		}
	}
	{
		uint32 current = 1;
		uint32 wall = (*dreitonCore).extensionAllocated;
		jmp loop1;
		loop1:{
			if(current < wall){
				unloadDreitonCoreExtension(dreitonCore, current, true);
				inc current;
				jmp loop1;
			}
		}
	}
	if((*dreitonCore).registrationReceiverCreated){
		if(!destroyDreitonCoreTransportRegistrationReceiver(dreitonCore)){
			ret false;
		}
	}
	if((*dreitonCore).requestReceiverCreated){
		if(!destroyDreitonCoreTransportRequestReceiver(dreitonCore)){
			ret false;
		}
	}
	if((*dreitonCore).eventReceiverCreated){
		if(!destroyDreitonCoreTransportEventReceiver(dreitonCore)){
			ret false;
		}
	}
	if((*dreitonCore).codecDescriptor){
		if(!unloadDreitonCoreCodec(dreitonCore)){
			ret false;
		}
	}
	if((*dreitonCore).transportDescriptor){
		if(!unloadDreitonCoreTransport(dreitonCore)){
			ret false;
		}
	}
	(*dreitonCore).baseEvent = 0;
	free((*dreitonCore).eventStart);
	(*dreitonCore).eventStart = NULL;
	(*dreitonCore).eventSize = 0;
	(*dreitonCore).eventAllocated = 0;
	(*dreitonCore).extensionBlockSize = 0;
	free((*dreitonCore).extensionStart);
	(*dreitonCore).extensionStart = NULL;
	(*dreitonCore).extensionSize = 0;
	(*dreitonCore).extensionAllocated = 0;
	(*dreitonCore).clientBlockSize = 0;
	free((*dreitonCore).clientStart);
	(*dreitonCore).clientStart = NULL;
	(*dreitonCore).clientSize = 0;
	(*dreitonCore).clientAllocated = 0;
	ret true;
}


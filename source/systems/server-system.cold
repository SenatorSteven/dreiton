INITSERVERSYSTEM(){
	if(!serverSystem){
		ret false;
	}
	(*serverSystem).serverChannelPath = NULL;
	(*serverSystem).clientChannelPath = NULL;
	(*serverSystem).serverExtensionStart = NULL;
	(*serverSystem).serverExtensionSize = 0;
	(*serverSystem).serverExtensionAllocated = 0;
	(*serverSystem).serverExtensionBlockSize = 0;
	(*serverSystem).serverClientStart = NULL;
	(*serverSystem).serverClientSize = 0;
	(*serverSystem).serverClientAllocated = 0;
	(*serverSystem).serverClientBlockSize = 0;
	(*serverSystem).replyEpollFd = 0;
	(*serverSystem).eventEpollFd = 0;
	(*serverSystem).signalFd = 0;
	(*serverSystem).replyLoopRunning = false;
	(*serverSystem).eventLoopRunning = false;
	(*serverSystem).registrationLoopRunning = false;
	(*serverSystem).replyLoopThreadCreated = false;
	(*serverSystem).eventLoopThreadCreated = false;
	(*serverSystem).registrationLoopThreadCreated = false;



	(*serverSystem).registrationEventFd = 0;
	(*serverSystem).registrationEpollFd = 0;
	(*serverSystem).replyEventFd = 0;
	(*serverSystem).clientOffset = 0;
	*((*serverSystem).fdCopy + 0) = 0;
	*((*serverSystem).fdCopy + 1) = 0;
	*((*serverSystem).fdCopy + 2) = 0;



	ret true;
}
SETSERVERSERVERCHANNELPATH(){
	if(!serverSystem){
		ret false;
	}
	if(serverChannelPath == (*serverSystem).serverChannelPath){
		ret false;
	}
	(*serverSystem).serverChannelPath = serverChannelPath;
	ret true;
}
SETSERVERCLIENTCHANNELPATH(){
	if(!serverSystem){
		ret false;
	}
	if(clientChannelPath == (*serverSystem).clientChannelPath){
		ret false;
	}
	(*serverSystem).clientChannelPath = clientChannelPath;
	ret true;
}
SETSERVEREXTENSIONBLOCKSIZE(){
	if(!serverSystem){
		ret false;
	}
	if(serverExtensionBlockSize == (*serverSystem).serverExtensionBlockSize){
		ret false;
	}
	(*serverSystem).serverExtensionBlockSize = serverExtensionBlockSize;
	ret true;
}
SETSERVERCLIENTBLOCKSIZE(){
	if(!serverSystem){
		ret false;
	}
	if(serverClientBlockSize == (*serverSystem).serverClientBlockSize){
		ret false;
	}
	(*serverSystem).serverClientBlockSize = serverClientBlockSize;
	ret true;
}
BOOTSERVERREPLYLOOPTHREAD(){
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).replyLoopThreadCreated or (*serverSystem).replyLoopRunning){
		ret false;
	}
	(*serverSystem).replyLoopRunning = true;
	(*serverSystem).replyLoopThreadCreated = pthread_create(&(*serverSystem).replyLoopThread, NULL, &serverReplyLoop, serverSystem) == PTHREAD_CREATE_SUCCESS;
	if(!(*serverSystem).replyLoopThreadCreated){
		(*serverSystem).replyLoopRunning = false;
		ret false;
	}
	ret true;
}
BOOTSERVEREVENTLOOPTHREAD(){
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).eventLoopThreadCreated or (*serverSystem).eventLoopRunning){
		ret false;
	}
	(*serverSystem).eventLoopRunning = true;
	(*serverSystem).eventLoopThreadCreated = pthread_create(&(*serverSystem).eventLoopThread, NULL, &serverEventLoop, serverSystem) == PTHREAD_CREATE_SUCCESS;
	if(!(*serverSystem).eventLoopThreadCreated){
		(*serverSystem).eventLoopRunning = false;
		ret false;
	}
	ret true;
}
BOOTSERVERREGISTRATIONLOOPTHREAD(){
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).registrationLoopThreadCreated or (*serverSystem).registrationLoopRunning){
		ret false;
	}
	(*serverSystem).registrationLoopRunning = true;
	(*serverSystem).registrationLoopThreadCreated = pthread_create(&(*serverSystem).registrationLoopThread, NULL, &serverRegistrationLoop, serverSystem) == PTHREAD_CREATE_SUCCESS;
	if(!(*serverSystem).registrationLoopThreadCreated){
		(*serverSystem).registrationLoopRunning = false;
		ret false;
	}
	ret true;
}



























/*! demon area on */

SERVERREPLYLOOP(){

	/*! success when? */

	ServerSystem *const serverSystem = arg;
	int replyEpollFd;
	bool success;
	if(!serverSystem){
		ret NULL;
	}
	replyEpollFd = 0;
	success = false;
	if((*serverSystem).replyEpollFd){
		jmp emergencyExit;
	}
	if(!(*serverSystem).replyLoopThreadCreated){
		(*serverSystem).replyLoopRunning = true;
	}
	replyEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(replyEpollFd == EPOLL_CREATE1_FAILURE){
		replyEpollFd = 0;
		jmp emergencyExit;
	}
	(*serverSystem).replyEpollFd = replyEpollFd;
	jmp replyLoop;
	replyLoop:{
		struct epoll_event eventStart[128];
		int eventAmount = epoll_wait(replyEpollFd, eventStart, countof(eventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
		struct epoll_event *eventCurrent;
		struct epoll_event *eventWall;
		if(!(*serverSystem).replyLoopRunning){
			jmp emergencyExit;
		}
		eventCurrent = eventStart;
		eventWall = eventCurrent + eventAmount;
		jmp parseRequestLoop;
		parseRequestLoop:{
			if(eventCurrent < eventWall){
				const int fd = (*eventCurrent).data.fd;
				if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
					if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP)){
						jmp closeConnection;
					}
					jmp closeConnection;
				}
				if((*eventCurrent).events & EPOLLIN){
					jmp readRequestLoop;
					readRequestLoop:{
						uint64 message;
						int returnValue = read(fd, &message, sizeof(message));
						if(fd != (*serverSystem).registrationEventFd){









							if(returnValue > 0){
								const uint32 id = message >> 32; /*! update */
								/*! add generation? */
								const uint8 requestAmount = message;
								ServerClient *serverClient;
								if(!requestAmount){
									jmp closeConnection;
								}
								serverClient = findServerClientFdId(serverSystem, fd, id);
								if(serverClient){
									parseServerClientRequests(serverSystem, serverClient, requestAmount);
								}else{
									fprintf(stdout, "could not find the client\n");
									/*! error in communication or bad actor? */
								}
							}elif(returnValue == -1){
								if(errno == EINTR){
									jmp readRequestLoop;
								}
								if(errno != EAGAIN and errno != EWOULDBLOCK){
									jmp closeConnection;
								}
							}else{
								jmp closeConnection;
								closeConnection:{
									ServerClient *const serverClient = findServerClientFd(serverSystem, fd);
									if(serverClient){
										removeServerClient(serverSystem, serverClient);
										fprintf(stdout, "disconnected %u\n", (*serverClient).clientId);
									}
								}
							}









						}else{









							if(returnValue > 0){

								/*!*/

							}elif(returnValue == -1){
								if(errno == EINTR){
									jmp readRequestLoop;
								}

								/*!*/

							}else{

								/*!*/

							}



							if(!(*serverSystem).replyEventFd){
								struct epoll_event event;
								(*serverSystem).replyEventFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
								event.events = EPOLLIN;
								event.data.fd = (*serverSystem).replyEventFd;
								epoll_ctl((*serverSystem).registrationEpollFd, EPOLL_CTL_ADD, (*serverSystem).replyEventFd, &event); /*! errors? */
							}



							if(!insertServerClient(serverSystem, *((*serverSystem).fdCopy + 0), *((*serverSystem).fdCopy + 1), *((*serverSystem).fdCopy + 2))){
								*((*serverSystem).fdCopy + 0) = 0;
								*((*serverSystem).fdCopy + 1) = 0;
								*((*serverSystem).fdCopy + 2) = 0;
								jmp insertClientFailure;
								insertClientFailure:{
									const uint64 value = 1;
									(*serverSystem).clientOffset = 0;
									write((*serverSystem).replyEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
									inc eventCurrent;
									jmp parseRequestLoop;
								}
							}
							*((*serverSystem).fdCopy + 0) = 0;
							*((*serverSystem).fdCopy + 1) = 0;
							*((*serverSystem).fdCopy + 2) = 0;
							{
								const uint64 value = 1;
								(*serverSystem).clientOffset = (*serverSystem).serverClientAllocated - 1; /*! update when stack are in use */
								write((*serverSystem).replyEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
							}
							inc eventCurrent;
							jmp parseRequestLoop;









						}
					}
				}
				inc eventCurrent;
				jmp parseRequestLoop;
			}
			jmp replyLoop;
		}
	}
	emergencyExit:{
		removeAllServerClients(serverSystem);
		if(replyEpollFd){
			close(replyEpollFd); /*! on signal interrupt? */
			(*serverSystem).replyEpollFd = 0;
		}
		if(!(*serverSystem).replyLoopThreadCreated){
			(*serverSystem).replyLoopRunning = false;
		}
		if(!success){
			ret NULL;
		}
		ret serverSystem;
	}
}
SERVEREVENTLOOP(){

	/*! success when? */

	ServerSystem *const serverSystem = arg;
	int eventEpollFd;
	bool success;
	if(!serverSystem){
		ret NULL;
	}
	eventEpollFd = 0;
	success = false;
	if((*serverSystem).eventEpollFd){
		jmp emergencyExit;
	}
	if(!(*serverSystem).eventLoopThreadCreated){
		(*serverSystem).eventLoopRunning = true;
	}
	eventEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(eventEpollFd == EPOLL_CREATE1_FAILURE){
		eventEpollFd = 0;
		jmp emergencyExit;
	}
	(*serverSystem).eventEpollFd = eventEpollFd;
	jmp eventLoop;
	eventLoop:{
		struct epoll_event eventStart[1];
		int eventAmount = epoll_wait(eventEpollFd, eventStart, countof(eventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
		struct epoll_event *eventCurrent;
		struct epoll_event *eventWall;
		if(!(*serverSystem).eventLoopRunning){
			jmp emergencyExit;
		}
		eventCurrent = eventStart;
		eventWall = eventCurrent + eventAmount;
		jmp parseEventLoop;
		parseEventLoop:{
			if(eventCurrent < eventWall){
				const int fd = (*eventCurrent).data.fd;



#ifdef a
				if(fd != /*! local-to-the-server event fd */){
					jmp eventLoop;
				}
#endif



				if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
					if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP)){



						/*!*/



					}



					/*!*/



				}
				if((*eventCurrent).events & EPOLLIN){
					jmp readGeneratedEventLoop;
					readGeneratedEventLoop:{
						uint64 message;
						int returnValue = read(fd, &message, sizeof(message));
						if(returnValue > 0){



							/*!*/



						}elif(returnValue == -1){



							/*!*/



						}else{



							/*!*/



						}
					}
				}
				inc eventCurrent;
				jmp parseEventLoop;
			}
			jmp eventLoop;
		}
	}
	emergencyExit:{
		if(eventEpollFd){
			close(eventEpollFd); /*! on signal interrupt? */
			(*serverSystem).eventEpollFd = 0;
		}
		if(!(*serverSystem).eventLoopThreadCreated){
			(*serverSystem).eventLoopRunning = false;
		}
		if(!success){
			ret NULL;
		}
		ret serverSystem;
	}
}
SERVERREGISTRATIONLOOP(){
	ServerSystem *const serverSystem = arg;
	int registrationEpollFd;
	int socketConnection;
	struct sockaddr_un address;
	bool success;
	if(!serverSystem){
		ret NULL;
	}
	registrationEpollFd = 0;
	socketConnection = 0;
	success = false;
	if(!(*serverSystem).serverChannelPath or !(*serverSystem).clientChannelPath or (*serverSystem).registrationEpollFd){
		jmp emergencyExit;
	}
	if(!(*serverSystem).registrationLoopThreadCreated){
		(*serverSystem).registrationLoopRunning = true;
	}
	registrationEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(registrationEpollFd == EPOLL_CREATE1_FAILURE){
		registrationEpollFd = 0;
		jmp emergencyExit;
	}
	(*serverSystem).registrationEpollFd = registrationEpollFd;
	jmp createServerClientChannelPath;
	createServerClientChannelPath:{
		FILE *const file = fopen((*serverSystem).clientChannelPath, "w");
		if(!file){
			jmp emergencyExit;
		}
		fclose(file);
		jmp createServerRegistrationLoopConnection;
	}
	createServerRegistrationLoopConnection:{
		uint concurrentConnectionAmount = 128; /*! parameterize */
		socketConnection = socket(AF_UNIX, SOCK_STREAM, NONE_SOCKET_PROTOCOL); /*! errors? */
		if(socketConnection == SOCKET_FAILURE){
			jmp emergencyExit;
		}
		address.sun_family = AF_UNIX;
		strcpy(address.sun_path, (*serverSystem).serverChannelPath);
		unlink((*serverSystem).serverChannelPath); /*! errors? */
		bind(socketConnection, (void *)&address, sizeof(address)); /*! errors? */
		listen(socketConnection, concurrentConnectionAmount); /*! errors? */
		jmp registrationLoop;
	}
	registrationLoop:{
		const int clientSocket = accept(socketConnection, NULL, NULL);
		int serverRequestReadFd;
		int clientReplyWriteFd;
		int clientEventWriteFd;
		if(!(*serverSystem).registrationLoopRunning){
			close(clientSocket); /*! on signal interrupt? */
			jmp emergencyExit;
		}
		if(!(*serverSystem).replyEpollFd){
			close(clientSocket); /*! on signal interrupt? */
			jmp registrationLoop;
		}
		{
			int fd[3];
			if(!receiveFd(clientSocket, countof(fd), fd)){ /*! errors? client might not send, how to mitigate? */
				close(clientSocket); /*! on signal interrupt? */
				jmp registrationLoop;
			}
			serverRequestReadFd = *(fd + 0);
			clientReplyWriteFd = *(fd + 1);
			clientEventWriteFd = *(fd + 2);
		}
		{
			const int flag = fcntl(serverRequestReadFd, F_GETFL, 0); /*! errors? */
			int returnValue;
			if(flag == FCNTL_FAILURE){
				close(clientEventWriteFd); /*! errors? */
				close(clientReplyWriteFd); /*! errors? */
				close(serverRequestReadFd); /*! errors? */
				close(clientSocket); /*! on signal interrupt? */
				jmp registrationLoop;
			}
			returnValue = fcntl(serverRequestReadFd, F_SETFL, flag | O_NONBLOCK); /*! errors? also why pick these ones? */
			if(returnValue == FCNTL_FAILURE){
				close(clientEventWriteFd); /*! errors? */
				close(clientReplyWriteFd); /*! errors? */
				close(serverRequestReadFd); /*! errors? */
				close(clientSocket); /*! on signal interrupt? */
				jmp registrationLoop;
			}
		}









		/*!*/

		{
			struct epoll_event event;
			event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
			event.data.fd = serverRequestReadFd;
			epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_ADD, serverRequestReadFd, &event); /*! errors? */
		}



		if(!(*serverSystem).registrationEventFd){
			struct epoll_event event;
			(*serverSystem).registrationEventFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
			event.events = EPOLLIN;
			event.data.fd = (*serverSystem).registrationEventFd;
			epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_ADD, (*serverSystem).registrationEventFd, &event); /*! errors? */
		}
		{
			const uint64 value = 1;
			*((*serverSystem).fdCopy + 0) = serverRequestReadFd;
			*((*serverSystem).fdCopy + 1) = clientReplyWriteFd;
			*((*serverSystem).fdCopy + 2) = clientEventWriteFd;
			write((*serverSystem).registrationEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
		}



		{
			struct epoll_event eventStart[1];
			uint64 message;
			const int eventAmount = epoll_wait(registrationEpollFd, eventStart, countof(eventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
			int returnValue = read((*eventStart).data.fd, &message, sizeof(message));
			(void)eventAmount;
			(void)returnValue;
		}



		if(!(*serverSystem).clientOffset){
			const uint32 value = 0;
			send(clientSocket, &value, sizeof(value), 0); /*! error? */
		}else{
			ServerClient *const serverClient = (*serverSystem).serverClientStart + (*serverSystem).clientOffset;
			send(clientSocket, &(*serverClient).shmId, sizeof((*serverClient).shmId), 0); /*! error? */
			(*serverSystem).clientOffset = 0;
			fprintf(stdout, "connected %u on %i\n", (*serverClient).clientId, (*serverClient).shmId);
			success = true;
		}

		/*!*/









		close(clientSocket); /*! on signal interrupt? */
		jmp registrationLoop;
	}
	emergencyExit:{
		if((*serverSystem).serverChannelPath){
			unlink((*serverSystem).serverChannelPath); /*! what do? */
		}
		if(socketConnection){
			close(socketConnection); /*! on signal interrupt? */
		}
		if((*serverSystem).clientChannelPath){
			unlink((*serverSystem).clientChannelPath); /*! what do? */
		}
		if(registrationEpollFd){
			close(registrationEpollFd); /*! on signal interrupt? */
			(*serverSystem).registrationEpollFd = 0;
		}
		if(!(*serverSystem).registrationLoopThreadCreated){
			(*serverSystem).registrationLoopRunning = false;
		}
		if(!success){
			ret NULL;
		}
		ret serverSystem;
	}
}
INSERTSERVERCLIENT(){
	ServerClient *serverClient;
	uint64 clientId;
	int shmKey;
	int shmId;
	Header *shmStart;
	uint32 requestSlotSize;
	uint32 replySlotSize;
	uint32 eventSlotSize;
	uint32 requestSize;
	uint32 replySize;
	uint32 eventSize;
	Header header;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).clientChannelPath or !serverRequestReadFd or !clientReplyWriteFd or !clientEventWriteFd){
		ret false;
	}
	jmp insertClient;
	insertClient:{
		if((*serverSystem).serverClientAllocated == (*serverSystem).serverClientSize){
			void *temp;
			if(!(*serverSystem).serverClientBlockSize){
				ret false;
			}
			(*serverSystem).serverClientSize += (*serverSystem).serverClientBlockSize;
			temp = realloc((*serverSystem).serverClientStart, (*serverSystem).serverClientSize * sizeof(ServerClient));
			if(!temp){
				(*serverSystem).serverClientSize -= (*serverSystem).serverClientBlockSize;
				ret false;
			}
			(*serverSystem).serverClientStart = temp;
			if(!(*serverSystem).serverClientAllocated){
				inc (*serverSystem).serverClientAllocated;
				jmp insertClient;
			}
		}
		clientId = (*serverSystem).serverClientAllocated;
		requestSlotSize = 256; /*! parameterize */
		replySlotSize = 256; /*! parameterize */
		eventSlotSize = 256; /*! parameterize */
		requestSize = 16 * 1024; /*! parameterize */
		replySize = 16 * 1024; /*! parameterize */
		eventSize = 16 * 1024; /*! parameterize */
		shmKey = ftok((*serverSystem).clientChannelPath, clientId); /*! writeFileToKey() function. the lower 0x(F)FFF is the number given here */
		shmId = shmget(shmKey, sizeof(Header) + requestSlotSize * sizeof(RequestSlot) + replySlotSize * sizeof(ReplySlot) + eventSlotSize * sizeof(EventSlot) + requestSize * sizeof(uint8) + replySize * sizeof(uint8) + eventSize * sizeof(uint8), IPC_CREAT | 0666);
		if(!shmId){
			ret false;
		}
		shmStart = shmat(shmId, NULL, SHM_NONE); /*! params? */
		if(!shmStart){
			ret false;
		}
		clientId = 0 | clientId; /*! update the id sent back to have a generation and maybe a unique part */
		header.requestSlotSize = requestSlotSize;
		header.requestSize = requestSize;
		header.replySlotSize = replySlotSize;
		header.replySize = replySize;
		header.eventSlotSize = eventSlotSize;
		header.eventSize = eventSize;
		header.requestSlotStartOffset = 0 + sizeof(Header);
		header.replySlotStartOffset = header.requestSlotStartOffset + requestSlotSize * sizeof(RequestSlot);
		header.eventSlotStartOffset = header.replySlotStartOffset + replySlotSize * sizeof(ReplySlot);
		header.requestStartOffset = header.eventSlotStartOffset + eventSlotSize * sizeof(EventSlot);
		header.replyStartOffset = header.requestStartOffset + requestSize * sizeof(uint8);
		header.eventStartOffset = header.replyStartOffset + replySize * sizeof(uint8);
		header.requestCurrentWriter = 0;
		header.requestCurrentReader = 0;
		header.replyCurrentWriter = 0;
		header.replyCurrentReader = 0;
		header.eventCurrentWriter = 0;
		header.eventCurrentReader = 0;
		header.clientId = clientId;
		serverClient = (*serverSystem).serverClientStart + (*serverSystem).serverClientAllocated;
		(*serverClient).shmStart = shmStart;
		(*serverClient).requestSlotStart = (void *)((uint8 *)shmStart + header.requestSlotStartOffset);
		(*serverClient).replySlotStart = (void *)((uint8 *)shmStart + header.replySlotStartOffset);
		(*serverClient).eventSlotStart = (void *)((uint8 *)shmStart + header.eventSlotStartOffset);
		(*serverClient).requestStart = (void *)((uint8 *)shmStart + header.requestStartOffset);
		(*serverClient).requestCurrent = (*serverClient).requestStart;
		(*serverClient).replyStart = (void *)((uint8 *)shmStart + header.replyStartOffset);
		(*serverClient).replyCurrent = (*serverClient).replyStart;
		(*serverClient).eventStart = (void *)((uint8 *)shmStart + header.eventStartOffset);
		(*serverClient).eventCurrent = (*serverClient).eventStart;
		(*serverClient).shmId = shmId;
		(*serverClient).serverRequestReadFd = serverRequestReadFd;
		(*serverClient).serverClientReplyWriteFd = clientReplyWriteFd;
		(*serverClient).serverClientEventWriteFd = clientEventWriteFd;
		(*serverClient).clientId = clientId;
		memcpy(shmStart, &header, sizeof(Header));
		inc (*serverSystem).serverClientAllocated;
		ret true;
	}
}









#define UNPACKREQUESTITEMS() /*-*/ bool  unpackRequestItems(ServerSystem *const serverSystem, const GenericRequest *const request, const uint32 itemAmount, const void **itemStartReturn, uint32 *itemSizeReturn)

UNPACKREQUESTITEMS();

UNPACKREQUESTITEMS(){
	void *payloadStart;
	uint32 amount;
	uint32 *sizeCurrent;
	uint32 *sizeWall;
	uint8 *pointerCurrent;
	if(!serverSystem){
		ret false;
	}
	if(!request or !(*request).payloadStartOffset or !(*request).payloadSize or !itemAmount or !itemStartReturn or !itemSizeReturn){
		ret false;
	}
	payloadStart = (uint8 *)request + (*request).payloadStartOffset;
	amount = *(uint32 *)payloadStart;
	if(itemAmount > amount){
		ret false;
	}
	sizeCurrent = (uint32 *)payloadStart + 1;
	sizeWall = sizeCurrent + itemAmount;
	pointerCurrent = (void *)(sizeCurrent + amount);
	/*! {
		fprintf(stdout, "request @ ?\n");
	} */
	jmp unpackRequestItemLoop;
	unpackRequestItemLoop:{
		if(sizeCurrent < sizeWall){
			/*! {
				uint i;
				fprintf(stdout, "\tvalue @ %u\n", *sizeCurrent);
				fprintf(stdout, "\tdata @");
				for(i = 0; i < *sizeCurrent; inc i){
					fprintf(stdout, " %u", *(pointerCurrent + i));
				}
				fprintf(stdout, "\n");
			} */
			*itemStartReturn = pointerCurrent;
			*itemSizeReturn = *sizeCurrent;
			inc itemStartReturn;
			inc itemSizeReturn;
			pointerCurrent += (*sizeCurrent + (sizeof(uint32) - 1)) & ~(sizeof(uint32) - 1);
			inc sizeCurrent;
			jmp unpackRequestItemLoop;
		}
		/*! {
			fprintf(stdout, "\n");
		} */
		ret true;
	}
}









/*! what happens when there is not enough space for the reply data to exist in? how do i handle that? maybe return the size via parseExtensionRequest()? */

PARSESERVERCLIENTREQUESTS(){
	uint current;
	uint wall;
	Header *header;
	uint32 requestCurrentReader;
	uint32 requestSlotSize;
	uint32 replyCurrentWriter;
	uint32 replySize;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!isValidServerClient(serverSystem, serverClient) or !requestAmount){
		ret false;
	}



	/*! if not able to write reply, because the buffer is full, do... what? */



	current = 0;
	wall = requestAmount;
	header = (*serverClient).shmStart;
	requestCurrentReader = (*header).requestCurrentReader;
	requestSlotSize = (*header).requestSlotSize;
	replyCurrentWriter = (*header).replyCurrentWriter;
	replySize = (*header).replySize;
	success = false;
	jmp parseServerClientRequestLoop;
	parseServerClientRequestLoop:{
		if(current < wall){
			uint8 requestType;
			uint8 extension;
			bool sendReply;
			uint32 token;
			uint8 status;
			uint32 replyPayloadSize;
			uint32 extensionId; /*! temporary variable for the enable extension request */
			jmp processRequest;
			processRequest:{
				RequestSlot *const requestSlot = (*serverClient).requestSlotStart + requestCurrentReader;
				GenericRequest *const request = (void *)((uint8 *)(*serverClient).requestStart + (*requestSlot).requestStartOffset);
				uint32 payloadStartOffset;
				uint32 payloadSize;
				uint32 itemAmount;
				fprintf(stdout, "\nparsing request from client...\n");
				if((*requestSlot).requestSize != sizeof(GenericRequest) or (*requestSlot).requestStartOffset + (*requestSlot).requestSize > (*header).requestSize or (*requestSlot).requestStartOffset + (*requestSlot).requestSize + (*request).payloadSize > (*header).requestSize){
					requestCurrentReader = (requestCurrentReader + 1) % requestSlotSize;
					jmp sendBadRequest;
				}
				requestType = (*request).requestType;
				extension = (*request).extension;
				sendReply = (*request).sendReply;
				token = (*request).token;
				payloadStartOffset = (*request).payloadStartOffset;
				payloadSize = (*request).payloadSize;
				itemAmount = 0;
				if(payloadStartOffset and payloadSize){
					const uint8 *const payloadStart = (uint8 *)request + payloadStartOffset;
					itemAmount = *(uint32 *)payloadStart;
				}
				requestCurrentReader = (requestCurrentReader + 1) % requestSlotSize;
				status = NONE_REPLY_STATUS;
				replyPayloadSize = 0 * sizeof(uint8);



fprintf(stdout, "\trequest slot @ %u\n", (*requestSlot).requestStartOffset);
fprintf(stdout, "\tstruct got is %u %u %u %u %u %u\n", (*request).requestType, (*request).extension, (*request).sendReply, (*request).token, (*request).payloadStartOffset, (*request).payloadSize);



				if(extension){
					ServerExtension *const serverExtension = (*serverSystem).serverExtensionStart + extension;
					ServerExtensionDescriptor *serverExtensionDescriptor;
					if(extension >= (*serverSystem).serverExtensionAllocated){
						jmp sendBadRequest;
					}
					serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
					if(!(*serverExtensionDescriptor).parseExtensionRequest){
						jmp sendBadRequest;
					}
					if(!(*(*serverExtensionDescriptor).parseExtensionRequest)(request, itemAmount, &status, &replyPayloadSize)){
						jmp sendBadRequest;
					}
				}else{
					switch(requestType){
						to NONE_SERVER_REQUEST_TYPE:{
							jmp sendBadRequest;
						}
						to NO_OPERATION_SERVER_REQUEST_TYPE:{
							if(!itemAmount){
								status |= SUCCESS_REPLY_STATUS;
							}
							brk;
						}
						to SYNC_SERVER_REQUEST_TYPE:{
							if(!itemAmount){
								status |= SUCCESS_REPLY_STATUS;
							}
							brk;
						}
						to ENABLE_EXTENSION_SERVER_REQUEST_TYPE:{
							replyPayloadSize = 2 * sizeof(uint32);
							extensionId = 0;
							if(itemAmount == 1){
								EnableExtensionServerRequest enableExtensionServerRequest;
								unpackRequestItems(serverSystem, request, 1, (void *)&enableExtensionServerRequest.pathStart, &enableExtensionServerRequest.pathSize);
								if(loadServerExtension(serverSystem, enableExtensionServerRequest.pathStart, &extensionId)){
									const ServerExtension *const serverExtension = (*serverSystem).serverExtensionStart + extensionId;
									const ServerExtensionDescriptor *const serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
									if((*(*serverExtensionDescriptor).initServerExtensionDescriptorSystem)()){
										if((*serverExtension).serverExtensionReferenceCount == 1){
											status |= UPDATED_REPLY_STATUS;
										}
										status |= SUCCESS_REPLY_STATUS;
									}
								}
							}



							if(!(status & SUCCESS_REPLY_STATUS)){
								fprintf(stdout, "failed the extension adding\n");
							}



							brk;
						}
						off:{
							jmp sendBadRequest;
						}
					}
				}
				success = true;
				jmp formReply;
			}
			formReply:{
				if(sendReply and sizeof(GenericReply) + replyPayloadSize <= replySize){
					const uint64 response = ((uint64)replyCurrentWriter << 32) | token;
					ReplySlot *const replySlot = (*serverClient).replySlotStart + replyCurrentWriter;
					GenericReply *const reply = (*serverClient).replyCurrent;



					/*! handle space in a safer way */

					if((uint8 *)(*serverClient).replyCurrent >= (uint8 *)(*serverClient).replyStart + replySize){
						(*serverClient).replyCurrent = (*serverClient).replyStart;
					}elif((uint8 *)(*serverClient).replyCurrent + sizeof(GenericReply) + replyPayloadSize > (uint8 *)(*serverClient).replyStart + replySize){
						(*serverClient).replyCurrent = (*serverClient).replyStart;
					}



					replyCurrentWriter = (replyCurrentWriter + 1) % replySize;
					if(extension){
						ServerExtension *const serverExtension = (*serverSystem).serverExtensionStart + extension;
						ServerExtensionDescriptor *serverExtensionDescriptor;
						if(extension >= (*serverSystem).serverExtensionAllocated){
							jmp sendBadRequest;
						}
						serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
						if(!(*serverExtensionDescriptor).parseExtensionReply){
							jmp sendBadRequest;
						}
						if(!(*(*serverExtensionDescriptor).parseExtensionReply)(requestType, reply)){
							jmp sendBadRequest;
						}
					}else{
						switch(requestType){
							to NONE_SERVER_REPLY_TYPE:{
								jmp sendBadRequest;
							}
							to NO_OPERATION_SERVER_REPLY_TYPE:{
								brk;
							}
							to SYNC_SERVER_REPLY_TYPE:{
								brk;
							}
							to ENABLE_EXTENSION_SERVER_REPLY_TYPE:{
								(*(EnableExtensionServerReply *)reply).extensionId = extensionId;
								(*(EnableExtensionServerReply *)reply).baseEvent = 0; /*! use a base variable and then increment by the amount of extension events, but increment on request */
								brk;
							}
							off:{
								jmp sendBadRequest;
							}
						}
					}
					(*replySlot).replyStartOffset = (uint8 *)reply - (uint8 *)(*serverClient).replyStart;
					(*replySlot).replySize = sizeof(GenericReply);
					(*reply).replyType = requestType;
					(*reply).extension = extension;
					(*reply).status = status;
					(*reply).token = token;
					(*reply).payloadStartOffset = !!replyPayloadSize * sizeof(GenericReply);
					(*reply).payloadSize = replyPayloadSize;

					(*serverClient).replyCurrent += sizeof(GenericReply) + replyPayloadSize;



					fprintf(stdout, "\n\treply slot @ %u\n", (*replySlot).replyStartOffset);
					fprintf(stdout, "\tsending back  %u %u %u %u %u %u\n", (*reply).replyType, (*reply).extension, (*reply).status, (*reply).token, (*reply).payloadStartOffset, (*reply).payloadSize);



					write((*serverClient).serverClientReplyWriteFd, &response, sizeof(response)); /*! errors? */
					success = true;
				}
				inc current;
				jmp parseServerClientRequestLoop;
				sendBadRequest:{
					const uint64 response = 0; /*! do something better? */
					fprintf(stdout, "\tsending back  bad response\n");
					write((*serverClient).serverClientReplyWriteFd, &response, sizeof(response)); /*! errors? */
					inc current;
					jmp parseServerClientRequestLoop;
				}
			}
		}
		(*header).replyCurrentWriter = replyCurrentWriter;
		(*header).requestCurrentReader = requestCurrentReader;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
LOADSERVEREXTENSION(){
	void *serverExtensionHandle;
	ServerExtensionDescriptor *serverExtensionDescriptor;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!path or !extensionIdReturn){
		ret false;
	}
	serverExtensionHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
	success = false;
	if(serverExtensionHandle){
		ServerExtension *const start = (*serverSystem).serverExtensionStart;
		ServerExtension *current = start + 1;
		ServerExtension *const wall = start + (*serverSystem).serverExtensionAllocated;
		jmp findServerExtensionLoop;
		findServerExtensionLoop:{
			if(current < wall){
				if((*current).serverExtensionHandle == serverExtensionHandle){
					inc (*current).serverExtensionReferenceCount;
					*extensionIdReturn = current - start;
					success = true;
					jmp emergencyExit;
				}
				inc current;
				jmp findServerExtensionLoop;
			}
		}



		/*! can this even fail? what happens then? */



	}
	serverExtensionHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
	if(!serverExtensionHandle){
		jmp emergencyExit;
	}
	serverExtensionDescriptor = dlsym(serverExtensionHandle, "serverExtensionDescriptor");
	if(!serverExtensionDescriptor){
		jmp emergencyExit;
	}
	if((*serverExtensionDescriptor).descriptorSize != sizeof(ServerExtensionDescriptor) or (*serverExtensionDescriptor).protocolVersion > SERVER_PROTOCOL_VERSION or !(*serverExtensionDescriptor).nameSize or !(*serverExtensionDescriptor).name or !(*serverExtensionDescriptor).initServerExtensionDescriptorSystem or !(*serverExtensionDescriptor).parseExtensionRequest or !(*serverExtensionDescriptor).parseExtensionReply or !(*serverExtensionDescriptor).finiServerExtensionDescriptorSystem){
		jmp emergencyExit;
	}



	/*! check for duplicates? */



	jmp insertExtension;
	insertExtension:{
		ServerExtension *serverExtension;
		if((*serverSystem).serverExtensionAllocated == (*serverSystem).serverExtensionSize){
			void *temp;
			if(!(*serverSystem).serverExtensionBlockSize){
				jmp emergencyExit;
			}
			(*serverSystem).serverExtensionSize += (*serverSystem).serverExtensionBlockSize;
			temp = realloc((*serverSystem).serverExtensionStart, (*serverSystem).serverExtensionSize * sizeof(ServerExtension));
			if(!temp){
				(*serverSystem).serverExtensionSize -= (*serverSystem).serverExtensionBlockSize;
				jmp emergencyExit;
			}
			(*serverSystem).serverExtensionStart = temp;
			if(!(*serverSystem).serverExtensionAllocated){
				inc (*serverSystem).serverExtensionAllocated;
				jmp insertExtension;
			}
		}
		serverExtension = (*serverSystem).serverExtensionStart + (*serverSystem).serverExtensionAllocated;
		(*serverExtension).serverExtensionHandle = serverExtensionHandle;
		(*serverExtension).serverExtensionDescriptor = serverExtensionDescriptor;
		(*serverExtension).serverExtensionReferenceCount = 1;
		*extensionIdReturn = (*serverSystem).serverExtensionAllocated;
		inc (*serverSystem).serverExtensionAllocated;
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			if(serverExtensionHandle){
				dlclose(serverExtensionHandle);
			}
			ret false;
		}
		ret true;
	}
}
UNLOADSERVEREXTENSION(){
	if(!serverSystem){
		ret false;
	}



	/*!*/



	ret true;
}

/*! demon area off */



























REMOVESERVERCLIENT(){
	if(!serverSystem){
		ret false;
	}
	if(!isValidServerClient(serverSystem, serverClient)){
		ret false;
	}
	epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_DEL, (*serverClient).serverRequestReadFd, NULL); /*! errors? */
	shmctl((*serverClient).shmId, IPC_RMID, NULL); /*! errors? */
	shmdt((*serverClient).shmStart); /*! errors? */
	close((*serverClient).serverRequestReadFd); /*! on signal interrupt? */
	close((*serverClient).serverClientReplyWriteFd); /*! on signal interrupt? */
	close((*serverClient).serverClientEventWriteFd); /*! on signal interrupt? */
	(*serverClient).clientId = 0;
	ret true;
}
REMOVEALLSERVERCLIENTS(){
	ServerClient *current;
	ServerClient *wall;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).serverClientStart and !(*serverSystem).serverClientSize and !(*serverSystem).serverClientAllocated){
		ret false;
	}
	current = (*serverSystem).serverClientStart + 1;
	wall = current + (*serverSystem).serverClientAllocated;
	success = false;
	if((*serverSystem).replyEpollFd){
		jmp removeServerClientLoop;
		removeServerClientLoop:{
			if(current < wall){
				removeServerClient(serverSystem, current);
				inc current;
				jmp removeServerClientLoop;
			}
		}
	}
	free((*serverSystem).serverClientStart);
	(*serverSystem).serverClientStart = NULL;
	(*serverSystem).serverClientSize = 0;
	(*serverSystem).serverClientAllocated = 0;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
QUITSERVERREGISTRATIONLOOPTHREAD(){
	int socketConnection;
	struct sockaddr_un address;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).registrationLoopRunning){
		ret false;
	}
	socketConnection = socket(AF_UNIX, SOCK_STREAM, NONE_SOCKET_PROTOCOL);
	if(socketConnection == SOCKET_FAILURE){
		ret false;
	}
	address.sun_family = AF_UNIX;
	strcpy(address.sun_path, (*serverSystem).serverChannelPath); /*! replace with toolkit function */
	(*serverSystem).registrationLoopRunning = false;
	if(connect(socketConnection, (void *)&address, sizeof(address)) == CONNECT_FAILURE){
		(*serverSystem).registrationLoopRunning = true;
		close(socketConnection); /*! on signal interrupt? */
		ret false;
	}
	close(socketConnection); /*! on signal interrupt? */
	ret true;
}
QUITSERVERREPLYLOOPTHREAD(){
	int signalFd;
	struct epoll_event event;
	uint64 value;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).replyEpollFd or !(*serverSystem).replyLoopRunning){
		ret false;
	}
	signalFd = (*serverSystem).signalFd;
	if(!signalFd){
		signalFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
		(*serverSystem).signalFd = signalFd;
	}
	event.events = EPOLLIN;
	event.data.fd = signalFd;
	value = 1;
	epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_ADD, signalFd, &event); /*! errors? */
	(*serverSystem).replyLoopRunning = false;
	write(signalFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
	ret true;
}
QUITSERVEREVENTLOOPTHREAD(){
	int signalFd;
	struct epoll_event event;
	uint64 value;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).eventEpollFd or !(*serverSystem).eventLoopRunning){
		ret false;
	}
	signalFd = (*serverSystem).signalFd;
	if(!signalFd){
		signalFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
		(*serverSystem).signalFd = signalFd;
	}
	event.events = EPOLLIN;
	event.data.fd = signalFd;
	value = 1;
	epoll_ctl((*serverSystem).eventEpollFd, EPOLL_CTL_ADD, signalFd, &event); /*! errors? */
	(*serverSystem).eventLoopRunning = false;
	write(signalFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
	ret true;
}
AWAITSERVERREGISTRATIONLOOPTHREADEXIT(){
	void *serverSystemReturn;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).registrationLoopThreadCreated){
		ret false;
	}
	pthread_join((*serverSystem).registrationLoopThread, &serverSystemReturn);
	(*serverSystem).registrationLoopThreadCreated = false;
	if(!serverSystemReturn){
		ret false;
	}
	ret true;
}
AWAITSERVERREPLYLOOPTHREADEXIT(){
	void *serverSystemReturn;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).replyLoopThreadCreated){
		ret false;
	}
	pthread_join((*serverSystem).replyLoopThread, &serverSystemReturn);
	(*serverSystem).replyLoopThreadCreated = false;
	if(!serverSystemReturn){
		ret false;
	}
	ret true;
}
AWAITSERVEREVENTLOOPTHREADEXIT(){
	void *serverSystemReturn;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).eventLoopThreadCreated){
		ret false;
	}
	pthread_join((*serverSystem).eventLoopThread, &serverSystemReturn);
	(*serverSystem).eventLoopThreadCreated = false;

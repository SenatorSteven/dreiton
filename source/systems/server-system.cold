REMOVEALLSERVEREXTENSIONS(){
	const ServerExtension *start;
	const ServerExtension *current;
	const ServerExtension *wall;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).serverExtensionStart and !(*serverSystem).serverExtensionSize and !(*serverSystem).serverExtensionAllocated){
		ret false;
	}
	start = (*serverSystem).serverExtensionStart;
	current = start + 1;
	wall = start + (*serverSystem).serverExtensionAllocated;
	success = false;
	jmp removeServerExtensionLoop;
	removeServerExtensionLoop:{
		if(current < wall){



			/*! make sure to use a stack for this one */



			if((*serverSystem).eventEpollFd){
				epoll_ctl((*serverSystem).eventEpollFd, EPOLL_CTL_DEL, (*current).serverExtensionEventFd, NULL); /*! errors? */
			}
			close((*current).serverExtensionEventFd);
			dlclose((*current).serverExtensionHandle);



			success = true;
			inc current;
			jmp removeServerExtensionLoop;
		}
		jmp emergencyExit;
	}
	emergencyExit:{
		free((*serverSystem).serverExtensionStart);
		(*serverSystem).serverExtensionStart = NULL;
		(*serverSystem).serverExtensionSize = 0;
		(*serverSystem).serverExtensionAllocated = 0;
		if(!success){
			ret false;
		}
		ret true;
	}
}
ISVALIDSERVERCLIENT(){
	if(!serverSystem){
		ret false;
	}
	if(serverClient <= (*serverSystem).serverClientStart or serverClient >= (*serverSystem).serverClientStart + (*serverSystem).serverClientAllocated or !(*serverClient).clientId){
		ret false;
	}
	ret true;
}
FINDSERVERCLIENTFD(){
	ServerClient *current;
	ServerClient *wall;
	if(!serverSystem){
		ret NULL;
	}
	if(!(*serverSystem).serverClientAllocated or !fd){
		ret NULL;
	}
	current = (*serverSystem).serverClientStart + 1;
	wall = current + (*serverSystem).serverClientAllocated;
	jmp findServerClientFdLoop;
	findServerClientFdLoop:{
		if(current < wall){
			if((*current).serverRequestReadFd == fd and (*current).clientId){
				ret current;
			}
			inc current;
			jmp findServerClientFdLoop;
		}
		ret NULL;
	}
}
FINDSERVERCLIENTFDID(){
	ServerClient *serverClient;
	if(!serverSystem){
		ret NULL;
	}
	if(!fd or id >= (*serverSystem).serverClientAllocated){ /*! update later when stacks are added */
		ret NULL;
	}
	serverClient = (*serverSystem).serverClientStart + id;
	if(!(*serverClient).clientId or (*serverClient).serverRequestReadFd != fd){
		ret NULL;
	}
	ret serverClient;
}
FINISERVERSYSTEM(){
	if(!serverSystem){
		ret false;
	}



	/*!*/

	if((*serverSystem).registrationEventFd){
		close((*serverSystem).registrationEventFd);
		(*serverSystem).registrationEventFd = 0;
	}
	if((*serverSystem).registrationEpollFd){
		close((*serverSystem).registrationEpollFd);
		(*serverSystem).registrationEpollFd = 0;
	}
	if((*serverSystem).replyEventFd){
		close((*serverSystem).replyEventFd);
		(*serverSystem).replyEventFd = 0;
	}
	(*serverSystem).clientOffset = 0;
	*((*serverSystem).fdCopy + 0) = 0;
	*((*serverSystem).fdCopy + 1) = 0;
	*((*serverSystem).fdCopy + 2) = 0;
	(*serverSystem).baseEvent = 0;



	/*!*/

	(*serverSystem).eventStart = NULL;
	(*serverSystem).eventSize = 0;
	(*serverSystem).eventAllocated = 0;



	if((*serverSystem).registrationLoopThreadCreated){
		quitServerRegistrationLoopThread(serverSystem);
		pthread_join((*serverSystem).registrationLoopThread, NULL);
		(*serverSystem).registrationLoopThreadCreated = false;
	}
	if((*serverSystem).eventLoopThreadCreated){
		quitServerEventLoopThread(serverSystem);
		pthread_join((*serverSystem).eventLoopThread, NULL);
		(*serverSystem).eventLoopThreadCreated = false;
	}
	if((*serverSystem).replyLoopThreadCreated){
		quitServerReplyLoopThread(serverSystem);
		pthread_join((*serverSystem).replyLoopThread, NULL);
		(*serverSystem).replyLoopThreadCreated = false;
	}
	(*serverSystem).registrationLoopRunning = false;
	(*serverSystem).eventLoopRunning = false;
	(*serverSystem).replyLoopRunning = false;



	/*! should someone else be responsible for these? namely the functions dealing with this stuff */

	if((*serverSystem).signalEventFd){
		close((*serverSystem).signalEventFd); /*! on signal interrupt? */ /*! errors? */
		(*serverSystem).signalEventFd = 0;
	}

	/*!*/

#ifdef a
	int32 /*--------*/ replyEpollFd;
	int32 /*--------*/ eventReplyEpollFd;
	int32 /*--------*/ signalEventFd;
	uint32 /*-------*/ clientId;
#endif



	(*serverSystem).serverClientBlockSize = 0;



	removeAllServerClients(serverSystem);



	(*serverSystem).serverExtensionBlockSize = 0;



	removeAllServerExtensions(serverSystem);

	/*!*/



	(*serverSystem).database = NULL;
	(*serverSystem).clientChannelPath = NULL;
	(*serverSystem).serverChannelPath = NULL;
	ret true;
}


INITSERVERSYSTEM(){
	if(!serverSystem){
		ret false;
	}
	(*serverSystem).serverChannelPath = NULL;
	(*serverSystem).clientChannelPath = NULL;
	(*serverSystem).database = NULL;
	(*serverSystem).serverExtensionStart = NULL;
	(*serverSystem).serverExtensionSize = 0;
	(*serverSystem).serverExtensionAllocated = 0;
	(*serverSystem).serverExtensionBlockSize = 0;
	(*serverSystem).serverClientStart = NULL;
	(*serverSystem).serverClientSize = 0;
	(*serverSystem).serverClientAllocated = 0;
	(*serverSystem).serverClientBlockSize = 0;
	(*serverSystem).replyEpollFd = 0;
	(*serverSystem).eventEpollFd = 0;
	(*serverSystem).signalEventFd = 0;
	(*serverSystem).replyLoopRunning = false;
	(*serverSystem).eventLoopRunning = false;
	(*serverSystem).registrationLoopRunning = false;
	(*serverSystem).replyLoopThreadCreated = false;
	(*serverSystem).eventLoopThreadCreated = false;
	(*serverSystem).registrationLoopThreadCreated = false;



	/*!*/

	(*serverSystem).registrationEventFd = 0;
	(*serverSystem).registrationEpollFd = 0;
	(*serverSystem).replyEventFd = 0;
	(*serverSystem).clientOffset = 0;
	*((*serverSystem).fdCopy + 0) = 0;
	*((*serverSystem).fdCopy + 1) = 0;
	*((*serverSystem).fdCopy + 2) = 0;
	(*serverSystem).baseEvent = 0;



	/*!*/

	(*serverSystem).eventStart = NULL;
	(*serverSystem).eventSize = 0;
	(*serverSystem).eventAllocated = 0;



	ret true;
}
SETSERVERSERVERCHANNELPATH(){
	if(!serverSystem){
		ret false;
	}
	if(serverChannelPath == (*serverSystem).serverChannelPath){
		ret false;
	}
	(*serverSystem).serverChannelPath = serverChannelPath;
	ret true;
}
SETSERVERCLIENTCHANNELPATH(){
	if(!serverSystem){
		ret false;
	}
	if(clientChannelPath == (*serverSystem).clientChannelPath){
		ret false;
	}
	(*serverSystem).clientChannelPath = clientChannelPath;
	ret true;
}
SETSERVERDATABASE(){
	if(!serverSystem){
		ret false;
	}
	if(database == (*serverSystem).database){
		ret false;
	}
	(*serverSystem).database = database;
	(*database).owner = NONE_SERVER_OWNER;
	(*database).closeOnIdle = false;
	ret true;
}
SETSERVEROWNER(){
	Database *database;
	if(!serverSystem){
		ret false;
	}
	database = (*serverSystem).database;
	if(owner == (*database).owner){
		ret false;
	}
	(*database).owner = owner;
	ret true;
}
SETSERVEREXTENSIONBLOCKSIZE(){
	if(!serverSystem){
		ret false;
	}
	if(serverExtensionBlockSize == (*serverSystem).serverExtensionBlockSize){
		ret false;
	}
	(*serverSystem).serverExtensionBlockSize = serverExtensionBlockSize;
	ret true;
}
SETSERVERCLIENTBLOCKSIZE(){
	if(!serverSystem){
		ret false;
	}
	if(serverClientBlockSize == (*serverSystem).serverClientBlockSize){
		ret false;
	}
	(*serverSystem).serverClientBlockSize = serverClientBlockSize;
	ret true;
}
BOOTSERVERREPLYLOOPTHREAD(){
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).replyLoopThreadCreated or (*serverSystem).replyLoopRunning){
		ret false;
	}
	(*serverSystem).replyLoopRunning = true;
	(*serverSystem).replyLoopThreadCreated = pthread_create(&(*serverSystem).replyLoopThread, NULL, &serverReplyLoop, serverSystem) == PTHREAD_CREATE_SUCCESS;
	if(!(*serverSystem).replyLoopThreadCreated){
		(*serverSystem).replyLoopRunning = false;
		ret false;
	}
	ret true;
}
BOOTSERVEREVENTLOOPTHREAD(){
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).eventLoopThreadCreated or (*serverSystem).eventLoopRunning){
		ret false;
	}
	(*serverSystem).eventLoopRunning = true;
	(*serverSystem).eventLoopThreadCreated = pthread_create(&(*serverSystem).eventLoopThread, NULL, &serverEventLoop, serverSystem) == PTHREAD_CREATE_SUCCESS;
	if(!(*serverSystem).eventLoopThreadCreated){
		(*serverSystem).eventLoopRunning = false;
		ret false;
	}
	ret true;
}
BOOTSERVERREGISTRATIONLOOPTHREAD(){
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).registrationLoopThreadCreated or (*serverSystem).registrationLoopRunning){
		ret false;
	}
	(*serverSystem).registrationLoopRunning = true;
	(*serverSystem).registrationLoopThreadCreated = pthread_create(&(*serverSystem).registrationLoopThread, NULL, &serverRegistrationLoop, serverSystem) == PTHREAD_CREATE_SUCCESS;
	if(!(*serverSystem).registrationLoopThreadCreated){
		(*serverSystem).registrationLoopRunning = false;
		ret false;
	}
	ret true;
}



























/*! demon area on */

SERVERREPLYLOOP(){



	/*! success when? */



	ServerSystem *const serverSystem = arg;
	int replyEpollFd;
	bool success;
	if(!serverSystem){
		ret NULL;
	}
	replyEpollFd = 0;
	success = false;
	if((*serverSystem).replyEpollFd){
		jmp emergencyExit;
	}
	if(!(*serverSystem).replyLoopThreadCreated){
		(*serverSystem).replyLoopRunning = true;
	}
	replyEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(replyEpollFd == EPOLL_CREATE1_FAILURE){
		replyEpollFd = 0;
		jmp emergencyExit;
	}
	(*serverSystem).replyEpollFd = replyEpollFd;
	jmp replyLoop;
	replyLoop:{
		struct epoll_event eventStart[128];
		int eventAmount = epoll_wait(replyEpollFd, eventStart, countof(eventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
		struct epoll_event *eventCurrent;
		struct epoll_event *eventWall;
		if(!(*serverSystem).replyLoopRunning){
			jmp emergencyExit;
		}
		eventCurrent = eventStart;
		eventWall = eventCurrent + eventAmount;
		jmp parseRequestLoop;
		parseRequestLoop:{
			if(eventCurrent < eventWall){
				const int fd = (*eventCurrent).data.fd;
				if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
					if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP)){
						jmp closeConnection;
					}
					jmp closeConnection;
				}
				if((*eventCurrent).events & EPOLLIN){
					jmp readRequestLoop;
					readRequestLoop:{
						uint64 message;
						int returnValue = read(fd, &message, sizeof(message));
						if(fd != (*serverSystem).registrationEventFd){









							if(returnValue > 0){
								const uint32 id = message >> 32; /*! update */
								/*! add generation? */
								const uint8 requestAmount = message;
								ServerClient *serverClient;
								if(!requestAmount){
									jmp closeConnection;
								}
								serverClient = findServerClientFdId(serverSystem, fd, id);
								if(serverClient){
									parseServerClientRequests(serverSystem, serverClient, requestAmount);
								}else{
									fprintf(stdout, "could not find the client\n");
									/*! error in communication or bad actor? */
								}
							}elif(returnValue == -1){
								if(errno == EINTR){
									jmp readRequestLoop;
								}
								if(errno != EAGAIN and errno != EWOULDBLOCK){
									jmp closeConnection;
								}
							}else{
								jmp closeConnection;
								closeConnection:{
									ServerClient *const serverClient = findServerClientFd(serverSystem, fd);
									if(serverClient){
										removeServerClient(serverSystem, serverClient);
										fprintf(stdout, "disconnected %u\n", (*serverClient).clientId);
										if((*serverSystem).serverClientAllocated == 1 and (*serverSystem).database and (*(*serverSystem).database).closeOnIdle){
											fprintf(stdout, "reply thread exited due to no clients\n");
											jmp emergencyExit;
										}
									}
								}
							}









						}else{









							if(returnValue > 0){

								/*!*/

							}elif(returnValue == -1){
								if(errno == EINTR){
									jmp readRequestLoop;
								}

								/*!*/

							}else{

								/*!*/

							}



							if(!(*serverSystem).replyEventFd){
								struct epoll_event event;
								(*serverSystem).replyEventFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
								event.events = EPOLLIN;
								event.data.fd = (*serverSystem).replyEventFd; /*! what data to pass? */
								epoll_ctl((*serverSystem).registrationEpollFd, EPOLL_CTL_ADD, (*serverSystem).replyEventFd, &event); /*! errors? */
							}



							if(!insertServerClient(serverSystem, *((*serverSystem).fdCopy + 0), *((*serverSystem).fdCopy + 1), *((*serverSystem).fdCopy + 2))){
								*((*serverSystem).fdCopy + 0) = 0;
								*((*serverSystem).fdCopy + 1) = 0;
								*((*serverSystem).fdCopy + 2) = 0;
								jmp insertClientFailure;
								insertClientFailure:{
									const uint64 value = 1;
									(*serverSystem).clientOffset = 0;
									write((*serverSystem).replyEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
									inc eventCurrent;
									jmp parseRequestLoop;
								}
							}
							*((*serverSystem).fdCopy + 0) = 0;
							*((*serverSystem).fdCopy + 1) = 0;
							*((*serverSystem).fdCopy + 2) = 0;
							{
								const uint64 value = 1;
								(*serverSystem).clientOffset = (*serverSystem).serverClientAllocated - 1; /*! update when stack are in use */
								write((*serverSystem).replyEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
							}
							inc eventCurrent;
							jmp parseRequestLoop;









						}
					}
				}
				inc eventCurrent;
				jmp parseRequestLoop;
			}
			jmp replyLoop;
		}
	}
	emergencyExit:{
		removeAllServerClients(serverSystem);
		if(replyEpollFd){
			close(replyEpollFd); /*! on signal interrupt? */
			(*serverSystem).replyEpollFd = 0;
		}
		if(!(*serverSystem).replyLoopThreadCreated){
			(*serverSystem).replyLoopRunning = false;
		}
		if(!success){
			ret NULL;
		}
		ret serverSystem;
	}
}









#define EMITEVENT() /*-*/ bool  emitEvent(ServerSystem *const serverSystem, const uint32 extension, const uint32 eventType)

EMITEVENT(){
	uint32 realEventType;
	ServerEvent *event;
	EventSubscription *current;
	EventSubscription *wall;
	ServerClient *clientStart;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!extension or extension >= (*serverSystem).serverExtensionAllocated or !eventType){
		ret false;
	}
	realEventType = (*((*serverSystem).serverExtensionStart + extension)).serverExtensionBaseEvent + eventType;
	if(realEventType >= (*serverSystem).eventAllocated){
		ret false;
	}
	success = false;
	event = (*serverSystem).eventStart + realEventType;
	current = (*event).subscriptionStart;
	wall = current + (*event).subscriptionAllocated;
	clientStart = (*serverSystem).serverClientStart;
	jmp emitEventLoop;
	emitEventLoop:{
		if(current < wall){
			ServerClient *const serverClient = clientStart + (*current).clientOffset;
			if(isValidServerClient(serverSystem, serverClient)){
				Header *const header = (*serverClient).shmStart;
				uint32 eventCurrentWriter = (*header).eventCurrentWriter;
				uint32 eventSize = (*header).eventSize;
				uint32 eventPayloadSize = 0 * sizeof(uint8);
				uint64 response = ((uint64)eventCurrentWriter << 32) | 123123; /*! what do we return beyond the slot? */
				EventSlot *const eventSlot = (*serverClient).eventSlotStart + eventCurrentWriter;
				GenericEvent *const event = (*serverClient).eventCurrent;



				/*! handle space in a safer way */

				if((uint8 *)(*serverClient).eventCurrent >= (uint8 *)(*serverClient).eventStart + eventSize){
					(*serverClient).eventCurrent = (*serverClient).eventStart;
				}elif((uint8 *)(*serverClient).eventCurrent + sizeof(GenericEvent) + eventPayloadSize > (uint8 *)(*serverClient).eventStart + eventSize){
					(*serverClient).eventCurrent = (*serverClient).eventStart;
				}



				(*eventSlot).eventStartOffset = (uint8 *)event - (uint8 *)(*serverClient).eventStart;
				(*eventSlot).eventSize = sizeof(GenericEvent);
				(*event).eventType = eventType;
				(*event).extension = extension;
				(*event).payloadStartOffset = !!eventPayloadSize * sizeof(GenericEvent);
				(*event).payloadSize = eventPayloadSize;
				(*serverClient).eventCurrent += sizeof(GenericEvent) + eventPayloadSize;
				fprintf(stdout, "sending event   to   client %04u, event   slot @ %04u, sending data @ %04u %04u %04u %04u\n", (*current).clientOffset, eventCurrentWriter, (*event).eventType, (*event).extension, (*event).payloadStartOffset, (*event).payloadSize);
				write((*serverClient).serverClientEventWriteFd, &response, sizeof(response)); /*! errors? */
				(*header).eventCurrentWriter = (eventCurrentWriter + 1) % (*header).eventSlotSize;
				success = true;
			}
			inc current;
			jmp emitEventLoop;
		}
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}









SERVEREVENTLOOP(){



	/*! success when? */



	ServerSystem *const serverSystem = arg;
	int eventEpollFd;
	bool success;
	if(!serverSystem){
		ret NULL;
	}
	eventEpollFd = 0;
	success = false;
	if((*serverSystem).eventEpollFd){
		jmp emergencyExit;
	}
	if(!(*serverSystem).eventLoopThreadCreated){
		(*serverSystem).eventLoopRunning = true;
	}
	eventEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(eventEpollFd == EPOLL_CREATE1_FAILURE){
		eventEpollFd = 0;
		jmp emergencyExit;
	}
	(*serverSystem).eventEpollFd = eventEpollFd;
	jmp eventLoop;
	eventLoop:{
		struct epoll_event eventStart[1];
		int eventAmount = epoll_wait(eventEpollFd, eventStart, countof(eventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
		struct epoll_event *eventCurrent;
		struct epoll_event *eventWall;
		if(!(*serverSystem).eventLoopRunning){
			jmp emergencyExit;
		}
		eventCurrent = eventStart;
		eventWall = eventCurrent + eventAmount;
		jmp parseEventLoop;
		parseEventLoop:{
			if(eventCurrent < eventWall){
				const uint64 data = (*eventCurrent).data.u64;
				const int fd = data;
				const uint32 extension = data >> 32;
				if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
					if((*eventCurrent).events & (EPOLLRDHUP | EPOLLHUP)){



						/*!*/



						/*! exit to where? */
					}



					/*!*/



					/*! exit to where? */
				}
				if((*eventCurrent).events & EPOLLIN){
					jmp readGeneratedEventLoop;
					readGeneratedEventLoop:{
						uint64 message;
						int returnValue = read(fd, &message, sizeof(message));



						if(returnValue > 0){

							/*!*/

						}elif(returnValue == -1){

							/*!*/

						}else{

							/*!*/

						}



						if(extension and extension < (*serverSystem).serverExtensionAllocated){
							ServerExtension *const serverExtension = (*serverSystem).serverExtensionStart + extension;
							if((*serverExtension).serverExtensionEventFd == fd){
								emitEvent(serverSystem, extension, message);
							}
						}



					}
				}
				inc eventCurrent;
				jmp parseEventLoop;
			}
			jmp eventLoop;
		}
	}
	emergencyExit:{
		if(eventEpollFd){
			close(eventEpollFd); /*! on signal interrupt? */
			(*serverSystem).eventEpollFd = 0;
		}
		if(!(*serverSystem).eventLoopThreadCreated){
			(*serverSystem).eventLoopRunning = false;
		}
		if(!success){
			ret NULL;
		}
		ret serverSystem;
	}
}
SERVERREGISTRATIONLOOP(){
	ServerSystem *const serverSystem = arg;
	int registrationEpollFd;
	int socketConnection;
	struct sockaddr_un address;
	bool success;
	if(!serverSystem){
		ret NULL;
	}
	registrationEpollFd = 0;
	socketConnection = 0;
	success = false;
	if(!(*serverSystem).serverChannelPath or !(*serverSystem).clientChannelPath or (*serverSystem).registrationEpollFd){
		jmp emergencyExit;
	}
	if(!(*serverSystem).registrationLoopThreadCreated){
		(*serverSystem).registrationLoopRunning = true;
	}
	registrationEpollFd = epoll_create1(NONE_EPOLL_FLAG);
	if(registrationEpollFd == EPOLL_CREATE1_FAILURE){
		registrationEpollFd = 0;
		jmp emergencyExit;
	}
	(*serverSystem).registrationEpollFd = registrationEpollFd;
	jmp createServerClientChannelPath;
	createServerClientChannelPath:{
		FILE *const file = fopen((*serverSystem).clientChannelPath, "w");
		if(!file){
			jmp emergencyExit;
		}
		fclose(file);
		jmp createServerRegistrationLoopConnection;
	}
	createServerRegistrationLoopConnection:{
		uint concurrentConnectionAmount = 128; /*! parameterize */
		socketConnection = socket(AF_UNIX, SOCK_STREAM, NONE_SOCKET_PROTOCOL); /*! errors? */
		if(socketConnection == SOCKET_FAILURE){
			jmp emergencyExit;
		}
		address.sun_family = AF_UNIX;
		strcpy(address.sun_path, (*serverSystem).serverChannelPath);
		unlink((*serverSystem).serverChannelPath); /*! errors? */
		bind(socketConnection, (void *)&address, sizeof(address)); /*! errors? */
		listen(socketConnection, concurrentConnectionAmount); /*! errors? */
		jmp registrationLoop;
	}
	registrationLoop:{
		const int clientSocket = accept(socketConnection, NULL, NULL);
		int serverRequestReadFd;
		int clientReplyWriteFd;
		int clientEventWriteFd;
		if(!(*serverSystem).registrationLoopRunning){
			close(clientSocket); /*! on signal interrupt? */
			jmp emergencyExit;
		}
		if(!(*serverSystem).replyEpollFd){
			close(clientSocket); /*! on signal interrupt? */
			jmp registrationLoop;
		}
		{
			int fd[3];
			if(!receiveFd(clientSocket, countof(fd), fd)){ /*! errors? client might not send, how to mitigate? */
				close(clientSocket); /*! on signal interrupt? */
				jmp registrationLoop;
			}
			serverRequestReadFd = *(fd + 0);
			clientReplyWriteFd = *(fd + 1);
			clientEventWriteFd = *(fd + 2);
		}
		{
			const int flag = fcntl(serverRequestReadFd, F_GETFL, 0); /*! errors? */
			int returnValue;
			if(flag == FCNTL_FAILURE){
				close(clientEventWriteFd); /*! errors? */
				close(clientReplyWriteFd); /*! errors? */
				close(serverRequestReadFd); /*! errors? */
				close(clientSocket); /*! on signal interrupt? */
				jmp registrationLoop;
			}
			returnValue = fcntl(serverRequestReadFd, F_SETFL, flag | O_NONBLOCK); /*! errors? also why pick these ones? */
			if(returnValue == FCNTL_FAILURE){
				close(clientEventWriteFd); /*! errors? */
				close(clientReplyWriteFd); /*! errors? */
				close(serverRequestReadFd); /*! errors? */
				close(clientSocket); /*! on signal interrupt? */
				jmp registrationLoop;
			}
		}









		/*!*/

		{
			struct epoll_event event;
			event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
			event.data.fd = serverRequestReadFd; /*! what data to pass? */
			epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_ADD, serverRequestReadFd, &event); /*! errors? */
		}



		if(!(*serverSystem).registrationEventFd){
			struct epoll_event event;
			(*serverSystem).registrationEventFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
			event.events = EPOLLIN;
			event.data.fd = (*serverSystem).registrationEventFd; /*! what data to pass? */
			epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_ADD, (*serverSystem).registrationEventFd, &event); /*! errors? */
		}
		{
			const uint64 value = 1;
			*((*serverSystem).fdCopy + 0) = serverRequestReadFd;
			*((*serverSystem).fdCopy + 1) = clientReplyWriteFd;
			*((*serverSystem).fdCopy + 2) = clientEventWriteFd;
			write((*serverSystem).registrationEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
		}



		{
			struct epoll_event eventStart[1];
			uint64 message;
			int eventAmount = epoll_wait(registrationEpollFd, eventStart, countof(eventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
			int returnValue = read((*eventStart).data.fd, &message, sizeof(message));
			(void)eventAmount;
			(void)returnValue;
		}



		if(!(*serverSystem).clientOffset){
			const uint32 value = 0;
			send(clientSocket, &value, sizeof(value), 0); /*! error? */
		}else{
			ServerClient *const serverClient = (*serverSystem).serverClientStart + (*serverSystem).clientOffset;
			send(clientSocket, &(*serverClient).shmId, sizeof((*serverClient).shmId), 0); /*! error? */
			(*serverSystem).clientOffset = 0;
			fprintf(stdout, "connected %u on %i\n", (*serverClient).clientId, (*serverClient).shmId);
			success = true;
		}

		/*!*/









		close(clientSocket); /*! on signal interrupt? */
		jmp registrationLoop;
	}
	emergencyExit:{
		if((*serverSystem).serverChannelPath){
			unlink((*serverSystem).serverChannelPath); /*! what do? */
		}
		if(socketConnection){
			close(socketConnection); /*! on signal interrupt? */
		}
		if((*serverSystem).clientChannelPath){
			unlink((*serverSystem).clientChannelPath); /*! what do? */
		}
		if(registrationEpollFd){
			close(registrationEpollFd); /*! on signal interrupt? */
			(*serverSystem).registrationEpollFd = 0;
		}
		if(!(*serverSystem).registrationLoopThreadCreated){
			(*serverSystem).registrationLoopRunning = false;
		}
		if(!success){
			ret NULL;
		}
		ret serverSystem;
	}
}
INSERTSERVERCLIENT(){
	ServerClient *serverClient;
	uint64 clientId;
	int shmKey;
	int shmId;
	Header *shmStart;
	uint32 requestSlotSize;
	uint32 replySlotSize;
	uint32 eventSlotSize;
	uint32 requestSize;
	uint32 replySize;
	uint32 eventSize;
	Header header;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).clientChannelPath or !serverRequestReadFd or !clientReplyWriteFd or !clientEventWriteFd){
		ret false;
	}
	jmp insertClient;
	insertClient:{
		if((*serverSystem).serverClientAllocated == (*serverSystem).serverClientSize){
			void *temp;
			if(!(*serverSystem).serverClientBlockSize){
				ret false;
			}
			(*serverSystem).serverClientSize += (*serverSystem).serverClientBlockSize;
			temp = realloc((*serverSystem).serverClientStart, (*serverSystem).serverClientSize * sizeof(ServerClient));
			if(!temp){
				(*serverSystem).serverClientSize -= (*serverSystem).serverClientBlockSize;
				ret false;
			}
			(*serverSystem).serverClientStart = temp;
			if(!(*serverSystem).serverClientAllocated){
				inc (*serverSystem).serverClientAllocated;
				jmp insertClient;
			}
		}
		clientId = (*serverSystem).serverClientAllocated;
		requestSlotSize = 256; /*! parameterize */
		replySlotSize = 256; /*! parameterize */
		eventSlotSize = 256; /*! parameterize */
		requestSize = 16 * 1024; /*! parameterize */
		replySize = 16 * 1024; /*! parameterize */
		eventSize = 16 * 1024; /*! parameterize */
		shmKey = ftok((*serverSystem).clientChannelPath, clientId); /*! writeFileToKey() function. the lower 0x(F)FFF is the number given here */
		shmId = shmget(shmKey, sizeof(Header) + requestSlotSize * sizeof(RequestSlot) + replySlotSize * sizeof(ReplySlot) + eventSlotSize * sizeof(EventSlot) + requestSize * sizeof(uint8) + replySize * sizeof(uint8) + eventSize * sizeof(uint8), IPC_CREAT | 0666);
		if(!shmId){
			ret false;
		}
		shmStart = shmat(shmId, NULL, SHM_NONE); /*! params? */
		if(!shmStart){
			ret false;
		}
		clientId = 0 | clientId; /*! update the id sent back to have a generation and maybe a unique part */
		header.requestSlotSize = requestSlotSize;
		header.requestSize = requestSize;
		header.replySlotSize = replySlotSize;
		header.replySize = replySize;
		header.eventSlotSize = eventSlotSize;
		header.eventSize = eventSize;
		header.requestSlotStartOffset = 0 + sizeof(Header);
		header.replySlotStartOffset = header.requestSlotStartOffset + requestSlotSize * sizeof(RequestSlot);
		header.eventSlotStartOffset = header.replySlotStartOffset + replySlotSize * sizeof(ReplySlot);
		header.requestStartOffset = header.eventSlotStartOffset + eventSlotSize * sizeof(EventSlot);
		header.replyStartOffset = header.requestStartOffset + requestSize * sizeof(uint8);
		header.eventStartOffset = header.replyStartOffset + replySize * sizeof(uint8);
		header.requestCurrentWriter = 0;
		header.requestCurrentReader = 0;
		header.replyCurrentWriter = 0;
		header.replyCurrentReader = 0;
		header.eventCurrentWriter = 0;
		header.eventCurrentReader = 0;
		header.clientId = clientId;
		serverClient = (*serverSystem).serverClientStart + (*serverSystem).serverClientAllocated;
		(*serverClient).shmStart = shmStart;
		(*serverClient).requestSlotStart = (void *)((uint8 *)shmStart + header.requestSlotStartOffset);
		(*serverClient).replySlotStart = (void *)((uint8 *)shmStart + header.replySlotStartOffset);
		(*serverClient).eventSlotStart = (void *)((uint8 *)shmStart + header.eventSlotStartOffset);
		(*serverClient).requestStart = (void *)((uint8 *)shmStart + header.requestStartOffset);
		(*serverClient).requestCurrent = (*serverClient).requestStart;
		(*serverClient).replyStart = (void *)((uint8 *)shmStart + header.replyStartOffset);
		(*serverClient).replyCurrent = (*serverClient).replyStart;
		(*serverClient).eventStart = (void *)((uint8 *)shmStart + header.eventStartOffset);
		(*serverClient).eventCurrent = (*serverClient).eventStart;
		(*serverClient).shmId = shmId;
		(*serverClient).serverRequestReadFd = serverRequestReadFd;
		(*serverClient).serverClientReplyWriteFd = clientReplyWriteFd;
		(*serverClient).serverClientEventWriteFd = clientEventWriteFd;
		(*serverClient).clientId = clientId;



		/*!*/

		(*serverClient).subscriptionStart = NULL;
		(*serverClient).subscriptionSize = 0;
		(*serverClient).subscriptionAllocated = 0;
		(*serverClient)._eventStart = NULL;
		(*serverClient)._eventSize = 0;



		memcpy(shmStart, &header, sizeof(Header));
		inc (*serverSystem).serverClientAllocated;
		ret true;
	}
}









#define SUBSCRIBE() /*-*/ bool  subscribe(ServerSystem *const serverSystem, ServerClient *const client, const uint32 extension, uint32 eventMask, uint8 *const statusReturn)

uint64 getBitAmount(uint64 variable){
	variable = variable - ((variable >> 1) & b4(0101010101010101, 0101010101010101, 0101010101010101, 0101010101010101));
	variable = (variable & b4(0011001100110011, 0011001100110011, 0011001100110011, 0011001100110011)) + ((variable >> 2) & b4(0011001100110011, 0011001100110011, 0011001100110011, 0011001100110011));
	variable = (variable + (variable >> 4)) & b4(0000111100001111, 0000111100001111, 0000111100001111, 0000111100001111);
	variable = variable + (variable >> 8);
	variable = variable + (variable >> 16);
	variable = variable + (variable >> 32);
	ret variable & b(01111111);
}
SUBSCRIBE(){
	const uint32 blockSize = 16; /*!*/
	ServerExtension *serverExtension;
	ServerExtensionDescriptor *serverExtensionDescriptor;
	uint32 eventType;
	uint32 baseEvent;
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).eventAllocated < 2 or !isValidServerClient(serverSystem, client) or !extension or extension >= (*serverSystem).serverExtensionAllocated or !eventMask or !statusReturn){
		ret false;
	}
	serverExtension = (*serverSystem).serverExtensionStart + extension;
	if(!(*serverExtension).serverExtensionHandle){
		ret false;
	}
	serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
	eventType = 0;
	baseEvent = (*serverExtension).serverExtensionBaseEvent;



	/*! get bit amount to allocate subscriptions once? */
	(void)getBitAmount;

	/*! do a complete O(n) before the bit loop to allocate etc? */

	/*! use this later to allocate once for the amount of event types possible to be enumarated per this client */

	{
		uint32 eventMaskCopy = eventMask;
		uint64 largestEventType = 1;
		jmp findLargestEventTypeLoop;
		findLargestEventTypeLoop:{
			if(eventMaskCopy >>= 1){
				inc largestEventType;
				jmp findLargestEventTypeLoop;
			}
		}
	}



	jmp bitLoop;
	bitLoop:{
		if(eventMask){
			uint32 lowestBit = (eventMask & -eventMask) >> eventType;
			jmp advanceEventType;
			advanceEventType:{
				uint32 realEventType;
				if(lowestBit){
					inc eventType;
					lowestBit >>= 1;
					jmp advanceEventType;
				}
				realEventType = baseEvent + eventType;
				if(realEventType >= (*client)._eventSize or !*((*client)._eventStart + realEventType)){
					if(realEventType < (*client)._eventSize and *((*client)._eventStart + realEventType)){
						*statusReturn |= SUCCESS_REPLY_STATUS;
					}else{
						ServerEvent *const event = (*serverSystem).eventStart + realEventType;
						if((*client).subscriptionAllocated == (*client).subscriptionSize){
							void *temp;
							(*client).subscriptionSize += blockSize;
							temp = realloc((*client).subscriptionStart, (*client).subscriptionSize * sizeof(ClientSubscription));
							if(!temp){
								(*client).subscriptionSize -= blockSize;
								ret false;
							}
							(*client).subscriptionStart = temp;
						}
						if(realEventType >= (*client)._eventSize){
							const uint size = realEventType + 1;
							void *temp;
							temp = realloc((*client)._eventStart, size * sizeof(uint32));
							if(!temp){
								ret false;
							}
							memset((uint8 *)temp + (*client)._eventSize, 0, size - (*client)._eventSize);
							(*client)._eventStart = temp;
							(*client)._eventSize = size;
						}
						if((*event).subscriptionAllocated == (*event).subscriptionSize){
							void *temp;
							(*event).subscriptionSize += blockSize;
							temp = realloc((*event).subscriptionStart, (*event).subscriptionSize * sizeof(EventSubscription));
							if(!temp){
								(*event).subscriptionSize -= blockSize;
								ret false;
							}
							(*event).subscriptionStart = temp;
						}
						if((*serverExtensionDescriptor).incrementServerExtensionDescriptorEventCounter){
							if((*(*serverExtensionDescriptor).incrementServerExtensionDescriptorEventCounter)(eventType)){
								ClientSubscription *const clientSubscription = (*client).subscriptionStart + (*client).subscriptionAllocated;
								EventSubscription *const eventSubscription = (*event).subscriptionStart + (*event).subscriptionAllocated;
								(*clientSubscription).eventType = realEventType;
								(*clientSubscription).eventSubscriptionOffset = (*event).subscriptionAllocated;
								(*eventSubscription).clientOffset = client - (*serverSystem).serverClientStart;
								(*eventSubscription).clientSubscriptionOffset = (*client).subscriptionAllocated;
								inc (*client).subscriptionAllocated;
								inc (*event).subscriptionAllocated;
								*((*client)._eventStart + realEventType) = (*event).subscriptionAllocated;
								*statusReturn |= UPDATED_REPLY_STATUS;
								fprintf(stdout, "subscribed\n");
							}
						}
					}
				}
				eventMask &= eventMask - 1;
				jmp bitLoop;
			}
		}
		ret true;
	}
}



#define UNSUBSCRIBE() /*-*/ bool  unsubscribe(ServerSystem *const serverSystem, ServerClient *const client, const uint32 extension, uint32 eventMask, uint8 *const statusReturn)

UNSUBSCRIBE(){
	ServerExtension *serverExtension;
	ServerExtensionDescriptor *serverExtensionDescriptor;
	uint32 eventType;
	uint32 baseEvent;
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).eventAllocated < 2 or !isValidServerClient(serverSystem, client) or !extension or extension >= (*serverSystem).serverExtensionAllocated or !eventMask or !statusReturn){
		ret false;
	}
	serverExtension = (*serverSystem).serverExtensionStart + extension;
	if(!(*serverExtension).serverExtensionHandle){
		ret false;
	}
	serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
	eventType = 0;
	baseEvent = (*serverExtension).serverExtensionBaseEvent;
	jmp bitLoop;
	bitLoop:{
		if(eventMask){
			uint32 lowestBit = (eventMask & -eventMask) >> eventType;
			jmp advanceEventType;
			advanceEventType:{
				uint32 realEventType;
				if(lowestBit){
					inc eventType;
					lowestBit >>= 1;
					jmp advanceEventType;
				}
				realEventType = baseEvent + eventType;
				if(realEventType < (*client)._eventSize){
					ServerEvent *const event = (*serverSystem).eventStart + realEventType;




















					fprintf(stdout, "event size from unsub is %u\n", (*client)._eventSize);



					if(realEventType < (*serverSystem).eventAllocated){
						uint32 eventSubscriptionOffset = *((*client)._eventStart + realEventType);
						if(!eventSubscriptionOffset){
							*statusReturn |= SUCCESS_REPLY_STATUS;
						}else{
							dec eventSubscriptionOffset;









							if((*serverExtensionDescriptor).decrementServerExtensionDescriptorEventCounter){
								if((*(*serverExtensionDescriptor).decrementServerExtensionDescriptorEventCounter)(eventType)){









									const uint32 clientSubscriptionOffset = (*((*event).subscriptionStart + eventSubscriptionOffset)).clientSubscriptionOffset;
									const uint32 lastClientSubscriptionOffset = (*client).subscriptionAllocated - 1;
									const uint32 lastEventSubscriptionOffset = (*event).subscriptionAllocated - 1;



									if(clientSubscriptionOffset != lastClientSubscriptionOffset){
										const ClientSubscription lastClientSubscription = *((*client).subscriptionStart + lastClientSubscriptionOffset);
										*((*client).subscriptionStart + clientSubscriptionOffset) = lastClientSubscription;
										*((*client)._eventStart + lastClientSubscription.eventType) = clientSubscriptionOffset;
										(*((*((*serverSystem).eventStart + lastClientSubscription.eventType)).subscriptionStart + lastClientSubscription.eventSubscriptionOffset)).clientSubscriptionOffset = clientSubscriptionOffset;
									}



									if(eventSubscriptionOffset != lastEventSubscriptionOffset){
										const EventSubscription lastEventSubscription = *((*event).subscriptionStart + lastEventSubscriptionOffset);
										*((*event).subscriptionStart + eventSubscriptionOffset) = lastEventSubscription;
										(*((*((*serverSystem).serverClientStart + lastEventSubscription.clientOffset)).subscriptionStart + lastEventSubscription.clientSubscriptionOffset)).eventSubscriptionOffset = eventSubscriptionOffset;
									}



									dec (*client).subscriptionAllocated;
									dec (*event).subscriptionAllocated;



									*((*client)._eventStart + realEventType) = 0;









									*statusReturn |= UPDATED_REPLY_STATUS;
									fprintf(stdout, "unsubscribed\n");
								}
							}









						}
					}









				}
				eventMask &= eventMask - 1;
				jmp bitLoop;
			}
		}
		ret true;
	}
}









/*! what happens when there is not enough space for the reply data to exist in? how do i handle that? maybe return the size via parseExtensionRequest()? malloc() the data to send later? when is later? */

PARSESERVERCLIENTREQUESTS(){
	uint current;
	uint wall;
	Header *header;
	uint32 requestCurrentReader;
	uint32 requestSlotSize;
	uint32 replyCurrentWriter;
	uint32 replySize;



	/*!*/

	uint32 replySlotSize;



	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).database or !isValidServerClient(serverSystem, serverClient) or !requestAmount){
		ret false;
	}



	/*! if not able to write reply, because the buffer is full, do... what? */



	current = 0;
	wall = requestAmount;
	header = (*serverClient).shmStart;
	requestCurrentReader = (*header).requestCurrentReader;
	requestSlotSize = (*header).requestSlotSize;
	replyCurrentWriter = (*header).replyCurrentWriter;
	replySize = (*header).replySize;



	/*!*/

	replySlotSize = (*header).replySlotSize;



	success = false;
	jmp parseServerClientRequestLoop;
	parseServerClientRequestLoop:{
		if(current < wall){
			uint8 requestType;
			uint8 extension;
			bool sendReply;
			uint32 token;
			uint8 status;
			uint32 replyPayloadSize;
			uint32 extensionId; /*! temporary variable for the enable extension request */
			uint32 extensionBaseEvent; /*! temporary variable for the enable extension request */
			jmp processRequest;
			processRequest:{
				RequestSlot *const requestSlot = (*serverClient).requestSlotStart + requestCurrentReader;
				GenericRequest *const request = (void *)((uint8 *)(*serverClient).requestStart + (*requestSlot).requestStartOffset);
				uint32 payloadStartOffset;
				uint32 payloadSize;
				uint32 itemAmount;
				if((*requestSlot).requestSize != sizeof(GenericRequest) or (*requestSlot).requestStartOffset + (*requestSlot).requestSize > (*header).requestSize or (*requestSlot).requestStartOffset + (*requestSlot).requestSize + (*request).payloadSize > (*header).requestSize){
					requestCurrentReader = (requestCurrentReader + 1) % requestSlotSize;
					jmp sendBadRequest;
				}
				requestType = (*request).requestType;
				extension = (*request).extension;
				sendReply = (*request).sendReply;
				token = (*request).token;
				payloadStartOffset = (*request).payloadStartOffset;
				payloadSize = (*request).payloadSize;
				itemAmount = 0;
				if(payloadStartOffset and payloadSize){
					itemAmount = *(uint32 *)((uint8 *)request + payloadStartOffset);
				}
				fprintf(stdout, "parsing request from client %04u, request slot @ %04u, parsed  data @ %04u %04u %04u %04u %04u %04u\n", (uint32)(serverClient - (*serverSystem).serverClientStart), requestCurrentReader, (*request).requestType, (*request).extension, (*request).sendReply, (*request).token, (*request).payloadStartOffset, (*request).payloadSize);
				requestCurrentReader = (requestCurrentReader + 1) % requestSlotSize;
				status = NONE_REPLY_STATUS;
				replyPayloadSize = 0 * sizeof(uint8);
				if(extension){
					ServerExtension *const serverExtension = (*serverSystem).serverExtensionStart + extension;
					ServerExtensionDescriptor *serverExtensionDescriptor;
					if(extension >= (*serverSystem).serverExtensionAllocated){
						jmp sendBadRequest;
					}
					serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
					if(!(*serverExtensionDescriptor).parseServerExtensionDescriptorRequest){
						jmp sendBadRequest;
					}
					if(!(*(*serverExtensionDescriptor).parseServerExtensionDescriptorRequest)(request, itemAmount, &status, &replyPayloadSize)){
						jmp sendBadRequest;
					}
				}else{
					switch(requestType){
						to NONE_SERVER_REQUEST_TYPE:{
							jmp sendBadRequest;
						}
						to NO_OPERATION_SERVER_REQUEST_TYPE:{
							if(itemAmount == NO_OPERATION_SERVER_REQUEST_ITEM_AMOUNT){
								status |= SUCCESS_REPLY_STATUS;
							}
							brk;
						}
						to SYNC_SERVER_REQUEST_TYPE:{
							if(itemAmount == SYNC_SERVER_REQUEST_ITEM_AMOUNT){
								status |= SUCCESS_REPLY_STATUS;
							}
							brk;
						}
						to CLAIM_OWNERSHIP_SERVER_REQUEST_TYPE:{
							if(itemAmount == CLAIM_OWNERSHIP_SERVER_REQUEST_ITEM_AMOUNT){
								Database *const database = (*serverSystem).database;
								if(!(*database).owner){
									(*database).owner = (*serverClient).clientId;
									status |= SUCCESS_REPLY_STATUS;
								}
							}
							brk;
						}
						to CLOSE_ON_IDLE_SERVER_REQUEST_TYPE:{
							if(itemAmount == CLOSE_ON_IDLE_SERVER_REQUEST_ITEM_AMOUNT){
								Database *const database = (*serverSystem).database;
								if((*database).owner == (*serverClient).clientId){
									(*database).closeOnIdle = true;
									status |= SUCCESS_REPLY_STATUS;
								}
							}
							brk;
						}
						to ENABLE_EXTENSION_SERVER_REQUEST_TYPE:{
							if(itemAmount == ENABLE_EXTENSION_SERVER_REQUEST_ITEM_AMOUNT){
								Database *const database = (*serverSystem).database;
								EnableExtensionServerRequest enableExtensionServerRequest;
								if(unpackRequest(request, ENABLE_EXTENSION_SERVER_REQUEST_ITEM_AMOUNT, &enableExtensionServerRequest)){
									if(!*(enableExtensionServerRequest.pathStart + enableExtensionServerRequest.pathSize - 1)){
										if(loadServerExtension(serverSystem, (*database).owner == (*serverClient).clientId, enableExtensionServerRequest.pathStart, &extensionId)){
											const ServerExtension *const serverExtension = (*serverSystem).serverExtensionStart + extensionId;
											const ServerExtensionDescriptor *const serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
											if((*(*serverExtensionDescriptor).initServerExtensionDescriptorSystem)()){
												(*(*serverExtensionDescriptor).setServerExtensionDescriptorEventFd)((*serverExtension).serverExtensionEventFd);
												if((*serverExtension).serverExtensionReferenceCount == 1){
													status |= UPDATED_REPLY_STATUS;
												}
												extensionBaseEvent = (*serverExtension).serverExtensionBaseEvent;
												status |= SUCCESS_REPLY_STATUS;
												replyPayloadSize = 2 * sizeof(uint32);
											}
										}
									}
								}
							}
							brk;
						}
						to SEAL_OWNERSHIP_SERVER_REQUEST_TYPE:{
							if(itemAmount == SEAL_OWNERSHIP_SERVER_REQUEST_ITEM_AMOUNT){
								Database *const database = (*serverSystem).database;
								if((*database).owner == (*serverClient).clientId){
									(*database).owner = SEALED_SERVER_OWNER;
									status |= SUCCESS_REPLY_STATUS;
								}
							}
							brk;
						}
						to APPLY_FOR_EVENT_SERVER_REQUEST_TYPE:{
							if(itemAmount == APPLY_FOR_EVENT_SERVER_REQUEST_ITEM_AMOUNT){
								ApplyForEventServerRequest applyForEventServerRequest;
								if(unpackRequest(request, APPLY_FOR_EVENT_SERVER_REQUEST_ITEM_AMOUNT, &applyForEventServerRequest)){
									const uint32 extension = *(uint32 *)applyForEventServerRequest.extensionStart;
									const uint32 eventMask = *(uint32 *)applyForEventServerRequest.eventMaskStart;
									subscribe(serverSystem, serverClient, extension, eventMask, &status);
								}
							}
							brk;
						}
						to WITHDRAW_FROM_EVENT_SERVER_REQUEST_TYPE:{
							if(itemAmount == WITHDRAW_FROM_EVENT_SERVER_REQUEST_ITEM_AMOUNT){
								WithdrawFromEventServerRequest withdrawFromEventServerRequest;
								if(unpackRequest(request, WITHDRAW_FROM_EVENT_SERVER_REQUEST_ITEM_AMOUNT, &withdrawFromEventServerRequest)){
									const uint32 extension = *(uint32 *)withdrawFromEventServerRequest.extensionStart;
									const uint32 eventMask = *(uint32 *)withdrawFromEventServerRequest.eventMaskStart;
									unsubscribe(serverSystem, serverClient, extension, eventMask, &status);
								}
							}
							brk;
						}
						off:{
							jmp sendBadRequest;
						}
					}
				}
				replyPayloadSize = !!(status & SUCCESS_REPLY_STATUS) * replyPayloadSize;
				success = true;
				jmp formReply;
			}
			formReply:{
				if(sendReply and sizeof(GenericReply) + replyPayloadSize <= replySize){
					const uint64 response = ((uint64)replyCurrentWriter << 32) | token;
					ReplySlot *const replySlot = (*serverClient).replySlotStart + replyCurrentWriter;
					GenericReply *const reply = (*serverClient).replyCurrent;



					/*! handle space in a safer way */

					if((uint8 *)(*serverClient).replyCurrent >= (uint8 *)(*serverClient).replyStart + replySize){
						(*serverClient).replyCurrent = (*serverClient).replyStart;
					}elif((uint8 *)(*serverClient).replyCurrent + sizeof(GenericReply) + replyPayloadSize > (uint8 *)(*serverClient).replyStart + replySize){
						(*serverClient).replyCurrent = (*serverClient).replyStart;
					}



					replyCurrentWriter = (replyCurrentWriter + 1) % replySlotSize;
					if(status & SUCCESS_REPLY_STATUS){
						if(extension){
							ServerExtension *const serverExtension = (*serverSystem).serverExtensionStart + extension;
							ServerExtensionDescriptor *serverExtensionDescriptor;
							if(extension >= (*serverSystem).serverExtensionAllocated){
								jmp sendBadRequest;
							}
							serverExtensionDescriptor = (*serverExtension).serverExtensionDescriptor;
							if(!(*serverExtensionDescriptor).parseServerExtensionDescriptorReply){
								jmp sendBadRequest;
							}
							if(!(*(*serverExtensionDescriptor).parseServerExtensionDescriptorReply)(requestType, reply)){
								jmp sendBadRequest;
							}
						}else{
							switch(requestType){
								to NONE_SERVER_REPLY_TYPE:{
									jmp sendBadRequest;
								}
								to NO_OPERATION_SERVER_REPLY_TYPE:{
									brk;
								}
								to SYNC_SERVER_REPLY_TYPE:{
									brk;
								}
								to CLAIM_OWNERSHIP_SERVER_REPLY_TYPE:{
									brk;
								}
								to CLOSE_ON_IDLE_SERVER_REQUEST_TYPE:{
									brk;
								}
								to ENABLE_EXTENSION_SERVER_REPLY_TYPE:{
									(*(EnableExtensionServerReply *)reply).extension = extensionId;
									(*(EnableExtensionServerReply *)reply).baseEvent = extensionBaseEvent;
									brk;
								}
								to SEAL_OWNERSHIP_SERVER_REPLY_TYPE:{
									brk;
								}
								to APPLY_FOR_EVENT_SERVER_REPLY_TYPE:{
									brk;
								}
								off:{
									jmp sendBadRequest;
								}
							}
						}
					}
					(*replySlot).replyStartOffset = (uint8 *)reply - (uint8 *)(*serverClient).replyStart;
					(*replySlot).replySize = sizeof(GenericReply);
					(*reply).replyType = requestType;
					(*reply).extension = extension;
					(*reply).status = status;
					(*reply).token = token;
					(*reply).payloadStartOffset = !!replyPayloadSize * sizeof(GenericReply);
					(*reply).payloadSize = replyPayloadSize;
					(*serverClient).replyCurrent += sizeof(GenericReply) + replyPayloadSize;
					fprintf(stdout, "sending reply   to   client %04u, reply   slot @ %04u, sending back @ %04u %04u %04u %04u %04u %04u\n", (uint32)(serverClient - (*serverSystem).serverClientStart), (*replySlot).replyStartOffset, (*reply).replyType, (*reply).extension, (*reply).status, (*reply).token, (*reply).payloadStartOffset, (*reply).payloadSize);
					write((*serverClient).serverClientReplyWriteFd, &response, sizeof(response)); /*! errors? */
					success = true;
				}
				inc current;
				jmp parseServerClientRequestLoop;
				sendBadRequest:{
					const uint64 response = 0; /*! do something better? */
					fprintf(stdout, "sending back  bad response\n");
					write((*serverClient).serverClientReplyWriteFd, &response, sizeof(response)); /*! errors? */
					inc current;
					jmp parseServerClientRequestLoop;
				}
			}
		}
		(*header).replyCurrentWriter = replyCurrentWriter;
		(*header).requestCurrentReader = requestCurrentReader;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}



/*!*/

bool roundUpToMultiple(const uint64 number, const uint64 multiple){
	ret (number + multiple - 1) / multiple * multiple;
}



LOADSERVEREXTENSION(){
	void *serverExtensionHandle;
	ServerExtensionDescriptor *serverExtensionDescriptor;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!path or !extensionIdReturn){
		ret false;
	}
	serverExtensionHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
	success = false;
	if(serverExtensionHandle){
		ServerExtension *const start = (*serverSystem).serverExtensionStart;
		ServerExtension *current = start + 1;
		ServerExtension *const wall = start + (*serverSystem).serverExtensionAllocated;
		jmp findServerExtensionLoop;
		findServerExtensionLoop:{
			if(current < wall){
				if((*current).serverExtensionHandle == serverExtensionHandle){
					inc (*current).serverExtensionReferenceCount;
					*extensionIdReturn = current - start;
					success = true;
					jmp emergencyExit;
				}
				inc current;
				jmp findServerExtensionLoop;
			}
			jmp emergencyExit;
		}
	}
	if(!force){
		jmp emergencyExit;
	}
	serverExtensionHandle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
	if(!serverExtensionHandle){
		jmp emergencyExit;
	}
	serverExtensionDescriptor = dlsym(serverExtensionHandle, "serverExtensionDescriptor");
	if(!serverExtensionDescriptor){
		jmp emergencyExit;
	}
	if((*serverExtensionDescriptor).descriptorSize != sizeof(ServerExtensionDescriptor) or (*serverExtensionDescriptor).protocolVersion > SERVER_PROTOCOL_VERSION or !(*serverExtensionDescriptor).extensionNameSize or !(*serverExtensionDescriptor).extensionName or !(*serverExtensionDescriptor).authorNameSize or !(*serverExtensionDescriptor).authorName or !(*serverExtensionDescriptor).initServerExtensionDescriptorSystem or !(*serverExtensionDescriptor).setServerExtensionDescriptorEventFd or !(*serverExtensionDescriptor).incrementServerExtensionDescriptorEventCounter or !(*serverExtensionDescriptor).decrementServerExtensionDescriptorEventCounter or !(*serverExtensionDescriptor).parseServerExtensionDescriptorRequest or !(*serverExtensionDescriptor).parseServerExtensionDescriptorReply or !(*serverExtensionDescriptor).parseServerExtensionDescriptorEvent or !(*serverExtensionDescriptor).finiServerExtensionDescriptorSystem){
		jmp emergencyExit;
	}



	/*! check for duplicates? */



	jmp insertExtension;
	insertExtension:{
		ServerExtension *serverExtension;
		if((*serverSystem).serverExtensionAllocated == (*serverSystem).serverExtensionSize){
			void *temp;
			if(!(*serverSystem).serverExtensionBlockSize){
				jmp emergencyExit;
			}
			(*serverSystem).serverExtensionSize += (*serverSystem).serverExtensionBlockSize;
			temp = realloc((*serverSystem).serverExtensionStart, (*serverSystem).serverExtensionSize * sizeof(ServerExtension));
			if(!temp){
				(*serverSystem).serverExtensionSize -= (*serverSystem).serverExtensionBlockSize;
				jmp emergencyExit;
			}
			(*serverSystem).serverExtensionStart = temp;
			if(!(*serverSystem).serverExtensionAllocated){
				inc (*serverSystem).serverExtensionAllocated;
				jmp insertExtension;
			}
		}
		serverExtension = (*serverSystem).serverExtensionStart + (*serverSystem).serverExtensionAllocated;
		{
			const uint32 blockSize = 16; /*!*/
			uint amount = (*serverExtensionDescriptor).eventAmount;
			if((*serverSystem).eventAllocated + amount > (*serverSystem).eventSize){
				uint addedAmount;
				void *temp;
				if(!blockSize){
					jmp emergencyExit;
				}
				addedAmount = roundUpToMultiple((*serverSystem).eventAllocated + amount + !!(*serverSystem).eventAllocated, blockSize) - (*serverSystem).eventSize;
				(*serverSystem).eventSize += addedAmount;
				temp = realloc((*serverSystem).eventStart, (*serverSystem).eventSize * sizeof(ServerEvent));
				if(!temp){
					(*serverSystem).eventSize -= addedAmount;
					jmp emergencyExit;
				}
				(*serverSystem).eventStart = temp;
				if(!(*serverSystem).eventAllocated){
					inc (*serverSystem).eventAllocated;
				}
			}
			{
				ServerEvent *current = (*serverSystem).eventStart + (*serverSystem).eventAllocated;
				ServerEvent *const wall = current + amount;
				jmp setEventLoop;
				setEventLoop:{
					if(current < wall){
						(*current).subscriptionStart = NULL;
						(*current).subscriptionSize = 0;
						(*current).subscriptionAllocated = 0;
						inc current;
						jmp setEventLoop;
					}
				}
			}
		}
		if(!(*serverSystem).baseEvent){
			inc (*serverSystem).baseEvent;
		}
		(*serverExtension).serverExtensionHandle = serverExtensionHandle;
		(*serverExtension).serverExtensionDescriptor = serverExtensionDescriptor;
		(*serverExtension).serverExtensionReferenceCount = 1;
		(*serverExtension).serverExtensionEventFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
		(*serverExtension).serverExtensionBaseEvent = (*serverSystem).baseEvent - 1;
		(*serverSystem).baseEvent += (*(*serverExtension).serverExtensionDescriptor).eventAmount;
		(*serverSystem).eventAllocated += (*(*serverExtension).serverExtensionDescriptor).eventAmount;
		if((*serverSystem).eventEpollFd){
			struct epoll_event event;
			event.events = EPOLLIN;
			event.data.u64 = ((uint64)(*serverSystem).serverExtensionAllocated << 32) | (*serverExtension).serverExtensionEventFd;
			epoll_ctl((*serverSystem).eventEpollFd, EPOLL_CTL_ADD, (*serverExtension).serverExtensionEventFd, &event); /*! errors? */
		}
		*extensionIdReturn = (*serverSystem).serverExtensionAllocated;
		inc (*serverSystem).serverExtensionAllocated;
		success = true;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(!success){
			if(serverExtensionHandle){
				dlclose(serverExtensionHandle);
			}
			ret false;
		}
		ret true;
	}
}
UNLOADSERVEREXTENSION(){
	if(!serverSystem){
		ret false;
	}



	/*!*/



	ret true;
}

/*! demon area off */



























REMOVESERVERCLIENT(){
	if(!serverSystem){
		ret false;
	}
	if(!isValidServerClient(serverSystem, serverClient)){
		ret false;
	}
	if((*serverSystem).replyEpollFd){
		epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_DEL, (*serverClient).serverRequestReadFd, NULL); /*! errors? */
	}
	shmctl((*serverClient).shmId, IPC_RMID, NULL); /*! errors? */
	shmdt((*serverClient).shmStart); /*! errors? */
	close((*serverClient).serverRequestReadFd); /*! on signal interrupt? */
	close((*serverClient).serverClientReplyWriteFd); /*! on signal interrupt? */
	close((*serverClient).serverClientEventWriteFd); /*! on signal interrupt? */
	(*serverClient).clientId = 0;
	if(serverClient - (*serverSystem).serverClientStart == (*serverSystem).serverClientAllocated - 1){
		dec (*serverSystem).serverClientAllocated;
	}
	ret true;
}
REMOVEALLSERVERCLIENTS(){
	ServerClient *current;
	ServerClient *wall;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).serverClientStart and !(*serverSystem).serverClientSize and !(*serverSystem).serverClientAllocated){
		ret false;
	}
	current = (*serverSystem).serverClientStart + 1;
	wall = current + (*serverSystem).serverClientAllocated;
	success = false;
	if((*serverSystem).replyEpollFd){
		jmp removeServerClientLoop;
		removeServerClientLoop:{
			if(current < wall){
				removeServerClient(serverSystem, current);
				inc current;
				jmp removeServerClientLoop;
			}
		}
	}
	free((*serverSystem).serverClientStart);
	(*serverSystem).serverClientStart = NULL;
	(*serverSystem).serverClientSize = 0;
	(*serverSystem).serverClientAllocated = 0;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
QUITSERVERREGISTRATIONLOOPTHREAD(){
	int socketConnection;
	struct sockaddr_un address;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).registrationLoopRunning){
		ret false;
	}
	socketConnection = socket(AF_UNIX, SOCK_STREAM, NONE_SOCKET_PROTOCOL);
	if(socketConnection == SOCKET_FAILURE){
		ret false;
	}
	address.sun_family = AF_UNIX;
	strcpy(address.sun_path, (*serverSystem).serverChannelPath); /*! replace with toolkit function */
	(*serverSystem).registrationLoopRunning = false;
	connect(socketConnection, (void *)&address, sizeof(address));
	close(socketConnection); /*! on signal interrupt? */
	ret true;
}
QUITSERVERREPLYLOOPTHREAD(){
	int signalEventFd;
	struct epoll_event event;
	uint64 value;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).replyEpollFd or !(*serverSystem).replyLoopRunning){
		ret false;
	}
	signalEventFd = (*serverSystem).signalEventFd;
	if(!signalEventFd){
		signalEventFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
		(*serverSystem).signalEventFd = signalEventFd;
	}
	event.events = EPOLLIN;
	event.data.fd = signalEventFd; /*! what data to pass? */
	value = 1;
	epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_ADD, signalEventFd, &event); /*! errors? */
	(*serverSystem).replyLoopRunning = false;
	write(signalEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
	ret true;
}
QUITSERVEREVENTLOOPTHREAD(){
	int signalEventFd;
	struct epoll_event event;
	uint64 value;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).eventEpollFd or !(*serverSystem).eventLoopRunning){
		ret false;
	}
	signalEventFd = (*serverSystem).signalEventFd;
	if(!signalEventFd){
		signalEventFd = eventfd(0, EFD_NONBLOCK); /*! errors? */
		(*serverSystem).signalEventFd = signalEventFd;
	}
	event.events = EPOLLIN;
	event.data.fd = signalEventFd; /*! what data to pass? */
	value = 1;
	epoll_ctl((*serverSystem).eventEpollFd, EPOLL_CTL_ADD, signalEventFd, &event); /*! errors? */
	(*serverSystem).eventLoopRunning = false;
	write(signalEventFd, &value, sizeof(value)); /*! on signal interrupt? */ /*! errors? */
	ret true;
}
AWAITSERVERREGISTRATIONLOOPTHREADEXIT(){
	void *serverSystemReturn;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).registrationLoopThreadCreated){
		ret false;
	}
	pthread_join((*serverSystem).registrationLoopThread, &serverSystemReturn);
	(*serverSystem).registrationLoopThreadCreated = false;
	if(!serverSystemReturn){
		ret false;
	}
	ret true;
}

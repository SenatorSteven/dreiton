AWAITSERVERCLIENTREGISTRATIONTHREADEXIT(){
	void *serverSystemReturn;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).clientRegistrationThreadCreated){
		ret false;
	}
	pthread_join((*serverSystem).clientRegistrationThread, &serverSystemReturn);
	(*serverSystem).clientRegistrationThreadCreated = false;
	if(!serverSystemReturn){
		ret false;
	}
	ret true;
}

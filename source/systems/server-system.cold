REMOVEALLSERVERCLIENTS(){
	ServerClient *current;
	ServerClient *wall;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).serverClientStart and !(*serverSystem).serverClientSize and !(*serverSystem).serverClientAllocated){
		ret false;
	}
	current = (*serverSystem).serverClientStart;
	wall = current + (*serverSystem).serverClientAllocated;
	success = false;
	if((*serverSystem).replyEpollFd){
		jmp removeServerClientLoop;
		removeServerClientLoop:{
			if(current < wall){
				if((*current).serverClientId){



					epoll_ctl((*serverSystem).replyEpollFd, EPOLL_CTL_DEL, (*current).serverRequestReadFd, NULL); /*! errors? */
					shmctl((*current).shmId, IPC_RMID, NULL); /*! errors? */
					shmdt((*current).shmStart); /*! errors? */
					close((*current).serverRequestReadFd); /*! on signal interrupt? */ /*! errors? */
					close((*current).serverClientReplyWriteFd); /*! on signal interrupt? */ /*! errors? */
					close((*current).serverClientEventWriteFd); /*! on signal interrupt? */ /*! errors? */



					success = true;
				}
				inc current;
				jmp removeServerClientLoop;
			}
		}
	}
	jmp emergencyExit;
	emergencyExit:{
		free((*serverSystem).serverClientStart);
		(*serverSystem).serverClientStart = NULL;
		(*serverSystem).serverClientSize = 0;
		(*serverSystem).serverClientAllocated = 0;
		if(!success){
			ret false;
		}
		ret true;
	}
}
REMOVEALLSERVEREXTENSIONS(){
	const ServerExtension *start;
	const ServerExtension *current;
	const ServerExtension *wall;
	bool success;
	if(!serverSystem){
		ret false;
	}
	if(!(*serverSystem).serverExtensionStart and !(*serverSystem).serverExtensionSize and !(*serverSystem).serverExtensionAllocated){
		ret false;
	}
	start = (*serverSystem).serverExtensionStart;
	current = start + 1;
	wall = start + (*serverSystem).serverExtensionAllocated;
	success = false;
	jmp removeServerExtensionLoop;
	removeServerExtensionLoop:{
		if(current < wall){



			/*! make sure to use a stack for this one */

			dlclose((*current).serverExtensionHandle);



			success = true;
			inc current;
			jmp removeServerExtensionLoop;
		}
		jmp emergencyExit;
	}
	emergencyExit:{
		free((*serverSystem).serverExtensionStart);
		(*serverSystem).serverExtensionStart = NULL;
		(*serverSystem).serverExtensionSize = 0;
		(*serverSystem).serverExtensionAllocated = 0;
		if(!success){
			ret false;
		}
		ret true;
	}
}
FINDSERVERCLIENTFD(){
	ServerClient *current;
	ServerClient *wall;
	if(!serverSystem){
		ret NULL;
	}
	if(!(*serverSystem).serverClientAllocated or !fd){
		ret NULL;
	}
	current = (*serverSystem).serverClientStart;
	wall = current + (*serverSystem).serverClientAllocated;
	jmp findServerClientFdLoop;
	findServerClientFdLoop:{
		if(current < wall){
			if((*current).serverRequestReadFd == fd and (*current).serverClientId){
				ret current;
			}
			inc current;
			jmp findServerClientFdLoop;
		}
		ret NULL;
	}
}
FINDSERVERCLIENTFDID(){
	ServerClient *serverClient;
	if(!serverSystem){
		ret NULL;
	}
	if(!(*serverSystem).serverClientAllocated or !fd){
		ret NULL;
	}
	if(id >= (*serverSystem).serverClientAllocated){ /*! update later when stacks are added */
		ret NULL;
	}
	serverClient = (*serverSystem).serverClientStart + id;
	if((*serverClient).serverRequestReadFd != fd){
		ret NULL;
	}
	ret serverClient;
}
FINISERVERSYSTEM(){
	if(!serverSystem){
		ret false;
	}
	if((*serverSystem).clientRegistrationThreadCreated){
		quitServerClientRegistrationThread(serverSystem);
		pthread_join((*serverSystem).clientRegistrationThread, NULL);
		(*serverSystem).clientRegistrationThreadCreated = false;
	}
	if((*serverSystem).eventLoopThreadCreated){
		quitServerEventLoopThread(serverSystem);
		pthread_join((*serverSystem).eventLoopThread, NULL);
		(*serverSystem).eventLoopThreadCreated = false;
	}
	if((*serverSystem).replyLoopThreadCreated){
		quitServerReplyLoopThread(serverSystem);
		pthread_join((*serverSystem).replyLoopThread, NULL);
		(*serverSystem).replyLoopThreadCreated = false;
	}
	(*serverSystem).clientRegistrationRunning = false;
	(*serverSystem).eventLoopRunning = false;
	(*serverSystem).replyLoopRunning = false;



	/*! should someone else be responsible for these? namely the functions dealing with this stuff */

	(*serverSystem).serverClientId = 0;
	if((*serverSystem).signalFd){
		close((*serverSystem).signalFd); /*! on signal interrupt? */ /*! errors? */
		(*serverSystem).signalFd = 0;
	}

	/*!*/

#ifdef a
	int32 /*--------*/ replyEpollFd;
	int32 /*--------*/ eventReplyEpollFd;
	int32 /*--------*/ signalFd;
	uint32 /*-------*/ clientId;
#endif



	(*serverSystem).serverClientBlockSize = 0;



	/*! who should be handling this? */

	removeAllServerClients(serverSystem);



	(*serverSystem).serverExtensionBlockSize = 0;



	removeAllServerExtensions(serverSystem);

	/*!*/



	(*serverSystem).database = NULL;
	(*serverSystem).clientChannelPath = NULL;
	(*serverSystem).serverChannelPath = NULL;
	ret true;
}


INITSERVERCONNECTION(){



	/*! remove later */

	(void)unpackRequest;



	if(!serverConnectionSystem){
		ret false;
	}
	(*serverConnectionSystem).serverChannelPath = NULL;
	(*serverConnectionSystem).clientExtensionStart = NULL;
	(*serverConnectionSystem).clientExtensionSize = 0;
	(*serverConnectionSystem).clientExtensionAllocated = 0;
	(*serverConnectionSystem).clientExtensionBlockSize = 0;
	(*serverConnectionSystem).shmStart = NULL;
	(*serverConnectionSystem).requestSlotStart = NULL;
	(*serverConnectionSystem).replySlotStart = NULL;
	(*serverConnectionSystem).eventSlotStart = NULL;
	(*serverConnectionSystem).requestStart = NULL;
	(*serverConnectionSystem).requestCurrent = NULL;
	(*serverConnectionSystem).replyStart = NULL;
	(*serverConnectionSystem).replyCurrent = NULL;
	(*serverConnectionSystem).eventStart = NULL;
	(*serverConnectionSystem).eventCurrent = NULL;
	(*serverConnectionSystem).replyEpollFd = 0;
	(*serverConnectionSystem).eventEpollFd = 0;
	(*serverConnectionSystem).serverRequestWriteFd = 0;
	(*serverConnectionSystem).clientReplyReadFd = 0;
	(*serverConnectionSystem).clientEventReadFd = 0;
	(*serverConnectionSystem).currentToken = 0;
	(*serverConnectionSystem).lastTokenRead = 0;
	(*serverConnectionSystem).tokenBacklogSize = 0;
	(*serverConnectionSystem).requestAmount = 0;
	ret true;
}
SETSERVERCONNECTIONSERVERCHANNELPATH(){
	bool success;
	if(!serverConnectionSystem){
		ret false;
	}
	success = false;
	if(serverChannelPath == (*serverConnectionSystem).serverChannelPath){
		jmp emergencyExit;
	}
	(*serverConnectionSystem).serverChannelPath = serverChannelPath;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
CONNECTTOSERVER(){
	int replyEpollFd;
	int eventEpollFd;
	struct epoll_event event;
	int socketConnection;
	struct sockaddr_un address;
	int shmId;
	Header *shmStart;
	bool success;
	struct{
		int32 /*--*/ readFd;
		int32 /*--*/ writeFd;
	} serverRequestPipe;
	struct{
		int32 /*--*/ readFd;
		int32 /*--*/ writeFd;
	} clientReplyPipe;
	struct{
		int32 /*--*/ readFd;
		int32 /*--*/ writeFd;
	} clientEventPipe;
	if(!serverConnectionSystem){
		ret false;
	}
	serverRequestPipe.readFd = 0;
	serverRequestPipe.writeFd = 0;
	clientReplyPipe.readFd = 0;
	clientReplyPipe.writeFd = 0;
	clientEventPipe.readFd = 0;
	clientEventPipe.writeFd = 0;
	replyEpollFd = 0;
	eventEpollFd = 0;
	socketConnection = 0;
	success = false;
	if(pipe((void *)&serverRequestPipe) == PIPE_FAILURE){ /*! check for surprise errors */
		serverRequestPipe.readFd = 0;
		serverRequestPipe.writeFd = 0;
		jmp emergencyExit;
	}
	if(pipe((void *)&clientReplyPipe) == PIPE_FAILURE){ /*! check for surprise errors */
		clientReplyPipe.readFd = 0;
		clientReplyPipe.writeFd = 0;
		jmp emergencyExit;
	}
	if(pipe((void *)&clientEventPipe) == PIPE_FAILURE){ /*! check for surprise errors */
		clientEventPipe.readFd = 0;
		clientEventPipe.writeFd = 0;
		jmp emergencyExit;
	}
	replyEpollFd = epoll_create1(NONE_EPOLL_FLAG); /*! check for surprise errors */
	if(replyEpollFd == EPOLL_CREATE1_FAILURE){
		replyEpollFd = 0;
		jmp emergencyExit;
	}
	eventEpollFd = epoll_create1(NONE_EPOLL_FLAG); /*! check for surprise errors */
	if(eventEpollFd == EPOLL_CREATE1_FAILURE){
		eventEpollFd = 0;
		jmp emergencyExit;
	}
	{
		const int flag = fcntl(clientReplyPipe.readFd, F_GETFL, 0); /*! errors? */
		int returnValue;
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		returnValue = fcntl(clientReplyPipe.readFd, F_SETFL, flag | O_NONBLOCK); /*! errors? also why pick these ones? */
		if(returnValue == FCNTL_FAILURE){
			jmp emergencyExit;
		}
	}
	{
		const int flag = fcntl(clientEventPipe.readFd, F_GETFL, 0); /*! errors? */
		int returnValue;
		if(flag == FCNTL_FAILURE){
			jmp emergencyExit;
		}
		returnValue = fcntl(clientEventPipe.readFd, F_SETFL, flag | O_NONBLOCK); /*! errors? also why pick these ones? */
		if(returnValue == FCNTL_FAILURE){
			jmp emergencyExit;
		}
	}
	event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
	event.data.fd = clientReplyPipe.readFd;
	if(epoll_ctl(replyEpollFd, EPOLL_CTL_ADD, clientReplyPipe.readFd, &event) == EPOLL_CTL_FAILURE){
		jmp emergencyExit;
	}
	event.events = EPOLLIN | EPOLLRDHUP | EPOLLHUP | EPOLLERR;
	event.data.fd = clientEventPipe.readFd;
	if(epoll_ctl(eventEpollFd, EPOLL_CTL_ADD, clientEventPipe.readFd, &event) == EPOLL_CTL_FAILURE){
		jmp emergencyExit;
	}
	socketConnection = socket(AF_UNIX, SOCK_STREAM, NONE_SOCKET_PROTOCOL); /*! check for surprise errors */
	if(socketConnection == SOCKET_FAILURE){
		socketConnection = 0;
		jmp emergencyExit;
	}
	address.sun_family = AF_UNIX;
	strcpy(address.sun_path, (*serverConnectionSystem).serverChannelPath); /*! replace with toolkit function */
	if(connect(socketConnection, (void *)&address, sizeof(address)) == CONNECT_FAILURE){
		jmp emergencyExit;
	}
	{
		int fd[3];
		*(fd + 0) = serverRequestPipe.readFd;
		*(fd + 1) = clientReplyPipe.writeFd;
		*(fd + 2) = clientEventPipe.writeFd;
		if(!sendFd(socketConnection, fd, countof(fd))){ /*! errors? */
			jmp emergencyExit;
		}
	}
	if(recv(socketConnection, &shmId, sizeof(shmId), 0) == RECV_FAILURE){ /*! this fails? what do? */
		jmp emergencyExit;
	}
	if(!shmId){
		jmp emergencyExit;
	}
	shmStart = shmat(shmId, NULL, SHM_NONE);
	if(shmStart == SHMAT_FAILURE){
		jmp emergencyExit;
	}
	(*serverConnectionSystem).shmStart = shmStart;
	(*serverConnectionSystem).requestSlotStart = (void *)((uint8 *)shmStart + (*shmStart).requestSlotStartOffset);
	(*serverConnectionSystem).replySlotStart = (void *)((uint8 *)shmStart + (*shmStart).replySlotStartOffset);
	(*serverConnectionSystem).eventSlotStart = (void *)((uint8 *)shmStart + (*shmStart).eventSlotStartOffset);
	(*serverConnectionSystem).requestStart = (void *)((uint8 *)shmStart + (*shmStart).requestStartOffset);
	(*serverConnectionSystem).requestCurrent = (*serverConnectionSystem).requestStart;
	(*serverConnectionSystem).replyStart = (void *)((uint8 *)shmStart + (*shmStart).replyStartOffset);
	(*serverConnectionSystem).replyCurrent = (*serverConnectionSystem).replyStart;
	(*serverConnectionSystem).eventStart = (void *)((uint8 *)shmStart + (*shmStart).eventStartOffset);
	(*serverConnectionSystem).eventCurrent = (*serverConnectionSystem).eventStart;
	(*serverConnectionSystem).clientId = (*shmStart).clientId;
	(*serverConnectionSystem).replyEpollFd = replyEpollFd;
	(*serverConnectionSystem).eventEpollFd = eventEpollFd;
	(*serverConnectionSystem).serverRequestWriteFd = serverRequestPipe.writeFd;
	(*serverConnectionSystem).clientReplyReadFd = clientReplyPipe.readFd;
	(*serverConnectionSystem).clientEventReadFd = clientEventPipe.readFd;
	(*serverConnectionSystem).currentToken = 0;
	(*serverConnectionSystem).lastTokenRead = 0;
	(*serverConnectionSystem).tokenBacklogSize = 0;
	(*serverConnectionSystem).requestAmount = 0;
	(*serverConnectionSystem).hasError = false;
	fprintf(stdout, "connected on %i\n", shmId);
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(socketConnection) /*---------*/ close(socketConnection); /*! on signal interrupt? */
		if(clientEventPipe.writeFd) /*--*/ close(clientEventPipe.writeFd); /*! on signal interrupt? */
		if(clientReplyPipe.writeFd) /*--*/ close(clientReplyPipe.writeFd); /*! on signal interrupt? */
		if(serverRequestPipe.readFd) /*-*/ close(serverRequestPipe.readFd); /*! on signal interrupt? */
		if(!success){
			if(eventEpollFd) /*--------------*/ close(eventEpollFd); /*! on signal interrupt? */
			if(replyEpollFd) /*--------------*/ close(replyEpollFd); /*! on signal interrupt? */
			if(clientEventPipe.readFd) /*----*/ close(clientEventPipe.readFd); /*! on signal interrupt? */
			if(clientReplyPipe.readFd) /*----*/ close(clientReplyPipe.readFd); /*! on signal interrupt? */
			if(serverRequestPipe.writeFd) /*-*/ close(serverRequestPipe.writeFd); /*! on signal interrupt? */
			ret false;
		}
		ret true;
	}
}


























SENDSERVERREQUEST(){
	Header *header;
	uint32 payloadSize;
	uint32 currentToken;
	bool success;
	if(!serverConnectionSystem){
		ret false;
	}
	success = false;
	if((*serverConnectionSystem).hasError){
		ret false;
	}
	header = (*serverConnectionSystem).shmStart;



	/*!
		but... surely we have to wait until a slot is open to write a request if we just flushed, right?

		this is gonna be a rough issue to deal with. you should with epoll but... what do you do with the reply? copy to local buffer?

		the requestCurrent pointer is now also in the mix.
	*/



	payloadSize = 0;
	if(request and itemAmount){
		uint32 *current = request;
		uint32 *const wall = current + itemAmount;
		payloadSize += sizeof(uint32) + itemAmount * sizeof(uint32);
		jmp calculatePayloadSizeLoop;
		calculatePayloadSizeLoop:{
			if(current < wall){
				payloadSize += (*current + (sizeof(uint32) - 1)) & ~(sizeof(uint32) - 1);
				inc current;
				jmp calculatePayloadSizeLoop;
			}
		}
	}
	if(sizeof(GenericRequest) + payloadSize > (*header).requestSize){
		jmp emergencyExit;
	}



	/*! we do not know if there is space to put this at the start of the pool. keep track of that. wrap around will be so fun. */

	if((uint8 *)(*serverConnectionSystem).requestCurrent >= (uint8 *)(*serverConnectionSystem).requestStart + (*header).requestSize){
		(*serverConnectionSystem).requestCurrent = (*serverConnectionSystem).requestStart;
	}elif((uint8 *)(*serverConnectionSystem).requestCurrent + sizeof(GenericRequest) + payloadSize > (uint8 *)(*serverConnectionSystem).requestStart + (*header).requestSize){
		(*serverConnectionSystem).requestCurrent = (*serverConnectionSystem).requestStart;
	}



	/*! there may be requests in the shm, and the request amount will be reset. we should check the size actually allocated in the shm. */

	if((*serverConnectionSystem).requestAmount == (*header).requestSlotSize){
		if(!flushServerBuffer(serverConnectionSystem)){
			if((*serverConnectionSystem).requestAmount){
				jmp emergencyExit;
			}
		}
	}



	{
		RequestSlot *const requestSlot = (*serverConnectionSystem).requestSlotStart + (*header).requestCurrentWriter;
		GenericRequest *const requestCurrent = (*serverConnectionSystem).requestCurrent;

		currentToken = (*serverConnectionSystem).currentToken + 1;
		if(!currentToken){
			currentToken = 1;
		}

		(*requestSlot).requestStartOffset = (uint8 *)requestCurrent - (uint8 *)(*serverConnectionSystem).requestStart;
		(*requestSlot).requestSize = sizeof(GenericRequest);

		(*requestCurrent).token = currentToken;
		(*requestCurrent).requestType = requestType;
		(*requestCurrent).extension = extension;
		(*requestCurrent).sendReply = !!tokenReturn;
		(*requestCurrent).payloadStartOffset = !!payloadSize * sizeof(GenericRequest);
		(*requestCurrent).payloadSize = payloadSize;

		fprintf(stdout, "request slot @ %04u, sending request with %04u %04u %04u %04u %04u %04u\n", (*requestSlot).requestStartOffset, (*requestCurrent).requestType, (*requestCurrent).extension, (*requestCurrent).sendReply, (*requestCurrent).token, (*requestCurrent).payloadStartOffset, (*requestCurrent).payloadSize);
		packServerRequest(requestCurrent, itemAmount, request);

		(*serverConnectionSystem).requestCurrent += sizeof(GenericRequest) + payloadSize;

		(*header).requestCurrentWriter = ((*header).requestCurrentWriter + 1) % (*header).requestSlotSize;
		(*serverConnectionSystem).currentToken = currentToken;
	}

	inc (*serverConnectionSystem).requestAmount;
	inc (*serverConnectionSystem).tokenBacklogSize;
	if(tokenReturn){
		*tokenReturn = currentToken;
	}
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
WAITFORSERVERREPLY(){
	bool success;
	if(!serverConnectionSystem){
		ret false;
	}
	success = false;
	if(!(*serverConnectionSystem).replyEpollFd or (*serverConnectionSystem).hasError or !token){
		jmp emergencyExit;
	}



	/*! wrap around? special values like lastTokenRead == 0? */

	/*! O(n) on weird catching of the replies is lame. */

	if(token < (*serverConnectionSystem).lastTokenRead){
		uint32 current = 0;
		uint32 wall = (*serverConnectionSystem).tokenBacklogSize;
		Header *const header = (*serverConnectionSystem).shmStart;
		ReplySlot *const replySlotStart = (*serverConnectionSystem).replySlotStart;
		uint32 replyCurrentReader = (*header).replyCurrentReader;
		GenericReply *const replyStart = (*serverConnectionSystem).replyStart;
		uint32 replySlotSize = (*header).replySlotSize;
		jmp readPastReplyLoop;
		readPastReplyLoop:{
			if(current < wall){
				GenericReply *const reply = (void *)((uint8 *)replyStart + (*(replySlotStart + replyCurrentReader)).replyStartOffset);
				if((*reply).token == token){
					fprintf(stdout, "reply   slot @ %04u, got reply with %04u %04u %04u %04u %04u %04u\n", replyCurrentReader, (*reply).replyType, (*reply).extension, (*reply).status, (*reply).token, (*reply).payloadStartOffset, (*reply).payloadSize);
					if(replyReturn){
						*(GenericReply *)replyReturn = *reply;
						memcpy((uint8 *)replyReturn + sizeof(GenericReply), (uint8 *)reply + (*reply).payloadStartOffset, (*reply).payloadSize);
					}
					(*reply).token = 0;
					if(!current){
						replyCurrentReader = (replyCurrentReader + 1) % replySlotSize;
						dec (*serverConnectionSystem).tokenBacklogSize;
						inc current;
						jmp removeOldestReplyLoop;
						removeOldestReplyLoop:{
							if(current < wall){
								GenericReply *const reply = (void *)((uint8 *)replyStart + (*(replySlotStart + replyCurrentReader)).replyStartOffset);
								if(!(*reply).token){
									replyCurrentReader = (replyCurrentReader + 1) % replySlotSize;
									dec (*serverConnectionSystem).tokenBacklogSize;
									inc current;
									jmp removeOldestReplyLoop;
								}
							}
							(*header).replyCurrentReader = replyCurrentReader;
						}
					}
					ret true; /*!*/
				}
				replyCurrentReader = (replyCurrentReader + 1) % replySlotSize;
				inc current;
				jmp readPastReplyLoop;
			}
			fprintf(stdout, "failure to find previously received reply\n");
			jmp emergencyExit;
		}
	}



	jmp waitForServerReplyLoop;
	waitForServerReplyLoop:{
		struct epoll_event epollEventStart[1];
		int epollEventAmount;
		uint64 response;
		uint32 replyToken;
		uint32 replySlot;
		int returnValue;
		epollEventAmount = epoll_wait((*serverConnectionSystem).replyEpollFd, epollEventStart, countof(epollEventStart), INFINITE_EPOLL_WAIT_TIMEOUT);
		if(epollEventAmount){ /*! handle errors here */
			/*! handle errors here */
		}
		if((*epollEventStart).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
			if((*epollEventStart).events & (EPOLLRDHUP | EPOLLHUP)){
				fprintf(stdout, "reply failed because the server shut off (hangup)\n");
				(*serverConnectionSystem).hasError = true;
				jmp emergencyExit;
			}
			fprintf(stdout, "reply failed because the server shut off (error)\n");
			(*serverConnectionSystem).hasError = true;
			jmp emergencyExit;
		}
		if((*epollEventStart).events & EPOLLIN){
			returnValue = read((*serverConnectionSystem).clientReplyReadFd, &response, sizeof(response));
			if(returnValue > 0){

				/*!*/

			}elif(returnValue == -1){

				/*!*/

			}else{

				/*!*/

			}
			if(!response){
				jmp emergencyExit;
			}
			replyToken = response;
			(*serverConnectionSystem).lastTokenRead = replyToken; /*! on wrap around? */
			if(replyToken < token){
				jmp waitForServerReplyLoop;
			}
			if(replyToken > token){
				/*! something must have happened. go back to checking the arrived tokens */
			}
			replySlot = response >> 32;









			{
				Header *header = (*serverConnectionSystem).shmStart;
				GenericReply *const reply = (void *)((uint8 *)(*serverConnectionSystem).replyStart + (*((*serverConnectionSystem).replySlotStart + replySlot)).replyStartOffset);
				fprintf(stdout, "reply   slot @ %04u, got reply with %04u %04u %04u %04u %04u %04u\n", replySlot, (*reply).replyType, (*reply).extension, (*reply).status, (*reply).token, (*reply).payloadStartOffset, (*reply).payloadSize);
				if(replyReturn){
					*(GenericReply *)replyReturn = *reply;
					memcpy((uint8 *)replyReturn + sizeof(GenericReply), (uint8 *)reply + (*reply).payloadStartOffset, (*reply).payloadSize);
				}
				(*reply).token = 0;
				if(!(*((*serverConnectionSystem).replyStart + (*header).replyCurrentReader)).token){
					(*header).replyCurrentReader = ((*header).replyCurrentReader + 1) % (*header).replySlotSize;
					dec (*serverConnectionSystem).tokenBacklogSize;
				}
			}









			success = true;
			jmp emergencyExit;
		}
		jmp waitForServerReplyLoop;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}









FLUSHSERVERBUFFER(){
	uint64 message;
	bool success;
	if(!serverConnectionSystem){
		ret false;
	}

	/*! should this be responsible for anything else? */

	if(!(*serverConnectionSystem).serverRequestWriteFd or !(*serverConnectionSystem).requestAmount or (*serverConnectionSystem).hasError){
		jmp emergencyExit;
	}
	message = (*serverConnectionSystem).clientId;
	message = (message << 32) | (*serverConnectionSystem).requestAmount; /*! add generation? */
	fprintf(stdout, "flushing %u requests to server...\n", (*serverConnectionSystem).requestAmount);
	write((*serverConnectionSystem).serverRequestWriteFd, &message, sizeof(message)); /*! errors? */
	(*serverConnectionSystem).requestAmount = 0;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}









/*! update */

WAITFORSERVEREVENT(){
	bool success;
	if(!serverConnectionSystem){
		ret false;
	}
	success = false;
	if(!(*serverConnectionSystem).eventEpollFd or (*serverConnectionSystem).hasError){
		jmp emergencyExit;
	}
	jmp waitForServerEventLoop;
	waitForServerEventLoop:{
		struct epoll_event epollEventStart[1];
		int epollEventAmount;
		uint64 response;
		int returnValue;
		uint32 eventSlot;
		epollEventAmount = epoll_wait((*serverConnectionSystem).eventEpollFd, epollEventStart, countof(epollEventStart), INFINITE_EPOLL_WAIT_TIMEOUT);
		if(epollEventAmount){ /*! handle errors here */
			/*! handle errors here */
		}
		if((*epollEventStart).events & (EPOLLRDHUP | EPOLLHUP | EPOLLERR)){
			if((*epollEventStart).events & (EPOLLRDHUP | EPOLLHUP)){
				fprintf(stdout, "reply failed because the server shut off (hangup)\n");
				(*serverConnectionSystem).hasError = true;
				jmp emergencyExit;
			}
			fprintf(stdout, "reply failed because the server shut off (error)\n");
			(*serverConnectionSystem).hasError = true;
			jmp emergencyExit;
		}
		if((*epollEventStart).events & EPOLLIN){
			returnValue = read((*serverConnectionSystem).clientEventReadFd, &response, sizeof(response));
			if(returnValue > 0){

				/*!*/

			}elif(returnValue == -1){

				/*!*/

			}else{

				/*!*/

			}
			if(!response){
				jmp emergencyExit;
			}
			eventSlot = response >> 32;
			{
				Header *const header = (*serverConnectionSystem).shmStart;
				GenericEvent *const event = (*serverConnectionSystem).eventStart + eventSlot;
				fprintf(stdout, "event   slot @ %04u, got event with %04u %04u %04u %04u\n", eventSlot, (*event).eventType, (*event).extension, (*event).payloadStartOffset, (*event).payloadSize);
				if(eventReturn){
					*(GenericEvent *)eventReturn = *event;
					memcpy((uint8 *)eventReturn + sizeof(GenericEvent), (uint8 *)event + (*event).payloadStartOffset, (*event).payloadSize);
				}
				(*header).eventCurrentReader = ((*header).eventCurrentReader + 1) % (*header).eventSlotSize;
			}
			success = true;
			jmp emergencyExit;
		}
		jmp waitForServerEventLoop;
	}
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}



























PACKSERVERREQUEST(){
	void *requestPayloadStart;
	uint32 *requestSizeCurrent;
	uint32 *requestSizeWall;
	uint8 *requestPointerCurrent;
	uint32 *structSizeCurrent;
	void **structPointerCurrent;
	if(!request or !(*request).payloadStartOffset or !(*request).payloadSize or !itemAmount or !structStart){
		ret false;
	}
	requestPayloadStart = (uint8 *)request + (*request).payloadStartOffset;
	requestSizeCurrent = (uint32 *)requestPayloadStart + 1;
	requestSizeWall = requestSizeCurrent + itemAmount;
	requestPointerCurrent = (void *)(requestSizeCurrent + itemAmount);
	structSizeCurrent = structStart;
	structPointerCurrent = (void *)(structSizeCurrent + itemAmount + (itemAmount % 2));
	*(uint32 *)requestPayloadStart = itemAmount;
	jmp packRequestItemLoop;
	packRequestItemLoop:{
		if(requestSizeCurrent < requestSizeWall){
			*requestSizeCurrent = *structSizeCurrent;
			memcpy(requestPointerCurrent, *structPointerCurrent, *structSizeCurrent * sizeof(uint8)); /*! replace later */
			inc structSizeCurrent;
			inc structPointerCurrent;
			requestPointerCurrent += (*requestSizeCurrent + (sizeof(uint32) - 1)) & ~(sizeof(uint32) - 1);
			inc requestSizeCurrent;
			jmp packRequestItemLoop;
		}
		ret true;
	}
}
DISCONNECTFROMSERVER(){
	bool success;
	if(!serverConnectionSystem){
		ret false;
	}
	success = false;



/*! update this */

	if(!(*serverConnectionSystem).eventStart or !(*serverConnectionSystem).replyStart or !(*serverConnectionSystem).requestSlotStart or !(*serverConnectionSystem).shmStart or !(*serverConnectionSystem).eventEpollFd or !(*serverConnectionSystem).replyEpollFd or !(*serverConnectionSystem).clientEventReadFd or !(*serverConnectionSystem).clientReplyReadFd or !(*serverConnectionSystem).serverRequestWriteFd){
		jmp emergencyExit;
	}



	if(!(*serverConnectionSystem).hasError){
		const uint64 requestAmount = 0;
		struct epoll_event epollEventStart[1];
		write((*serverConnectionSystem).serverRequestWriteFd, &requestAmount, sizeof(requestAmount)); /*! errors? */
		epoll_wait((*serverConnectionSystem).replyEpollFd, epollEventStart, countof(epollEventStart), INFINITE_EPOLL_WAIT_TIMEOUT); /*! errors? */
	}
	shmdt((*serverConnectionSystem).shmStart); /*! errors? */
	close((*serverConnectionSystem).eventEpollFd); /*! errors? */
	close((*serverConnectionSystem).replyEpollFd); /*! errors? */
	close((*serverConnectionSystem).clientEventReadFd); /*! errors? */
	close((*serverConnectionSystem).clientReplyReadFd); /*! errors? */
	close((*serverConnectionSystem).serverRequestWriteFd); /*! errors? */
	(*serverConnectionSystem).hasError = false;
	(*serverConnectionSystem).requestAmount = 0;
	(*serverConnectionSystem).tokenBacklogSize = 0;
	(*serverConnectionSystem).lastTokenRead = 0;
	(*serverConnectionSystem).currentToken = 0;
	(*serverConnectionSystem).clientEventReadFd = 0;
	(*serverConnectionSystem).clientReplyReadFd = 0;
	(*serverConnectionSystem).serverRequestWriteFd = 0;
	(*serverConnectionSystem).eventEpollFd = 0;
	(*serverConnectionSystem).replyEpollFd = 0;
	(*serverConnectionSystem).clientId = 0;
	(*serverConnectionSystem).eventCurrent = NULL;
	(*serverConnectionSystem).eventStart = NULL;
	(*serverConnectionSystem).replyCurrent = NULL;
	(*serverConnectionSystem).replyStart = NULL;
	(*serverConnectionSystem).requestCurrent = NULL;
	(*serverConnectionSystem).requestStart = NULL;
	(*serverConnectionSystem).eventSlotStart = NULL;
	(*serverConnectionSystem).replySlotStart = NULL;
	(*serverConnectionSystem).requestSlotStart = NULL;
	(*serverConnectionSystem).shmStart = NULL;
	success = true;
	jmp emergencyExit;
	emergencyExit:{
		if(!success){
			ret false;
		}
		ret true;
	}
}
FINISERVERCONNECTION(){
	if(!serverConnectionSystem){
		ret false;
	}
	if(!disconnectFromServer(serverConnectionSystem)){
		ret false;
	}
	(*serverConnectionSystem).clientExtensionBlockSize = 0;
	(*serverConnectionSystem).clientExtensionAllocated = 0;
	(*serverConnectionSystem).clientExtensionSize = 0;
	(*serverConnectionSystem).clientExtensionStart = NULL;
	(*serverConnectionSystem).serverChannelPath = NULL;
	ret true;
}


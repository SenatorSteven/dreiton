#include <stdint.h>
#include <stdlib.h>

#include "headers/cold/cold.hold"
#include "headers/protocols/dreiton-protocol.hold"
#include "headers/protocols/dreiton-extension-protocol.hold"
#include "headers/dreiton-base-extension.hold"

#define MAX_REPLY_ITEM_AMOUNT /*--------------------*/ (1)
#define MAX_EVENT_ITEM_AMOUNT /*--------------------*/ (1)

#define INITDREITONEXTENSIONDESCRIPTOR() /*---------*/ bool  initDreitonExtensionDescriptor(void **const databaseReturn)
#define PARSEDREITONEXTENSIONDESCRIPTORREQUEST() /*-*/ bool  parseDreitonExtensionDescriptorRequest(void *const database, const uint16 type, const uint32 payloadItemAmount, const void *const frame, bool (*getDreitonDecodedItem)(const void *const frame, const uint32 which, uint32 *const itemSizeReturn, void **const itemStartReturn), DreitonExtensionErrorSignature *const errorSignatureReturn, DreitonExtensionEventSignature *const eventSignatureReturn, uint8 *const statusReturn)
#define PARSEDREITONEXTENSIONDESCRIPTORREPLY() /*---*/ bool  parseDreitonExtensionDescriptorReply(void *const database, const uint16 type, DreitonExtensionReplySignature *const replySignatureReturn)
#define FINIDREITONEXTENSIONDESCRIPTOR() /*---------*/ bool  finiDreitonExtensionDescriptor(void *const database)

def struct{
	void ** /*--*/ replyDataStart;
	uint32 * /*-*/ replySizeStart;
	void ** /*--*/ eventDataStart;
	uint32 * /*-*/ eventSizeStart;
	uint32 /*---*/ magicNumber;
	uint8 /*----*/ pad0[4];
	uint8 /*----*/ replyPool[MAX_REPLY_ITEM_AMOUNT * (sizeof(void *) + sizeof(uint32))];
	uint8 /*----*/ eventPool[MAX_EVENT_ITEM_AMOUNT * (sizeof(void *) + sizeof(uint32))];
} Database;

INITDREITONEXTENSIONDESCRIPTOR();
PARSEDREITONEXTENSIONDESCRIPTORREQUEST();
PARSEDREITONEXTENSIONDESCRIPTORREPLY();
FINIDREITONEXTENSIONDESCRIPTOR();

const DreitonExtensionDescriptor /*-*/ dreitonExtensionDescriptor = {
	  sizeof(DreitonExtensionDescriptor)
	, DREITON_BASE_PROTOCOL_VERSION
	, DREITON_BASE_EXTENSION_VERSION
	, lengthof(DREITON_BASE_EXTENSION_NAME)
	, lengthof(DREITON_BASE_AUTHOR_NAME)
	, DREITON_BASE_EVENT_AMOUNT
	, DREITON_BASE_EXTENSION_NAME
	, DREITON_BASE_AUTHOR_NAME
	, &initDreitonExtensionDescriptor
	, &parseDreitonExtensionDescriptorRequest
	, &parseDreitonExtensionDescriptorReply
	, &finiDreitonExtensionDescriptor
};

INITDREITONEXTENSIONDESCRIPTOR(){
	Database *database;
	if(!databaseReturn){
		ret false;
	}
	database = malloc(1 * sizeof(Database));
	if(!database){
		ret false;
	}
	(*(Database *)database).replyDataStart = (void *)&(*(Database *)database).replyPool;
	(*(Database *)database).replySizeStart = (void *)((uint8 *)&(*(Database *)database).replyPool + MAX_REPLY_ITEM_AMOUNT * sizeof(void *));
	(*(Database *)database).eventDataStart = (void *)&(*(Database *)database).eventPool;
	(*(Database *)database).eventSizeStart = (void *)((uint8 *)&(*(Database *)database).eventPool + MAX_EVENT_ITEM_AMOUNT * sizeof(void *));
	(*(Database *)database).magicNumber = 0;
	*databaseReturn = database;
	ret true;
}
PARSEDREITONEXTENSIONDESCRIPTORREQUEST(){
	if(!database){
		ret false;
	}
	if(!frame or !getDreitonDecodedItem or !errorSignatureReturn or !eventSignatureReturn or !statusReturn){
		ret false;
	}
	switch(type){
		to NONE_DREITON_BASE_REQUEST_TYPE:{
			*statusReturn = REQUEST_DREITON_ERROR_STATUS;
			jmp returnError;
		}
		to GET_MAGIC_NUMBER_DREITON_BASE_REQUEST_TYPE:{
			if(payloadItemAmount != GET_MAGIC_NUMBER_DREITON_BASE_REQUEST_ITEM_AMOUNT){
				(*errorSignatureReturn).value = payloadItemAmount;
				*statusReturn = PAYLOAD_DREITON_ERROR_STATUS;
				jmp returnError;
			}
			*statusReturn = SUCCESS_DREITON_REPLY_STATUS;
			ret true;
		}
		to SET_MAGIC_NUMBER_DREITON_BASE_REQUEST_TYPE:{
			uint32 magicNumberSize;
			void *magicNumberStart;
			void **dataStart;
			uint32 *sizeStart;
			if(payloadItemAmount != SET_MAGIC_NUMBER_DREITON_BASE_REQUEST_ITEM_AMOUNT){
				(*errorSignatureReturn).value = payloadItemAmount;
				*statusReturn = PAYLOAD_DREITON_ERROR_STATUS;
				jmp returnError;
			}
			if(!(*getDreitonDecodedItem)(frame, SET_MAGIC_NUMBER_MAGIC_NUMBER_DREITON_BASE_REQUEST_ITEM_OFFSET, &magicNumberSize, &magicNumberStart)){
				*statusReturn = FAILURE_DREITON_ERROR_STATUS;
				jmp returnError;
			}
			if(magicNumberSize != sizeof(uint32)){
				(*errorSignatureReturn).parameterOffset = SET_MAGIC_NUMBER_MAGIC_NUMBER_DREITON_BASE_REQUEST_ITEM_OFFSET;
				(*errorSignatureReturn).value = magicNumberSize;
				*statusReturn = VALUE_DREITON_ERROR_STATUS;
				jmp returnError;
			}
			if(*(uint32 *)magicNumberStart == (*(Database *)database).magicNumber){
				*statusReturn = SUCCESS_DREITON_REQUEST_STATUS;
				ret true;
			}
			(*(Database *)database).magicNumber = *(uint32 *)magicNumberStart;
			dataStart = (*(Database *)database).eventDataStart;
			sizeStart = (*(Database *)database).eventSizeStart;
			*(dataStart + MAGIC_NUMBER_CHANGED_MAGIC_NUMBER_DREITON_BASE_EVENT_ITEM_OFFSET) = (void *)&(*(Database *)database).magicNumber;
			*(sizeStart + MAGIC_NUMBER_CHANGED_MAGIC_NUMBER_DREITON_BASE_EVENT_ITEM_OFFSET) = sizeof(uint32);
			(*eventSignatureReturn).type = MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_TYPE;
			(*eventSignatureReturn).status = SUCCESS_DREITON_EVENT_STATUS;
			(*eventSignatureReturn).itemAmount = MAGIC_NUMBER_CHANGED_DREITON_BASE_EVENT_ITEM_AMOUNT;
			(*eventSignatureReturn).dataStart = dataStart;
			(*eventSignatureReturn).sizeStart = sizeStart;
			*statusReturn = UPDATE_DREITON_REQUEST_STATUS;
			ret true;
		}
		off:{
			*statusReturn = REQUEST_DREITON_ERROR_STATUS;
			jmp returnError;
		}
	}
	returnError:{
		(*errorSignatureReturn).operation = type;
		ret false;
	}
}
PARSEDREITONEXTENSIONDESCRIPTORREPLY(){
	if(!database){
		ret false;
	}
	if(!replySignatureReturn){
		ret false;
	}
	switch(type){
		to NONE_DREITON_BASE_REPLY_TYPE:{
			ret false;
		}
		to GET_MAGIC_NUMBER_DREITON_BASE_REPLY_TYPE:{
			void **dataStart = (*(Database *)database).replyDataStart;
			uint32 *sizeStart = (*(Database *)database).replySizeStart;
			*(dataStart + GET_MAGIC_NUMBER_MAGIC_NUMBER_DREITON_BASE_REPLY_ITEM_OFFSET) = (void *)&(*(Database *)database).magicNumber;
			*(sizeStart + GET_MAGIC_NUMBER_MAGIC_NUMBER_DREITON_BASE_REPLY_ITEM_OFFSET) = sizeof(uint32);
			(*replySignatureReturn).type = GET_MAGIC_NUMBER_DREITON_BASE_REPLY_TYPE;
			(*replySignatureReturn).status = SUCCESS_DREITON_REPLY_STATUS;
			(*replySignatureReturn).itemAmount = GET_MAGIC_NUMBER_DREITON_BASE_REPLY_ITEM_AMOUNT;
			(*replySignatureReturn).dataStart = dataStart;
			(*replySignatureReturn).sizeStart = sizeStart;
			ret true;
		}
		to SET_MAGIC_NUMBER_DREITON_BASE_REPLY_TYPE:{
			(*replySignatureReturn).type = SET_MAGIC_NUMBER_DREITON_BASE_REPLY_TYPE;
			(*replySignatureReturn).status = SUCCESS_DREITON_REPLY_STATUS;
			(*replySignatureReturn).itemAmount = SET_MAGIC_NUMBER_DREITON_BASE_REPLY_ITEM_AMOUNT;
			(*replySignatureReturn).dataStart = NULL;
			(*replySignatureReturn).sizeStart = NULL;
			ret true;
		}
		off:{
			ret false;
		}
	}
}
FINIDREITONEXTENSIONDESCRIPTOR(){
	if(!database){
		ret false;
	}
	free(database);
	ret true;
}

